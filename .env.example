# Required: published commit SHA tag, for example ghcr.io/shinjaehun/checkjjaek4:sha-<commit SHA>
APP_IMAGE=
# Host loopback port used by Nginx; the container listens on port 80.
APP_PORT=3000
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=1

# Set SECRET_KEY_BASE or RAILS_MASTER_KEY; the latter decrypts existing Rails credentials.
SECRET_KEY_BASE=
RAILS_MASTER_KEY=
RESEND_API_KEY=
# Required for the primary, cache, queue and cable databases.
CHECKJJAEK4_DATABASE_HOST=db
CHECKJJAEK4_DATABASE_PASSWORD=

# Shared S3-compatible connection settings for OCI Object Storage.
OCI_STORAGE_ACCESS_KEY_ID=
OCI_STORAGE_SECRET_ACCESS_KEY=
OCI_STORAGE_REGION=
OCI_STORAGE_ENDPOINT=

# Private buckets accessible with the shared OCI credentials.
OCI_AVATAR_BUCKET=
OCI_GROUP_IMAGE_BUCKET=
OCI_PHOTO_BUCKET=

JJAEK_PHOTO_UPLOADS_ENABLED=true
JJAEK_PHOTO_DAILY_LIMIT=4
JJAEK_PHOTO_RETAINED_LIMIT=50
JJAEK_PHOTO_STORAGE_LIMIT_BYTES=1073741824
