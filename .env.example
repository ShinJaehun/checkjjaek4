# Required: published commit SHA tag, for example ghcr.io/shinjaehun/checkjjaek4:sha-<commit SHA>
APP_IMAGE=
# Host loopback port used by Nginx; the container listens on port 80.
APP_PORT=3000
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=1

# Set SECRET_KEY_BASE or RAILS_MASTER_KEY; the latter decrypts existing Rails credentials.
SECRET_KEY_BASE=
RAILS_MASTER_KEY=
RESEND_API_KEY=
# Required for the primary, cache, queue and cable databases.
CHECKJJAEK4_DATABASE_HOST=db
CHECKJJAEK4_DATABASE_PASSWORD=

# Existing production avatar storage requires these; E10 handles storage operations.
OCI_AVATAR_ACCESS_KEY_ID=
OCI_AVATAR_SECRET_ACCESS_KEY=
OCI_AVATAR_REGION=
OCI_AVATAR_BUCKET=
OCI_AVATAR_ENDPOINT=
