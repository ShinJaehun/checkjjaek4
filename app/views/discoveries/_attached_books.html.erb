<% books = jjaek.attached_books.to_a %>
<% if books.any? %>
  <div class="mt-3 flex min-w-0 items-start gap-3" data-discovery-attached-books>
    <div class="flex shrink-0 -space-x-6" aria-hidden="<%= books.many? %>">
      <% books.first(3).each do |book| %>
        <div class="relative shrink-0 bg-white">
          <%= render "books/thumbnail", title: book.title, thumbnail: book.thumbnail,
                     url: (book_path(book, return_to: discovery_path) if books.one?), size: :discovery_group %>
        </div>
      <% end %>
    </div>
    <div class="min-w-0 flex-1 space-y-1 text-sm text-stone-600">
      <% books.first(3).each do |book| %>
        <p class="truncate"><%= link_to book.title, book_path(book, return_to: discovery_path), data: { turbo_frame: "_top" } %></p>
      <% end %>
      <% if books.size > 3 %>
        <p><%= t("recommendations.additional_books", count: books.size - 3) %></p>
      <% end %>
      <%= render "jjaeks/current_reading_state", jjaek: jjaek %>
    </div>
  </div>
<% end %>
