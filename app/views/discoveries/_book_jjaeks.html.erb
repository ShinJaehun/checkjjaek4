<%= turbo_frame_tag "discovery_book_jjaeks", class: "min-w-0 lg:border-r lg:border-stone-300 lg:pr-10" do %>
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-stone-300 pb-3">
    <h2 class="font-serif text-3xl font-semibold text-stone-950"><%= t("discovery.book_jjaeks.title") %></h2>
    <%= link_to t("discovery.refresh"), discovery_path(refresh: "book"),
                data: { turbo_frame: "discovery_book_jjaeks" },
                class: "rounded-full border border-stone-300 px-3 py-1.5 text-xs font-medium text-stone-600 hover:border-stone-500 hover:text-stone-900" %>
  </div>
  <% if @book %>
    <div class="mt-6 flex items-start gap-5">
      <%= link_to book_path(@book), data: { turbo_frame: "_top" } do %>
        <%= render "books/thumbnail", title: @book.title, thumbnail: @book.thumbnail,
                   url: nil, size: :large, link: false %>
      <% end %>
      <div class="min-w-0">
        <h3 class="font-serif text-2xl font-semibold leading-tight"><%= link_to @book.title, book_path(@book), data: { turbo_frame: "_top" } %></h3>
        <% if @book.authors_text.present? %>
          <p class="mt-2 text-sm text-stone-600"><%= @book.authors_text %></p>
        <% end %>
      </div>
    </div>
    <div class="mt-7 divide-y divide-stone-200">
      <% @book_jjaeks.each do |jjaek| %>
        <article class="py-5 pl-5">
          <div class="flex items-center gap-3">
            <%= link_to user_path(jjaek.user), title: jjaek.user.name, aria: { label: jjaek.user.name }, data: { turbo_frame: "_top" } do %>
              <%= user_avatar_image(jjaek.user, size: 128, alt: jjaek.user.name, class: "h-9 w-9 rounded-full object-cover") %>
            <% end %>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-stone-800"><%= link_to jjaek.user.name, user_path(jjaek.user), data: { turbo_frame: "_top" } %></p>
              <p class="text-xs text-stone-500"><%= t("jjaeks.meta.created_at", time: l(jjaek.created_at, format: :short)) %></p>
            </div>
          </div>
          <p class="mt-2 line-clamp-3 whitespace-pre-line break-words font-serif text-lg leading-7 text-stone-800"><%= jjaek.content %></p>
          <%= link_to t("discovery.read_jjaek"), jjaek_path(jjaek),
                      data: { turbo_frame: "_top" },
                      class: "mt-3 inline-block text-sm font-semibold underline underline-offset-4" %>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="mt-6 text-sm text-stone-500"><%= t("discovery.book_jjaeks.empty") %></p>
  <% end %>
<% end %>
