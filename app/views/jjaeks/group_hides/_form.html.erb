<%= form_with model: @moderation_action,
              scope: :moderation_action,
              url: jjaek_group_hides_path(@jjaek, @return_context_params),
              method: :post,
              class: "mt-6 space-y-4" do |form| %>
  <div class="space-y-2">
    <%= form.label :public_reason, t("jjaeks.moderation.reason"), class: "block text-sm font-medium text-stone-800" %>
    <%= form.select :public_reason,
                    options_for_select(jjaek_hide_reason_options, @moderation_action.public_reason),
                    { prompt: t("jjaeks.moderation.group_admin.reason_prompt") },
                    required: true,
                    class: "w-full rounded-xl border border-stone-300 bg-white px-3 py-2" %>
  </div>

  <%= render "shared/moderation_internal_note_field", form: form,
             label_key: "jjaeks.moderation.group_admin.internal_note", hint_id: "group_internal_note_hint",
             hint_key: "jjaeks.moderation.group_admin.internal_note_hint" %>

  <%= form.submit t("jjaeks.moderation.group_admin.hide"), class: "rounded-full bg-amber-800 px-5 py-2.5 text-sm font-medium text-white" %>
<% end %>
