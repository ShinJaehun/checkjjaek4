<span id="<%= dom_id(jjaek, :comment_action) %>">
  <% navigation_params = jjaek_navigation_params %>
  <% navigation_params = navigation_params.except(:return_to) if navigation_params[:return_to] == jjaek_path(jjaek) %>

  <%= link_to t("jjaeks.meta.comments", count: jjaek.comments_count),
              jjaek_path(jjaek, navigation_params.merge(anchor: dom_id(jjaek, :comments_panel))),
              class: "font-medium text-stone-700" %>
</span>
