<%= tag.section id: "book-selection-window", hidden: true, role: "dialog",
    aria: { modal: false, labelledby: "book-selection-window-title" },
    class: "fixed inset-x-3 bottom-3 z-40 max-h-[48dvh] space-y-4 overflow-y-auto overscroll-contain rounded-3xl border border-stone-300 bg-white p-4 shadow-2xl sm:inset-x-auto sm:right-6 sm:bottom-auto sm:top-24 sm:max-h-[calc(100dvh-7rem)] sm:w-96 sm:p-5",
    data: { turbo_permanent: true, controller: "book-selection",
      book_selection_max_books_value: Jjaek::MAX_ATTACHED_BOOKS,
      action: "click@document->book-selection#navigate:capture submit@document->book-selection#prepare:capture turbo:before-visit@document->book-selection#beforeVisit turbo:visit@document->book-selection#beforeVisit turbo:before-render@document->book-selection#beforeRender turbo:load@document->book-selection#load turbo:frame-load@document->book-selection#loaded turbo:before-fetch-request@document->book-selection#prepareRequest turbo:before-fetch-response@document->book-selection#guardResponse:capture turbo:before-stream-render@document->book-selection#guardStream turbo:before-frame-render@document->book-selection#guardFrame turbo:submit-end@document->book-selection#submitted" } do %>
  <div class="flex items-start justify-between gap-3">
    <h2 id="book-selection-window-title" class="text-lg font-semibold"><%= t("jjaek_books.selection_title") %></h2>
    <button type="button" data-action="book-selection#cancel" class="ui-button ui-button-secondary"><%= t("book_search.actions.close") %></button>
  </div>
  <%= turbo_frame_tag "book_selection", data: { book_selection_target: "frame" } %>
<% end %>
