<% visible_requote_count = visible_requote_count_for(jjaek) %>
<% if policy(jjaek).view_requotes? && visible_requote_count.positive? %>
  <div class="inline-flex items-center gap-2">
    <% requote_users = requote_users_for(jjaek) %>
    <% if requote_users.any? %>
      <%= render "shared/avatar_stack", users: requote_users, data: { requote_user_preview: true } %>
    <% end %>
    <%= link_to t("jjaeks.meta.requotes", count: visible_requote_count), jjaek_requotes_path(jjaek), class: "hover:text-stone-700" %>
  </div>
<% end %>
