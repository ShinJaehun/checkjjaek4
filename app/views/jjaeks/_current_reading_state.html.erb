<% user_book = current_reading_state_for(jjaek) %>
<% if user_book && (user_book.status.present? || user_book.sticker_definitions.any?) %>
  <div class="mt-2 flex flex-wrap items-center gap-1.5 text-xs" data-current-reading-state>
    <% if user_book.status.present? %>
      <%= reading_status_badge(user_book.status) %>
    <% end %>
    <% user_book.sticker_definitions.each do |sticker| %>
      <%= reading_sticker_badge(sticker) %>
    <% end %>
  </div>
<% end %>
