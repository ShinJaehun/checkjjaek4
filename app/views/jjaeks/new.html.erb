<section class="mx-auto w-full max-w-3xl space-y-6">
  <%= render "shared/back_link", jjaek_back: true, path: jjaek_back_path(default_path: root_path) %>
  <section class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
    <% if @quoted_jjaek && policy(@jjaek).view_quoted_source? %>
      <%= render "jjaeks/quoted_jjaek", quoted_jjaek: @quoted_jjaek %>
    <% end %>
    <% if @share_to_group && @group %>
      <p class="text-sm text-stone-600"><%= t("jjaeks.form.selected_group", group_name: @group.name) %></p>
    <% end %>
    <% form_url = @share_to_group ? jjaeks_path(quoted_jjaek_id: @quoted_jjaek.id, share_to_group: 1) : (@group ? group_jjaeks_path(@group) : jjaeks_path) %>
    <%= render "jjaeks/composer", jjaek: @jjaek, url: form_url,
               visibility_options: @jjaek_visibility_options, destination_groups: (@available_share_groups if @share_to_group) %>
  </section>
</section>
