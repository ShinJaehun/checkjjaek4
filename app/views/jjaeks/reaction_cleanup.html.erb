<section class="mx-auto w-full max-w-3xl space-y-4 rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm">
  <%= link_to t("jjaeks.actions.back"), root_path, class: "text-sm text-stone-600" %>
  <p class="text-sm text-stone-600"><%= t("jjaeks.reaction_cleanup.description") %></p>

  <% @cleanup_comments.each do |comment| %>
    <article class="space-y-2 rounded-2xl bg-stone-50 p-4">
      <p class="whitespace-pre-wrap break-words text-sm text-stone-800"><%= comment.content %></p>
      <p class="text-xs text-stone-500"><%= l(comment.created_at, format: :short) %></p>
      <%= button_to t("comments.actions.delete"), jjaek_comment_path(@jjaek, comment), method: :delete, class: "text-sm text-red-600" %>
    </article>
  <% end %>

  <% if @cleanup_like %>
    <%= button_to t("likes.actions.unlike"), jjaek_like_path(@jjaek), method: :delete, class: "text-sm text-red-600" %>
  <% end %>
</section>
