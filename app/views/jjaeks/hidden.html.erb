<section class="mx-auto flex w-full max-w-3xl flex-col gap-6">
  <%= render "jjaeks/jjaek",
             jjaek: @jjaek,
             detail_context: true,
             moderation_actions: @moderation_actions,
             group_moderation_actions: @group_moderation_actions %>
  <% if policy(@jjaek).view_hidden_placeholder? || policy(@jjaek).view_deleted_tombstone? %>
    <%= render "comments/comments_panel", jjaek: @jjaek, comments: @comments, comment: @comment %>
  <% elsif policy(@jjaek).view_hidden_read_actions? %>
    <%= render "comments/comments_panel",
              jjaek: @jjaek,
              comments: @comments,
              comment: @comment %>
  <% end %>
</section>
