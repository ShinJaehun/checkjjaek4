<div data-moderation-history-entry="<%= action.id %>">
  <p class="flex flex-wrap items-center gap-x-2 gap-y-1">
    <span class="font-semibold"><%= t("admin.jjaeks.moderation.actions.#{action.action_type}") %></span>
    <span class="inline-flex rounded-full px-2 py-0.5 text-xs <%= action.platform_authority? ? "bg-red-100 text-red-800" : "bg-amber-200 text-amber-900" %>">
      <%= moderation_authority_label(action) %>
    </span>
    <span><%= action.actor.name %></span>
    <span class="font-semibold">· <%= l(action.created_at, format: :short) %></span>
  </p>

  <div class="mt-3 grid gap-2">
    <div class="rounded-xl border border-amber-200 bg-white/70 p-3" data-moderation-detail="reason">
      <p class="text-xs font-semibold text-amber-800"><%= t("admin.jjaeks.moderation.reason") %></p>
      <p class="mt-1 whitespace-pre-wrap text-sm text-stone-800"><%= moderation_action_reason_label(action) %></p>
    </div>

    <% if action.internal_note.present? %>
      <div class="rounded-xl border border-stone-200 bg-white/70 p-3" data-role="internal-note" data-moderation-detail="memo">
        <p class="text-xs font-semibold text-stone-600"><%= t("admin.jjaeks.moderation.memo") %></p>
        <p class="mt-1 whitespace-pre-wrap text-sm text-stone-800"><%= action.internal_note %></p>
      </div>
    <% end %>
  </div>
</div>
