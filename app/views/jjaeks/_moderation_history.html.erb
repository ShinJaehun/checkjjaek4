<% if moderation_actions.present? %>
  <section id="<%= section_id %>" class="rounded-3xl border border-amber-200 bg-amber-50/60 p-5 text-sm text-amber-950">
    <h2 class="font-semibold"><%= t("admin.jjaeks.moderation.history") %></h2>
    <ol id="<%= list_id %>" class="mt-3">
      <% moderation_actions.each do |action| %>
        <li data-moderation-action-id="<%= action.id %>" class="border-t border-amber-200 py-3 first:border-t-0 first:pt-0 last:pb-0">
          <p class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <span class="font-semibold"><%= t("admin.jjaeks.moderation.actions.#{action.action_type}") %></span>
            <span class="inline-flex rounded-full px-2 py-0.5 text-xs <%= action.platform_authority? ? "bg-red-100 text-red-800" : "bg-amber-200 text-amber-900" %>">
              <%= moderation_authority_label(action) %>
            </span>
            <span><%= action.actor.name %></span>
            <span class="font-semibold">· <%= l(action.created_at, format: :short) %></span>
          </p>
          <p class="mt-1"><%= t("admin.jjaeks.moderation.reason") %>: <%= moderation_action_reason_label(action) %></p>
          <% if action.internal_note.present? %>
            <p data-role="internal-note" class="mt-1 whitespace-pre-wrap"><%= t("admin.jjaeks.moderation.memo") %>: <%= action.internal_note %></p>
          <% end %>
        </li>
      <% end %>
    </ol>
  </section>
<% end %>
