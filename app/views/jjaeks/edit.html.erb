<section class="mx-auto w-full max-w-3xl space-y-6">
  <%= render "shared/back_link", jjaek_back: true, path: jjaek_back_path(default_path: jjaek_path(@jjaek)) %>
  <section class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
    <% if policy(@jjaek).view_quoted_source? %>
      <%= render "jjaeks/quoted_jjaek", quoted_jjaek: @jjaek.quoted_jjaek %>
    <% end %>
    <%= render "jjaeks/composer", jjaek: @jjaek %>
  </section>
</section>
