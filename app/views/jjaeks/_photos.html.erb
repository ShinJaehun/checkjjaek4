<% if policy(jjaek).view_photos? %>
  <% photos = jjaek.ordered_photos %>
  <% if photos.any? %>
    <div class="mt-4" data-controller="photo-gallery"
         data-action="keydown@document->photo-gallery#keydown turbo:before-cache@document->photo-gallery#close">
      <div class="jjaek-photo-grid" data-count="<%= photos.size %>"
           data-action="contextmenu->photo-gallery#prevent dragstart->photo-gallery#prevent">
        <% photos.each_with_index do |photo, index| %>
          <button type="button" data-photo-gallery-target="thumbnail" data-action="photo-gallery#open"
                  data-gallery-url="<%= jjaek_photo_path(jjaek, photo, size: :gallery) %>"
                  aria-label="<%= t('jjaek_photos.open', number: index + 1) %>">
            <%= image_tag jjaek_photo_path(jjaek, photo, size: :card), alt: t("jjaek_photos.photo"),
                          loading: :lazy, decoding: :async, draggable: false %>
          </button>
        <% end %>
      </div>
      <%= render "shared/photo_gallery", image_alt: t("jjaek_photos.photo") %>
    </div>
  <% end %>
<% end %>
