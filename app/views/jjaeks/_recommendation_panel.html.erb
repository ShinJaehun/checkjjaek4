<div data-recommendation-composer-target="panel"
     data-group-id="<%= @group&.id %>"
     data-step="<%= @recommendation_step || 'selection' %>"
     data-mode="<%= @editing_recommendation ? 'edit' : 'create' %>"
     data-editing-id="<%= @editing_recommendation&.id %>"
     data-return-path="<%= recommendation_origin_path if @editing_recommendation %>"
     class="min-w-0 space-y-4">
  <% if @group %>
    <p class="text-sm text-stone-600"><%= t("recommendations.group_context", group_name: @group.name) %></p>
  <% end %>
  <div id="recommendation-selection-alert" role="alert" class="text-sm text-red-700"><%= flash[:alert] %></div>

  <div data-recommendation-composer-target="selection" <%= "hidden" if @recommendation_step == "writing" %>>
    <%= form_with url: book_search_path, method: :get,
                  data: { turbo_frame: "_top", recommendation_selection_form: "search" }, class: "space-y-2" do |form| %>
      <%= hidden_field_tag :recommendation, "1", id: nil %>
      <%= hidden_field_tag :editing_jjaek_id, @editing_recommendation.id, id: nil if @editing_recommendation %>
      <%= hidden_field_tag :return_to, validated_jjaek_return_path(params[:return_to]), id: nil if @editing_recommendation %>
      <%= hidden_field_tag :group_id, @group.id, id: nil if @group %>
      <%= hidden_field_tag :search_origin, recommendation_origin_path, id: nil if recommendation_origin_path %>
      <% @selected_book_keys.each do |key| %>
        <%= hidden_field_tag "selected_books[]", key, id: nil %>
      <% end %>
      <%= form.label :query, t("book_search.form.query"), for: "recommendation-query", class: "text-sm font-medium" %>
      <div class="flex min-w-0 gap-2">
        <%= form.search_field :query, id: "recommendation-query", value: @query, placeholder: t("book_search.placeholder"),
                              class: "min-w-0 flex-1 rounded-xl border border-stone-300 px-3 py-2 text-sm" %>
        <%= form.submit t("book_search.form.submit"), name: nil, class: "ui-button ui-button-secondary shrink-0" %>
      </div>
    <% end %>
  </div>

  <div id="recommendation-selected-books"><%= render "book_searches/recommendation_selection" %></div>
  <%= render "jjaeks/recommendation_selection_fields" %>
  <div data-recommendation-composer-target="selection" <%= "hidden" if @recommendation_step == "writing" %>>
    <button type="button" data-action="recommendation-composer#write" data-recommendation-composer-target="continue"
            <%= "disabled" if @selected_books.empty? %> class="ui-button ui-button-primary"><%= t("recommendations.finish_selection") %></button>
  </div>

  <div data-recommendation-composer-target="writing" <%= "hidden" unless @recommendation_step == "writing" %>>
    <% form_url = @editing_recommendation ? jjaek_path(@jjaek) : (@group ? group_jjaeks_path(@group) : jjaeks_path) %>
    <%= form_with model: @jjaek, url: form_url, method: (@editing_recommendation ? :patch : :post),
                  id: "recommendation-jjaek-form", data: { turbo_frame: "_top" }, class: "space-y-4" do |form| %>
      <%= hidden_field_tag :recommendation, "1", id: nil %>
      <% unless @group %>
        <div class="space-y-2">
          <%= form.label :visibility, t("jjaeks.form.visibility"), class: "text-sm font-medium" %>
          <%= form.select :visibility, Jjaek.visibilities.keys.map { |visibility| [t("jjaeks.visibility.#{visibility}"), visibility] },
                          {}, class: "w-full rounded-xl border border-stone-300 bg-white px-3 py-2 text-sm" %>
        </div>
      <% end %>
      <p class="text-sm font-medium"><%= t("recommendations.reason") %></p>
      <%= render "shared/content_field", form: form, label_key: "recommendations.reason", rows: 4, required: true %>
      <div class="flex flex-wrap gap-2">
        <%= form.submit t(@editing_recommendation ? "recommendations.save_edit" : "jjaeks.actions.publish_short"), class: "ui-button ui-button-primary" %>
      </div>
    <% end %>
  </div>
</div>
