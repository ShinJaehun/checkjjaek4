<ul class="mt-4 space-y-3" aria-label="<%= t("recommendations.selected_books") %>">
  <% books.each do |book| %>
    <% book_url = book_path(book, book_navigation_params) if local_assigns.fetch(:link, true) %>
    <li class="flex items-start gap-3">
      <%= render "books/thumbnail", title: book.title, thumbnail: book.thumbnail, url: book_url,
                 size: :small, link: local_assigns.fetch(:link, true) %>
      <div class="min-w-0 flex-1 break-words">
        <div class="text-sm font-semibold leading-6 text-stone-900">
          <% if local_assigns.fetch(:link, true) %>
            <%= link_to book.title, book_url, class: "hover:text-stone-700" %>
          <% else %>
            <%= book.title %>
          <% end %>
        </div>
        <div class="mt-1 text-xs leading-5 text-stone-500"><%= book.authors_text.presence || "-" %></div>
      </div>
    </li>
  <% end %>
</ul>
