<%= hidden_field_tag "selected_books[]", "", id: nil, form: "jjaek-publish-form" %>
<% books.zip(keys).each do |book, key| %>
  <div data-book-key="<%= key %>" class="flex flex-wrap items-center gap-3 rounded-2xl border border-stone-100 bg-stone-50 px-3 py-2">
    <%= hidden_field_tag "selected_books[]", key, id: nil, form: "jjaek-publish-form" %>
    <div class="flex min-w-0 basis-full items-center gap-3 sm:flex-1">
      <div class="flex w-11 shrink-0 justify-center">
        <%= render "books/thumbnail", title: book.title, thumbnail: book.thumbnail, url: nil, size: :composer, link: false %>
      </div>
      <div class="min-w-0 flex-1">
        <p class="truncate text-sm font-medium text-stone-900"><%= book.title %></p>
        <p class="mt-1 truncate text-xs text-stone-500"><%= book.authors_text.presence || "-" %></p>
      </div>
    </div>
    <div class="ml-auto flex flex-wrap items-center gap-2">
      <button type="button" data-attachment-remove class="ui-button ui-button-secondary"><%= t("jjaek_books.remove") %></button>
      <% result = attachment_shelf_result(book) %>
      <%= render "jjaeks/attachment_shelf", book: result, bookshelves: current_user.bookshelves.default_first %>
    </div>
  </div>
<% end %>
