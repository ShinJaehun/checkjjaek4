<section class="mx-auto w-full max-w-3xl rounded-3xl border border-amber-200 bg-white p-6 shadow-sm">
  <h1 class="text-2xl font-semibold text-stone-900"><%= t("jjaeks.moderation.group_admin.restore_title") %></h1>
  <p class="mt-2 text-sm text-stone-600"><%= t("jjaeks.moderation.group_admin.restore_description") %></p>

  <%= render "jjaeks/moderation_action_context", jjaek: @jjaek %>

  <section class="mt-6">
    <h2 class="mb-3 text-lg font-semibold text-stone-900"><%= t("jjaeks.moderation.group_admin.current_hide") %></h2>
    <div class="rounded-2xl bg-amber-50 p-4 text-sm text-amber-950" data-current-hide-action-id="<%= @current_hide_action.id %>">
      <%= render "jjaeks/moderation_history_entry", action: @current_hide_action %>
    </div>
  </section>

  <% if @error_message.present? %>
    <p class="mt-5 rounded-2xl bg-red-50 p-4 text-sm text-red-700"><%= @error_message %></p>
  <% end %>

  <%= render "form" %>
  <%= link_to @group_content_return ? t("groups.content_inventory.actions.back_from_moderation") : t("jjaeks.moderation.group_admin.cancel"),
              @return_path,
              class: "mt-5 inline-block text-sm font-medium text-stone-600 underline" %>
</section>
