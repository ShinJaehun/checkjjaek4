<div class="rounded-2xl border border-stone-200 bg-stone-50/80 px-4 py-3 text-sm text-stone-600">
  <div class="flex items-center gap-2 text-xs font-medium text-stone-600">
    <%= user_avatar_image(quoted_jjaek.user, size: 128, alt: quoted_jjaek.user.name, class: "h-8 w-8 shrink-0 rounded-full object-cover") %>
    <span class="min-w-0 break-words">
      <%= link_to quoted_jjaek.user.name, user_path(quoted_jjaek.user), class: "font-semibold text-stone-800 hover:text-stone-900" %><%= t("jjaeks.labels.quoted_general_suffix") %>
    </span>
  </div>
  <div class="mt-1 flex flex-wrap items-center gap-x-1 gap-y-0.5 text-xs text-stone-500">
    <%= render "jjaeks/timestamps", jjaek: quoted_jjaek, detail_context: true %>
  </div>

  <% books = quoted_jjaek.attached_books.to_a %>
  <% attached_book = books.first if books.one? %>
  <% if books.many? %>
    <%= render "jjaeks/book_attachments", books: books %>
    <p class="mt-3 line-clamp-4 whitespace-pre-wrap text-sm leading-6 text-stone-700"><%= jjaek_content_with_hashtags(quoted_jjaek.content) %></p>
  <% elsif attached_book.present? && !local_assigns.fetch(:hide_book_details, false) %>
    <div class="mt-3 flex flex-col items-start gap-3 sm:flex-row">
      <div class="shrink-0 self-start">
        <%= render "books/thumbnail",
                   title: attached_book.title,
                   thumbnail: attached_book.thumbnail,
                   url: book_path(attached_book, book_navigation_params),
                   size: :medium %>
      </div>

      <div class="min-w-0 flex-1">
        <%= link_to attached_book.title, book_path(attached_book, book_navigation_params), class: "text-sm font-semibold leading-5 text-stone-900 hover:text-stone-700" %>
        <div class="mt-1 text-xs leading-5 text-stone-500"><%= attached_book.authors_text.presence || "-" %></div>
        <p class="mt-2 line-clamp-4 whitespace-pre-wrap text-sm leading-6 text-stone-700"><%= jjaek_content_with_hashtags(quoted_jjaek.content) %></p>
      </div>
    </div>
  <% else %>
    <p class="mt-3 line-clamp-4 whitespace-pre-wrap text-sm leading-6 text-stone-700"><%= jjaek_content_with_hashtags(quoted_jjaek.content) %></p>
  <% end %>
</div>
