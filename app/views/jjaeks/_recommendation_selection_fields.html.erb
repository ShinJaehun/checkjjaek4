<div id="recommendation-selection-fields" data-recommendation-composer-target="fields">
  <%= hidden_field_tag :query, @query, id: nil, form: "recommendation-jjaek-form" %>
  <%= hidden_field_tag :page, @page, id: nil, form: "recommendation-jjaek-form" %>
  <%= hidden_field_tag :group_id, @group.id, id: nil, form: "recommendation-jjaek-form" if @group %>
  <%= hidden_field_tag :search_origin, recommendation_origin_path, id: nil, form: "recommendation-jjaek-form" if recommendation_origin_path %>
  <% @selected_book_keys.each do |key| %>
    <%= hidden_field_tag "selected_books[]", key, id: nil, form: "recommendation-jjaek-form" %>
  <% end %>
</div>
