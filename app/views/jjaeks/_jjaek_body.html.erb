<% show_quoted_source = local_assigns.fetch(:show_quoted_source, true) %>
<% books = jjaek.attached_books.to_a %>
<% if jjaek.deleted? %>
  <% books = jjaek.requote? ? [] : books.select { |book| book.id == jjaek.book_id } %>
<% end %>
<% attached_book = books.first if books.one? %>
<% if books.many? %>
  <%= render "jjaeks/recommended_books", books: books %>
<% end %>
<% if attached_book.present? && !local_assigns.fetch(:hide_book_details, false) %>
  <% book_url = book_path(attached_book, book_navigation_params) %>
  <div class="mt-4 flex flex-col items-start gap-4 sm:flex-row">
    <div class="shrink-0 self-start">
      <%= render "books/thumbnail",
                 title: attached_book.title,
                 thumbnail: attached_book.thumbnail,
                 url: book_url,
                 size: :medium %>
    </div>

    <div class="min-w-0 flex-1">
      <div>
        <%= link_to attached_book.title, book_url, class: "text-base font-semibold leading-6 text-stone-900 hover:text-stone-700" %>
        <div class="mt-1 text-xs leading-5 text-stone-500"><%= attached_book.authors_text.presence || "-" %></div>
      </div>

      <%= render "jjaeks/current_reading_state", jjaek: jjaek unless local_assigns.fetch(:book_friend_preview, false) %>

      <% if jjaek.deleted? %>
        <div class="mt-3 whitespace-pre-wrap text-sm leading-6 text-stone-800"><%= t("jjaeks.labels.deleted") %></div>
      <% else %>
        <% if show_quoted_source && policy(jjaek).view_quoted_source? %>
          <div class="mt-3">
            <%= render "jjaeks/quoted_jjaek", quoted_jjaek: jjaek.quoted_jjaek %>
          </div>
        <% elsif show_quoted_source && jjaek.quoted_source_deleted? %>
          <div class="mt-3">
            <%= render "jjaeks/deleted_quoted_source", jjaek: jjaek %>
          </div>
        <% end %>

        <div class="mt-3 whitespace-pre-wrap text-sm leading-6 text-stone-800"><%= jjaek_content_with_hashtags(jjaek.content) %></div>
      <% end %>
    </div>
  </div>
<% else %>
  <% if attached_book.present? && !local_assigns.fetch(:book_friend_preview, false) %>
    <%= render "jjaeks/current_reading_state", jjaek: jjaek %>
  <% end %>

  <% if jjaek.deleted? %>
    <div class="mt-4 whitespace-pre-wrap text-sm leading-6 text-stone-800"><%= t("jjaeks.labels.deleted") %></div>
  <% else %>
    <% if show_quoted_source && policy(jjaek).view_quoted_source? %>
      <div class="mt-4">
        <%= render "jjaeks/quoted_jjaek", quoted_jjaek: jjaek.quoted_jjaek,
                   hide_book_details: local_assigns.fetch(:hide_book_details, false) && books.one? && jjaek.quoted_jjaek.attached_books.map(&:id) == books.map(&:id) %>
      </div>
    <% elsif show_quoted_source && jjaek.quoted_source_deleted? %>
      <div class="mt-4">
        <%= render "jjaeks/deleted_quoted_source", jjaek: jjaek %>
      </div>
    <% end %>

    <div class="mt-4 whitespace-pre-wrap text-sm leading-6 text-stone-800"><%= jjaek_content_with_hashtags(jjaek.content) %></div>
  <% end %>
<% end %>
