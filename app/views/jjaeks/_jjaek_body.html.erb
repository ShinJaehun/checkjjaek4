<% if jjaek.book.present? && !local_assigns.fetch(:hide_book_details, false) %>
  <% book_url = book_path(jjaek.book, book_navigation_params) %>
  <div class="mt-4 flex flex-col items-start gap-4 sm:flex-row">
    <div class="shrink-0 self-start">
      <%= render "books/thumbnail",
                 title: jjaek.book.title,
                 thumbnail: jjaek.book.thumbnail,
                 url: book_url,
                 size: :medium %>
    </div>

    <div class="min-w-0 flex-1">
      <div>
        <%= link_to jjaek.book.title, book_url, class: "text-base font-semibold leading-6 text-stone-900 hover:text-stone-700" %>
        <div class="mt-1 text-xs leading-5 text-stone-500"><%= jjaek.book.authors_text.presence || "-" %></div>
      </div>

      <%= render "jjaeks/current_reading_state", jjaek: jjaek %>

      <% if jjaek.deleted? %>
        <div class="mt-3 whitespace-pre-wrap text-sm leading-6 text-stone-800"><%= t("jjaeks.labels.deleted") %></div>
      <% else %>
        <% if policy(jjaek).view_quoted_source? %>
          <div class="mt-3">
            <%= render "jjaeks/quoted_jjaek", quoted_jjaek: jjaek.quoted_jjaek %>
          </div>
        <% elsif jjaek.quoted_source_deleted? %>
          <div class="mt-3">
            <%= render "jjaeks/deleted_quoted_source", jjaek: jjaek %>
          </div>
        <% end %>

        <div class="mt-3 whitespace-pre-wrap text-sm leading-6 text-stone-800"><%= jjaek.content %></div>
      <% end %>
    </div>
  </div>
<% else %>
  <% if jjaek.book.present? && !local_assigns.fetch(:book_friend_preview, false) %>
    <%= render "jjaeks/current_reading_state", jjaek: jjaek %>
  <% end %>

  <% if jjaek.deleted? %>
    <div class="mt-4 whitespace-pre-wrap text-sm leading-6 text-stone-800"><%= t("jjaeks.labels.deleted") %></div>
  <% else %>
    <% if policy(jjaek).view_quoted_source? %>
      <div class="mt-4">
        <%= render "jjaeks/quoted_jjaek", quoted_jjaek: jjaek.quoted_jjaek,
                   hide_book_details: local_assigns.fetch(:hide_book_details, false) && jjaek.quoted_jjaek.book_id == jjaek.book_id %>
      </div>
    <% elsif jjaek.quoted_source_deleted? %>
      <div class="mt-4">
        <%= render "jjaeks/deleted_quoted_source", jjaek: jjaek %>
      </div>
    <% end %>

    <div class="mt-4 whitespace-pre-wrap text-sm leading-6 text-stone-800"><%= jjaek.content %></div>
  <% end %>
<% end %>
