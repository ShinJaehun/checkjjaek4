<% jjaek_policy = policy(jjaek) %>
<% platform_history_visible = jjaek_policy.view_admin_inventory? && moderation_actions.present? %>
<% group_history_visible = jjaek_policy.view_group_moderation_history? && group_moderation_actions.present? %>

<% if platform_history_visible || group_history_visible %>
  <div class="mt-4 space-y-4" data-jjaek-moderation-history>
    <% if platform_history_visible %>
      <%= render "jjaeks/moderation_history",
                 moderation_actions: moderation_actions,
                 section_id: "admin_moderation_history_section",
                 list_id: "admin_moderation_history",
                 nested: true %>
    <% end %>

    <% if group_history_visible %>
      <%= render "jjaeks/group_moderation", moderation_actions: group_moderation_actions %>
    <% end %>
  </div>
<% end %>
