<% inline_comments_context = local_assigns[:inline_comments_context] %>
<% inline_comments_profile_user = local_assigns[:inline_comments_profile_user] %>
<% inline_comments_book = local_assigns[:inline_comments_book] %>
<% book_friend_preview = local_assigns.fetch(:book_friend_preview, false) %>
<div class="mt-4 flex flex-wrap items-center gap-4 text-xs text-stone-500">
  <% if show_like_summary_action?(jjaek) %>
    <%= render "jjaeks/like_summary_action", jjaek: jjaek, book_friend_preview: book_friend_preview %>
  <% end %>
  <%= render "jjaeks/comment_action", jjaek:, book_friend_preview:,
             comments_context: inline_comments_context, profile_user: inline_comments_profile_user, book: inline_comments_book %>
  <%= render "jjaeks/requote_action", jjaek: jjaek %>
</div>
