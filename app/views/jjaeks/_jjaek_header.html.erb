<% show_actions = local_assigns.fetch(:show_actions, true) %>
<% show_context = local_assigns.fetch(:show_context, true) %>
<% book_friend_preview = local_assigns.fetch(:book_friend_preview, false) %>
<% moderation_action = local_assigns[:moderation_action] %>
<% hide_book_details = local_assigns.fetch(:hide_book_details, false) %>

<div class="flex items-start justify-between gap-3">
  <div class="flex min-w-0 items-start gap-3">
    <%= user_avatar_image(jjaek.user, size: 128, alt: jjaek.user.name, class: "h-10 w-10 shrink-0 rounded-full object-cover") %>

    <div class="min-w-0">
      <% context_label = if book_friend_preview
        t("jjaeks.contexts.book_html", author_name: link_to(jjaek.user.name, user_path(jjaek.user), class: "font-semibold text-stone-900 hover:text-stone-700"))
      elsif show_context
        jjaek_context_label(jjaek, hide_book_details: hide_book_details)
      end %>
      <% if context_label.present? %>
        <div class="text-sm text-stone-600">
          <%= context_label %>
        </div>
      <% else %>
        <div class="text-sm font-semibold text-stone-900">
          <%= link_to jjaek.user.name, user_path(jjaek.user), class: "hover:text-stone-700" %>
        </div>
      <% end %>
      <div class="mt-1 text-xs text-stone-500">
        <%= t("jjaeks.meta.created_at", time: l(jjaek.created_at, format: :short)) %>
        <% if jjaek.deleted? %>
          · <%= t("jjaeks.meta.deleted_at", time: l(jjaek.deleted_at, format: :short)) %>
        <% elsif jjaek_edited?(jjaek) %>
          · <%= t("jjaeks.meta.edited_at", time: l(jjaek.content_edited_at, format: :short)) %>
        <% end %>
        <% if jjaek.group_id.blank? %>
          · <%= t("jjaeks.visibility.#{jjaek.visibility}") %>
        <% end %>
        <% if show_context && !book_friend_preview && !hide_book_details && show_requote_book_link?(jjaek) %>
          ·
          <%= link_to jjaek.book.title, book_path(jjaek.book, book_navigation_params), class: "font-medium hover:text-stone-700" %>
        <% end %>
      </div>
    </div>
  </div>

  <% if show_actions && (policy(jjaek).update? || policy(jjaek).destroy? || moderation_action.present?) %>
    <div class="flex items-center gap-2 text-xs text-stone-500">
      <%= link_to t("jjaeks.actions.edit"), edit_jjaek_path(jjaek, jjaek_navigation_params) if policy(jjaek).update? %>
      <%= button_to t("jjaeks.actions.delete"), jjaek_path(jjaek, jjaek_navigation_params), method: :delete, form: { data: { turbo_confirm: t("jjaeks.confirmations.destroy") } }, class: "text-red-600" if policy(jjaek).destroy? %>
      <% if moderation_action.present? %>
        <%= link_to moderation_action.fetch(:label),
                    moderation_action.fetch(:path),
                    class: "inline-flex items-center rounded-full bg-amber-800 px-3 py-1.5 text-xs font-medium text-white hover:bg-amber-900",
                    data: { jjaek_moderation_action: true } %>
      <% end %>
    </div>
  <% end %>
</div>
