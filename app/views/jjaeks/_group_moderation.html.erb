<% jjaek_policy = policy(jjaek) %>

<% if jjaek_policy.hide_as_group_admin? || jjaek_policy.restore_as_group_admin? %>
  <section id="group_moderation_state" class="rounded-2xl border border-amber-200 bg-amber-50/60 p-4 text-sm text-amber-950">
    <h2 class="font-semibold"><%= t("admin.jjaeks.moderation.title") %></h2>
    <p class="mt-3 font-medium">
      <%= t("admin.jjaeks.moderation.status") %>:
      <span class="inline-flex rounded-full bg-amber-200 px-2 py-0.5 text-xs">
        <%= t("admin.jjaeks.moderation.#{jjaek.hidden? ? :hidden : :visible}") %>
      </span>
    </p>

    <% action_path = if jjaek_policy.hide_as_group_admin?
      new_jjaek_group_hide_path(jjaek)
    else
      new_jjaek_group_restoration_path(jjaek)
    end %>
    <% action_label = jjaek_policy.hide_as_group_admin? ? t("admin.jjaeks.actions.hide") : t("admin.jjaeks.actions.restore") %>
    <%= link_to action_label,
                action_path,
                class: "mt-4 inline-flex rounded-full bg-amber-800 px-4 py-2 font-medium text-white" %>
  </section>
<% end %>

<%= render "jjaeks/moderation_history",
           moderation_actions: moderation_actions,
           section_id: "group_moderation_history",
           list_id: "group_moderation_history_list",
           nested: true %>
