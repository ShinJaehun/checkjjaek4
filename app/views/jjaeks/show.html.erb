<section class="mx-auto flex w-full max-w-3xl flex-col gap-6">
  <% if policy(@jjaek).view_admin_inventory? %>
    <section class="rounded-3xl border border-red-200 bg-red-50/60 p-5 text-sm text-red-900">
      <h2 class="font-semibold"><%= t("admin.jjaeks.moderation.title") %></h2>

      <% if @current_hide_action.present? %>
        <p class="mt-3 font-medium"><%= t("admin.jjaeks.moderation.hidden") %></p>
        <p class="mt-2"><%= t("admin.jjaeks.moderation.reason") %>: <%= jjaek_hide_reason_label(@current_hide_action.public_reason) %></p>
        <% if @current_hide_action.internal_note.present? %>
          <p class="mt-2 whitespace-pre-wrap"><%= t("admin.jjaeks.moderation.internal_note") %>: <%= @current_hide_action.internal_note %></p>
        <% end %>
        <p class="mt-2 text-xs">
          <%= t("admin.jjaeks.moderation.performed_by", actor: @current_hide_action.actor.name, time: l(@current_hide_action.created_at, format: :short)) %>
        </p>

        <% if policy(@jjaek).restore? %>
          <%= form_with url: restore_admin_jjaek_path(@jjaek), method: :patch, scope: :moderation_action, class: "mt-4 space-y-3" do |form| %>
            <%= form.label :public_reason, t("admin.jjaeks.moderation.restore_reason"), class: "block font-medium" %>
            <%= form.text_area :public_reason, rows: 2, required: true, class: "w-full rounded-xl border border-red-200 bg-white px-3 py-2" %>
            <%= form.label :internal_note, t("admin.jjaeks.moderation.internal_note"), class: "block font-medium" %>
            <%= form.text_area :internal_note, rows: 3, class: "w-full rounded-xl border border-red-200 bg-white px-3 py-2" %>
            <%= form.submit t("admin.jjaeks.actions.restore"), class: "rounded-full bg-red-700 px-4 py-2 font-medium text-white" %>
          <% end %>
        <% end %>
      <% elsif policy(@jjaek).hide? %>
        <%= form_with url: hide_admin_jjaek_path(@jjaek), method: :patch, scope: :moderation_action, class: "mt-4 space-y-3" do |form| %>
          <%= form.label :public_reason, t("admin.jjaeks.moderation.reason"), class: "block font-medium" %>
          <%= form.select :public_reason,
                          options_for_select(jjaek_hide_reason_options),
                          { prompt: t("admin.jjaeks.moderation.reason_prompt") },
                          required: true,
                          class: "w-full rounded-xl border border-red-200 bg-white px-3 py-2" %>
          <%= form.label :internal_note, t("admin.jjaeks.moderation.internal_note"), class: "block font-medium" %>
          <%= form.text_area :internal_note, rows: 3, class: "w-full rounded-xl border border-red-200 bg-white px-3 py-2" %>
          <%= form.submit t("admin.jjaeks.actions.hide"), class: "rounded-full bg-red-700 px-4 py-2 font-medium text-white" %>
        <% end %>
      <% end %>

      <% if @moderation_actions.present? %>
        <h3 class="mt-5 font-semibold"><%= t("admin.jjaeks.moderation.history") %></h3>
        <ol class="mt-3 space-y-3">
          <% @moderation_actions.each do |action| %>
            <li class="rounded-xl border border-red-200 bg-white p-3">
              <p class="font-medium"><%= t("admin.jjaeks.moderation.actions.#{action.action_type}") %></p>
              <p class="mt-1"><%= t("admin.jjaeks.moderation.reason") %>: <%= moderation_action_reason_label(action) %></p>
              <% if action.internal_note.present? %>
                <p class="mt-1 whitespace-pre-wrap"><%= t("admin.jjaeks.moderation.internal_note") %>: <%= action.internal_note %></p>
              <% end %>
              <p class="mt-1 text-xs"><%= t("admin.jjaeks.moderation.performed_by", actor: action.actor.name, time: l(action.created_at, format: :short)) %></p>
            </li>
          <% end %>
        </ol>
      <% end %>
    </section>
  <% end %>

  <%= render "jjaeks/group_moderation", jjaek: @jjaek, moderation_actions: @group_moderation_actions %>

  <%= render "jjaeks/jjaek", jjaek: @jjaek %>

  <% if policy(@jjaek).create_requote? %>
    <div>
      <%= link_to t("jjaeks.actions.requote"),
                  new_jjaek_path(quoted_jjaek_id: @jjaek.id),
                  class: "inline-flex rounded-full bg-stone-900 px-4 py-2 text-sm font-medium text-stone-50" %>
    </div>
  <% end %>

  <% visible_requote_count = visible_requote_count_for(@jjaek) %>
  <% if policy(@jjaek).requote? && visible_requote_count.positive? %>
    <div>
      <%= link_to t("requotes.actions.view_panel"),
                  jjaek_requotes_path(@jjaek),
                  data: { turbo_stream: true },
                  class: "inline-flex rounded-full border border-stone-300 bg-white px-4 py-2 text-sm font-medium text-stone-700 hover:border-stone-400 hover:text-stone-900" %>
    </div>
  <% end %>

  <div id="<%= requotes_panel_dom_id(@jjaek) %>"></div>

  <%= render "comments/comments_panel", jjaek: @jjaek, comments: @comments, comment: @comment %>
</section>
