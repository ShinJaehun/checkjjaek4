<% comments_context = local_assigns.fetch(:comments_context, :detail) %>
<% comments_profile_user = local_assigns[:comments_profile_user] %>
<% comments_book = local_assigns[:comments_book] %>
<% destroy_comments_params = { comments_context: comments_context } %>
<% destroy_comments_params[:profile_user_id] = comments_profile_user.id if comments_profile_user.present? %>
<% destroy_comments_params[:book_id] = comments_book.id if comments_book.present? %>
<% editing = comment.errors.any? %>
<% displayed_content = editing ? comment.content_in_database : comment.content %>
<% comment_policy = policy(comment) %>
<% current_hide_action = comment.current_hide_action if comment.hidden? %>

<article id="<%= dom_id(comment) %>" class="rounded-2xl bg-stone-50 px-4 py-3" data-controller="comment-edit">
  <div class="flex items-center justify-between gap-3">
    <div class="flex min-w-0 items-center gap-2">
      <%= user_avatar_image(comment.user, size: 128, alt: comment.user.name, class: "h-8 w-8 shrink-0 rounded-full object-cover") %>
      <div class="text-sm font-medium text-stone-800"><%= comment.user.name %></div>
    </div>
    <div class="flex items-center gap-3 <%= "hidden" if editing %>" data-comment-edit-target="actions">
      <% if comment_policy.update? %>
        <button type="button" class="text-xs font-medium text-stone-600" data-action="comment-edit#open"><%= t("comments.actions.edit") %></button>
      <% end %>
      <% if comment_policy.destroy? %>
        <%= button_to t("comments.actions.delete"),
                      jjaek_comment_path(jjaek, comment),
                      method: :delete,
                      params: destroy_comments_params,
                      class: "text-xs text-red-600" %>
      <% end %>
    </div>
  </div>
  <% if comment.hidden? %>
    <div class="mt-2 text-sm leading-6 text-red-900">
      <p><%= t("comments.moderation.hidden_by_#{current_hide_action.moderation_authority}") %></p>
      <p><%= t("comments.moderation.reason") %>: <%= jjaek_hide_reason_label(current_hide_action.public_reason) %></p>
    </div>
  <% end %>

  <% if comment_policy.view_original_content? %>
    <p class="mt-2 text-sm leading-6 text-stone-700 <%= "hidden" if editing %>" data-comment-edit-target="display"><%= displayed_content %></p>
  <% end %>

  <% if comment_policy.update? %>
    <div class="mt-3 <%= "hidden" unless editing %>" data-comment-edit-target="form">
      <%= render "comments/form",
                 jjaek: jjaek,
                 comment: comment,
                 comments_context: comments_context,
                 comments_profile_user: comments_profile_user,
                 comments_book: comments_book,
                 submit_key: "comments.actions.update",
                 edit_form: true %>
    </div>
  <% end %>

  <% if comment_policy.hide? || comment_policy.hide_as_group_admin? || comment_policy.restore? || comment_policy.restore_as_group_admin? %>
    <section class="mt-4 rounded-2xl border border-amber-200 bg-amber-50/60 p-4 text-sm text-amber-950">
      <h3 class="font-semibold"><%= t("admin.jjaeks.moderation.title") %></h3>
      <p class="mt-2 font-medium">
        <%= t("admin.jjaeks.moderation.status") %>:
        <%= t("admin.jjaeks.moderation.#{comment.hidden? ? :hidden : :visible}") %>
      </p>

      <% if comment_policy.hide? || comment_policy.hide_as_group_admin? %>
        <% hide_path = comment_policy.hide? ? hide_admin_jjaek_comment_path(jjaek, comment) : hide_jjaek_comment_path(jjaek, comment) %>
        <%= form_with url: hide_path, method: :patch, scope: :moderation_action, class: "mt-3 space-y-3" do |form| %>
          <%= form.label :public_reason, t("jjaeks.moderation.reason"), class: "block font-medium" %>
          <%= form.select :public_reason,
                          options_for_select(jjaek_hide_reason_options),
                          { prompt: t("admin.jjaeks.moderation.reason_prompt") },
                          required: true,
                          class: "w-full rounded-xl border border-amber-200 bg-white px-3 py-2" %>
          <%= form.label :internal_note, t("admin.jjaeks.moderation.internal_note"), class: "block font-medium" %>
          <%= form.text_area :internal_note, rows: 3, class: "w-full rounded-xl border border-amber-200 bg-white px-3 py-2" %>
          <%= form.submit t("admin.jjaeks.actions.hide"), class: "rounded-full bg-amber-800 px-4 py-2 font-medium text-white" %>
        <% end %>
      <% else %>
        <% restore_path = comment_policy.restore? ? restore_admin_jjaek_comment_path(jjaek, comment) : restore_jjaek_comment_path(jjaek, comment) %>
        <%= form_with url: restore_path, method: :patch, scope: :moderation_action, class: "mt-3 space-y-3" do |form| %>
          <%= form.label :public_reason, t("admin.jjaeks.moderation.restore_reason"), class: "block font-medium" %>
          <%= form.text_area :public_reason, rows: 2, required: true, class: "w-full rounded-xl border border-amber-200 bg-white px-3 py-2" %>
          <%= form.label :internal_note, t("admin.jjaeks.moderation.internal_note"), class: "block font-medium" %>
          <%= form.text_area :internal_note, rows: 3, class: "w-full rounded-xl border border-amber-200 bg-white px-3 py-2" %>
          <%= form.submit t("admin.jjaeks.actions.restore"), class: "rounded-full bg-amber-800 px-4 py-2 font-medium text-white" %>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <% if local_assigns[:moderation_actions].present? %>
    <div class="mt-4">
      <%= render "jjaeks/moderation_history",
                moderation_actions: moderation_actions,
                section_id: dom_id(comment, :moderation_history),
                list_id: dom_id(comment, :moderation_history_list) %>
    </div>
  <% end %>
</article>
