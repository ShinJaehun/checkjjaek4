<% comments_context = local_assigns.fetch(:comments_context, :detail) %>
<% comments_profile_user = local_assigns[:comments_profile_user] %>
<% comments_book = local_assigns[:comments_book] %>
<% submit_key = local_assigns.fetch(:submit_key, "comments.actions.submit") %>
<% edit_form = local_assigns.fetch(:edit_form, false) %>

<%= form_with model: [jjaek, comment], class: "space-y-3" do |form| %>
  <%= hidden_field_tag :comments_context, comments_context %>
  <%= hidden_field_tag :profile_user_id, comments_profile_user.id if comments_profile_user.present? %>
  <%= hidden_field_tag :book_id, comments_book.id if comments_book.present? %>

  <% if comment.errors.any? %>
    <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <%= comment.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="space-y-2">
    <%= form.label :content, t("comments.form.content"), class: "sr-only" %>
    <%= form.text_area :content, rows: 3, class: "w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm shadow-sm focus:border-stone-500 focus:outline-none" %>
  </div>

  <div class="flex items-center <%= edit_form ? "justify-end" : "justify-start" %> gap-3">
    <%= form.submit t(submit_key), class: "rounded-full bg-stone-900 px-4 py-2 text-sm font-medium text-stone-50" %>
    <% if edit_form %>
      <button type="button" class="text-sm font-medium text-stone-600" data-action="comment-edit#cancel"><%= t("comments.actions.cancel") %></button>
    <% end %>
  </div>
<% end %>
