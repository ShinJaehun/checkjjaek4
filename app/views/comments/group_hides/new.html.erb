<section class="mx-auto w-full max-w-3xl rounded-3xl border border-amber-200 bg-white p-6 shadow-sm">
  <h1 class="text-2xl font-semibold text-stone-900"><%= t("comments.moderation.group_admin.hide_title") %></h1>
  <p class="mt-2 text-sm text-stone-600"><%= t("comments.moderation.group_admin.hide_description") %></p>

  <%= render "comments/moderation_action_context",
             comment: @comment,
             jjaek: @jjaek,
             comment_label: t("comments.moderation.comment_to_hide") %>

  <% if @error_message.present? %>
    <p class="mt-5 rounded-2xl bg-red-50 p-4 text-sm text-red-700"><%= @error_message %></p>
  <% end %>

  <%= render "form" %>
  <%= link_to @group_content_return ? t("groups.content_inventory.actions.back_from_moderation") : t("comments.moderation.cancel"),
              @return_path,
              class: "mt-5 inline-block text-sm font-medium text-stone-600 underline" %>
</section>
