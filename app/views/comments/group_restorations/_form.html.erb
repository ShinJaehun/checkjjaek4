<%= form_with model: @moderation_action,
              scope: :moderation_action,
              url: jjaek_comment_group_restorations_path(@jjaek, @comment, @return_context_params),
              method: :post,
              class: "mt-6 space-y-4" do |form| %>
  <div class="space-y-2">
    <%= form.label :public_reason, t("comments.moderation.restore_reason"), class: "block text-sm font-medium text-stone-800" %>
    <%= form.text_area :public_reason,
                       required: true,
                       rows: 3,
                       class: "w-full rounded-xl border border-stone-300 px-3 py-2" %>
  </div>

  <%= render "shared/moderation_internal_note_field", form: form,
             label_key: "comments.moderation.internal_note", hint_id: "group_comment_internal_note_hint",
             hint_key: "comments.moderation.group_admin.internal_note_hint" %>

  <%= form.submit t("admin.jjaeks.actions.restore"), class: "ui-button ui-button-warning" %>
<% end %>
