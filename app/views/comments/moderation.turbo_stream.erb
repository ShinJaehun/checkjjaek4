<%= turbo_stream.replace dom_id(@comment) do %>
  <%= render "comments/comment",
             jjaek: @jjaek,
             comment: @comment,
             moderation_actions: @comment_moderation_histories&.[](@comment.id) %>
<% end %>

<%= turbo_stream.update "flash-messages" do %>
  <%= render "shared/flash" %>
<% end %>
