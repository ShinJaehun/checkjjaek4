<section class="mt-5 rounded-2xl border border-stone-200 bg-stone-50/70 p-5" data-comment-moderation-context>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 class="text-base font-semibold text-stone-900"><%= t("comments.moderation.jjaek_context") %></h2>
    <span class="inline-flex rounded-full bg-amber-100 px-2 py-1 text-xs font-medium text-amber-900" data-comment-moderation-jjaek-status>
      <%= t("comments.moderation.statuses.#{jjaek.hidden? ? :hidden : :visible}") %>
    </span>
  </div>

  <div class="mt-4" data-comment-moderation-jjaek>
    <%= render "jjaeks/jjaek_header", jjaek: jjaek, show_actions: false %>
    <%= render "jjaeks/jjaek_body", jjaek: jjaek %>
  </div>

  <section class="mt-5 rounded-xl border border-stone-200 bg-white p-4" data-comment-moderation-target>
    <h3 class="text-sm font-semibold text-stone-900"><%= comment_label %></h3>
    <div class="mt-3 flex items-center gap-2">
      <%= user_avatar_image(comment.user, size: 128, alt: comment.user.name, class: "h-8 w-8 shrink-0 rounded-full object-cover") %>
      <span class="text-sm font-medium text-stone-800"><%= comment.user.name %></span>
      <span class="text-xs text-stone-500">· <%= l(comment.created_at, format: :short) %></span>
    </div>
    <p class="mt-3 whitespace-pre-wrap text-sm leading-6 text-stone-800"><%= comment.content %></p>
  </section>
</section>
