<section class="mt-5 rounded-2xl border border-stone-200 bg-stone-50/70 p-5" data-comment-moderation-context>
  <h2 class="text-base font-semibold text-stone-900"><%= t("comments.moderation.target_comment") %></h2>
  <div class="mt-3 flex items-center gap-2">
    <%= user_avatar_image(comment.user, size: 128, alt: comment.user.name, class: "h-8 w-8 shrink-0 rounded-full object-cover") %>
    <span class="text-sm font-medium text-stone-800"><%= comment.user.name %></span>
    <span class="text-xs text-stone-500">· <%= l(comment.created_at, format: :short) %></span>
  </div>
  <p class="mt-3 whitespace-pre-wrap text-sm leading-6 text-stone-800"><%= comment.content %></p>

  <div class="mt-5 border-t border-stone-200 pt-5" data-comment-parent-context>
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <h2 class="text-base font-semibold text-stone-900"><%= t("comments.moderation.parent_jjaek") %></h2>
      <span class="inline-flex rounded-full bg-amber-100 px-2 py-1 text-xs font-medium text-amber-900">
        <%= t("comments.moderation.parent_status") %>:
        <%= t("admin.jjaeks.moderation.#{jjaek.hidden? ? :hidden : :visible}") %>
      </span>
    </div>
    <div class="flex items-start gap-3">
      <%= user_avatar_image(jjaek.user, size: 128, alt: jjaek.user.name, class: "h-10 w-10 shrink-0 rounded-full object-cover") %>
      <div class="min-w-0">
        <div class="text-sm text-stone-600"><%= jjaek_context_label(jjaek) %></div>
        <div class="mt-1 text-xs text-stone-500"><%= t("jjaeks.meta.created_at", time: l(jjaek.created_at, format: :short)) %></div>
      </div>
    </div>
    <%= render "jjaeks/jjaek_body", jjaek: jjaek %>
  </div>
</section>
