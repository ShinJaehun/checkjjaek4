<% content_for :title, t("unified_search.title") %>

<section class="mx-auto flex w-full max-w-3xl min-w-0 flex-col gap-6">
  <header class="rounded-[2rem] border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
    <h1 class="text-2xl font-semibold tracking-tight text-stone-900"><%= t("unified_search.title") %></h1>
    <%= form_with url: search_path, method: :get, class: "mt-5 space-y-2" do |form| %>
      <%= form.label :q, t("unified_search.query_label"), class: "text-sm font-medium text-stone-700" %>
      <%= hidden_field_tag :type, @type %>
      <%= hidden_field_tag :per_page, @per_page if @type == "all" %>
      <div class="flex flex-col gap-3 sm:flex-row">
        <%= form.search_field :q, value: @query, placeholder: t("unified_search.placeholder"),
                              class: "min-h-11 min-w-0 flex-1 rounded-xl border border-stone-300 bg-white px-4 py-2 text-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-900" %>
        <% unless @type == "all" %>
          <%= render "admin/shared/page_size", form: form, per_page: @per_page %>
        <% end %>
        <%= form.submit t("unified_search.submit"), class: "ui-button ui-button-primary shrink-0" %>
      </div>
    <% end %>
  </header>

  <nav aria-label="<%= t("unified_search.types_label") %>" class="flex flex-wrap gap-2">
    <% [ "all", *SearchesController::RESULT_TYPES ].each do |type| %>
      <%= link_to t("unified_search.types.#{type}"), search_path(search_results_params(type: type)),
                  aria: { current: ("page" if @type == type) },
                  class: "ui-button #{@type == type ? 'ui-button-primary' : 'ui-button-secondary'}" %>
    <% end %>
  </nav>

  <% if @query.blank? %>
    <p class="rounded-2xl border border-dashed border-stone-300 bg-white/70 p-6 text-sm text-stone-600"><%= t("unified_search.prompt") %></p>
  <% else %>
    <% @results.each do |type, records| %>
      <section aria-labelledby="search-<%= type %>-title" class="min-w-0">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 id="search-<%= type %>-title" class="text-xl font-semibold text-stone-900"><%= t("unified_search.types.#{type}") %></h2>
          <% if @type == "all" && records.any? %>
            <%= link_to t("unified_search.view_all", type: t("unified_search.types.#{type}")),
                        search_path(search_results_params(type: type)), class: "ui-button ui-button-secondary" %>
          <% end %>
        </div>
        <% if type == "groups" %>
          <p class="mt-3 text-sm text-stone-500"><%= t("unified_search.group_access_notice") %></p>
        <% end %>

        <% if records.any? %>
          <div class="mt-4 space-y-4">
            <%= render partial: "searches/#{type == 'book_jjaeks' ? 'jjaek' : type.singularize}",
                       collection: records, as: :result %>
          </div>
        <% else %>
          <p class="mt-5 text-sm text-stone-500"><%= t("unified_search.no_results", query: @query) %></p>
        <% end %>
      </section>
    <% end %>

    <% if @result_page %>
      <%= render "shared/pagination", page: @result_page, query_params: search_results_params %>
    <% end %>
  <% end %>
</section>
