<article class="rounded-[2rem] border border-stone-200 bg-white p-5 shadow-sm">
  <%= user_avatar_link(result, image_class: "h-10 w-10 shrink-0 rounded-full object-cover", text_class: "break-words font-medium text-stone-900") %>
  <% if result.handle.present? %>
    <p class="mt-1 break-all text-sm text-stone-500">@<%= result.handle %></p>
  <% end %>
  <p class="mt-2 text-sm text-stone-500"><%= t("users.profile.stats", followers: @search_follower_counts.fetch(result.id, 0), following: @search_following_counts.fetch(result.id, 0)) %></p>
  <% relationships = search_user_relationship_labels(result) %>
  <% if relationships.any? %>
    <div class="mt-3 flex flex-wrap gap-2" data-search-user-relationships>
      <% relationships.each do |label| %>
        <span class="rounded-full border border-stone-200 bg-stone-100 px-2.5 py-1 text-xs font-medium text-stone-700"><%= label %></span>
      <% end %>
    </div>
  <% end %>
</article>
