<section class="mx-auto flex w-full max-w-4xl flex-col gap-6">
  <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm">
    <p class="text-xs font-semibold uppercase tracking-wider text-amber-700"><%= t("groups.types.#{@group.group_type}") %></p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-stone-900"><%= t("groups.members.management_title") %></h1>
    <p class="mt-2 text-sm text-stone-600"><%= @group.name %> · <%= t("groups.lifecycle_statuses.#{@group.lifecycle_status}") %></p>
  </section>

  <section class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-semibold text-stone-900"><%= t("groups.members.active_title") %></h2>
    <div id="current-members" class="mt-4 divide-y divide-stone-100">
      <% @active_memberships.each do |membership| %>
        <div class="py-3">
          <div class="flex items-center justify-between gap-4">
            <div>
              <span class="text-sm font-medium text-stone-800"><%= membership.user.name %></span>
              <span class="ml-2 text-xs text-stone-500"><%= t(membership.user_id == @group.group_admin_id ? "group_memberships.statuses.group_admin" : "groups.members.active_title") %></span>
              <% if membership.activity_suspended? %>
                <span class="ml-2 rounded-full bg-red-50 px-2 py-1 text-xs font-medium text-red-700"><%= t("group_memberships.moderation.statuses.activity_suspended") %></span>
              <% end %>
            </div>
            <% if policy(membership).remove? %>
              <%= button_to t("group_memberships.actions.remove"),
                            remove_group_group_membership_path(@group, membership),
                            method: :delete,
                            class: "rounded-full border border-red-200 px-3 py-1.5 text-sm font-medium text-red-700" %>
            <% end %>
          </div>
          <%= render "group_members/activity_moderation",
                     membership:,
                     current_suspension: @current_activity_suspensions_by_membership_id[membership.id] %>
          <%= render "group_members/ban_form", membership: %>
        </div>
      <% end %>
    </div>
  </section>

  <% if @group.approval_group? %>
    <section class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold text-stone-900"><%= t("groups.pending.title") %></h2>
      <% if @pending_memberships.any? %>
        <div class="mt-4 divide-y divide-stone-100">
          <% @pending_memberships.each do |membership| %>
            <div class="flex items-center justify-between gap-4 py-3">
              <span class="text-sm font-medium text-stone-800"><%= membership.user.name %></span>
              <div class="flex gap-2">
                <% if policy(membership).approve? %>
                  <%= button_to t("group_memberships.actions.approve"),
                                group_group_membership_path(@group, membership),
                                method: :patch,
                                class: "rounded-full bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
                <% end %>
                <% if policy(membership).reject? %>
                  <%= button_to t("group_memberships.actions.reject"),
                                reject_group_group_membership_path(@group, membership),
                                method: :delete,
                                class: "rounded-full border border-red-200 px-4 py-2 text-sm font-medium text-red-700" %>
                <% end %>
              </div>
            </div>
            <%= render "group_members/ban_form", membership: %>
          <% end %>
        </div>
      <% else %>
        <p class="mt-4 text-sm text-stone-500"><%= t("groups.pending.empty") %></p>
      <% end %>
    </section>
  <% end %>

  <% if @group.private_group? %>
    <section class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold text-stone-900"><%= t("groups.invitations.invite_title") %></h2>
      <% if @can_invite %>
        <% if @invite_candidates.any? %>
          <%= form_with url: invite_group_group_memberships_path(@group), class: "mt-4 flex flex-wrap items-end gap-3" do |form| %>
            <div class="min-w-64 flex-1">
              <%= form.label :user_id, t("groups.invitations.user"), class: "mb-2 block text-sm font-medium text-stone-700" %>
              <%= form.select :user_id, @invite_candidates.map { |user| [user.name, user.id] }, {}, class: "w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm" %>
            </div>
            <%= form.submit t("group_memberships.actions.invite"), class: "rounded-full bg-stone-900 px-4 py-2.5 text-sm font-medium text-white" %>
          <% end %>
        <% else %>
          <p class="mt-4 text-sm text-stone-500"><%= t("groups.invitations.empty_candidates") %></p>
        <% end %>
      <% end %>

      <% if @sent_invitations.any? %>
        <h3 class="mt-6 text-sm font-semibold text-stone-900"><%= t("groups.invitations.sent_title") %></h3>
        <div class="mt-2 divide-y divide-stone-100">
          <% @sent_invitations.each do |membership| %>
            <div class="flex items-center justify-between gap-4 py-3">
              <span class="text-sm font-medium text-stone-800"><%= membership.user.name %></span>
              <% if @group.active? && policy(membership).revoke? %>
                <%= button_to t("group_memberships.actions.revoke"),
                              revoke_group_group_membership_path(@group, membership),
                              method: :delete,
                              class: "rounded-full border border-red-200 px-3 py-1.5 text-sm font-medium text-red-700" %>
              <% end %>
            </div>
            <%= render "group_members/ban_form", membership: %>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>

  <section class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-semibold text-stone-900"><%= t("group_member_bans.title") %></h2>
    <% if @group_member_bans.any? %>
      <div class="mt-4 divide-y divide-stone-100">
        <% @group_member_bans.each do |ban| %>
          <% ban_action = @ban_actions_by_id[ban.id] %>
          <div class="py-4">
            <div class="flex items-center justify-between gap-4">
              <div>
                <span class="text-sm font-medium text-stone-800"><%= ban.user.name %></span>
                <span class="ml-2 rounded-full bg-red-50 px-2 py-1 text-xs font-medium text-red-700"><%= t("group_member_bans.status") %></span>
              </div>
            </div>
            <% if ban_action.present? %>
              <p class="mt-2 whitespace-pre-wrap text-sm text-stone-600"><%= t("group_memberships.moderation.public_reason") %>: <%= ban_action.public_reason %></p>
            <% end %>
            <% if policy(ban).destroy? %>
              <%= form_with url: group_group_member_ban_path(@group, ban), method: :delete, scope: :moderation_action, class: "mt-3 space-y-3 rounded-2xl bg-stone-50 p-4" do |form| %>
                <%= form.label :public_reason, t("group_memberships.moderation.public_reason"), class: "block text-sm font-medium text-stone-700" %>
                <%= form.text_area :public_reason, rows: 2, required: true, class: "w-full rounded-xl border border-stone-300 bg-white px-3 py-2 text-sm" %>
                <%= form.label :internal_note, t("group_memberships.moderation.internal_note"), class: "block text-sm font-medium text-stone-700" %>
                <%= form.text_area :internal_note, rows: 2, class: "w-full rounded-xl border border-stone-300 bg-white px-3 py-2 text-sm" %>
                <%= form.submit t("group_member_bans.actions.destroy"), class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="mt-4 text-sm text-stone-500"><%= t("group_member_bans.empty") %></p>
    <% end %>
  </section>

  <% if policy(@group).transfer_admin? %>
    <section class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold text-stone-900"><%= t("groups.admin_transfer.title") %></h2>
      <p class="mt-2 text-sm text-stone-600"><%= t("groups.admin_transfer.current", name: @group.group_admin.name) %></p>
      <% if @admin_transfer_candidates.any? %>
        <%= form_with url: transfer_admin_group_path(@group), method: :patch, class: "mt-5 space-y-4", data: { turbo_confirm: t("groups.admin_transfer.confirmation") } do %>
          <div>
            <%= label_tag :new_admin_id, t("groups.admin_transfer.target"), class: "mb-2 block text-sm font-medium text-stone-700" %>
            <%= select_tag :new_admin_id, options_from_collection_for_select(@admin_transfer_candidates, :id, :name), class: "w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm" %>
          </div>
          <%= submit_tag t("groups.admin_transfer.submit"), class: "rounded-full bg-stone-900 px-5 py-2.5 text-sm font-medium text-white" %>
        <% end %>
      <% else %>
        <p class="mt-4 text-sm text-stone-500"><%= t("groups.admin_transfer.no_candidates") %></p>
      <% end %>
    </section>
  <% end %>

  <%= render "group_members/membership_history", membership_history: @membership_history %>

  <%= link_to t("groups.members.back"), group_path(@group), class: "text-sm font-medium text-stone-600" %>
</section>
