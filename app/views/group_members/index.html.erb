<section class="mx-auto flex w-full max-w-4xl flex-col gap-6">
  <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-5">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-amber-700"><%= t("groups.members.management_title") %></p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-stone-900"><%= @group.name %></h1>
        <div class="mt-3 flex flex-wrap gap-2">
          <span class="rounded-full px-3 py-1 text-xs font-medium <%= group_type_badge_classes(@group) %>" data-group-type="<%= @group.group_type %>"><%= group_type_label(@group) %></span>
          <span class="rounded-full px-3 py-1 text-xs font-medium <%= group_status_badge_classes(@group) %>" data-field="current-status">
            <%= group_current_status_label(@group) %>
          </span>
        </div>
      </div>
      <% if @admin_navigation_context %>
        <%= link_to t("admin.groups.actions.back"),
                    admin_groups_path,
                    class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
      <% else %>
        <%= link_to t("groups.members.back"),
                    group_path(@group),
                    class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
      <% end %>
    </div>
    <div class="mt-6 border-t border-stone-100 pt-4">
      <p class="text-xs font-medium text-stone-500"><%= t("groups.members.current_admin") %></p>
      <div class="mt-2 flex items-center gap-3">
        <%= user_avatar_image(@group.group_admin, size: 128, alt: @group.group_admin.name, class: "h-10 w-10 rounded-full object-cover") %>
        <span class="text-sm font-medium text-stone-800"><%= @group.group_admin.name %></span>
        <span class="rounded-full px-2 py-1 text-xs font-medium <%= group_membership_role_badge_classes(:admin) %>" data-membership-role="admin"><%= group_membership_role_label(:admin) %></span>
      </div>
    </div>
  </section>

  <section class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-semibold text-stone-900"><%= t("groups.members.management_title") %></h2>
    <div id="current-members" class="mt-4 divide-y divide-stone-100">
      <% @active_memberships.each do |membership| %>
        <% membership_policy = policy(membership) %>
        <% current_suspension = @current_activity_suspensions_by_membership_id[membership.id] %>
        <div id="<%= dom_id(membership) %>" class="py-3">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex min-w-0 items-center gap-3">
              <%= user_avatar_image(membership.user, size: 128, alt: membership.user.name, class: "h-10 w-10 rounded-full object-cover") %>
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-sm font-medium text-stone-800"><%= membership.user.name %></span>
                <% membership_role = membership.user_id == @group.group_admin_id ? :admin : :member %>
                <span class="rounded-full px-2 py-1 text-xs font-medium <%= group_membership_role_badge_classes(membership_role) %>" data-membership-role="<%= membership_role %>"><%= group_membership_role_label(membership_role) %></span>
                <span class="rounded-full px-2 py-1 text-xs font-medium <%= group_membership_activity_status_badge_classes(membership.moderation_status) %>" data-activity-status="<%= membership.moderation_status %>"><%= group_membership_activity_status_label(membership.moderation_status) %></span>
              </div>
            </div>

            <% if membership.user_id == @group.group_admin_id %>
              <% if @group.group_admin?(current_user) && policy(@group).transfer_admin? %>
                <%= link_to t("groups.admin_transfer.submit"),
                            new_group_admin_transfer_path(@group),
                            class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
              <% end %>
            <% elsif membership_policy.suspend_activity? || membership_policy.restore_activity? || membership_policy.remove? || membership_policy.ban_from_group? %>
              <div id="member-management-<%= membership.id %>" class="flex flex-wrap items-center gap-2" data-member-management>
                <%= render "group_members/activity_moderation", membership:, membership_policy: %>

                <% if membership_policy.remove? %>
                  <%= button_to t("group_memberships.actions.remove"),
                                remove_group_group_membership_path(@group, membership),
                                method: :delete,
                                class: "rounded-full border border-red-200 px-4 py-2 text-sm font-medium text-red-700",
                                data: { member_action: "remove" } %>
                <% end %>

                <%= render "group_members/ban_action", membership:, membership_policy: %>
              </div>
            <% end %>
          </div>

          <% if current_suspension.present? %>
            <p class="mt-2 text-sm text-stone-600 sm:pl-[3.25rem]">
              <span class="font-medium text-stone-800"><%= t("group_memberships.moderation.public_reason") %>:</span>
              <span class="whitespace-pre-wrap"><%= current_suspension.public_reason %></span>
            </p>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>

  <% if @pending_memberships.any? %>
    <section class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold text-stone-900"><%= t("groups.pending.title") %></h2>
      <div class="mt-4 divide-y divide-stone-100">
        <% @pending_memberships.each do |membership| %>
          <div class="flex flex-wrap items-center justify-between gap-3 py-3">
            <div class="flex items-center gap-3">
              <%= user_avatar_image(membership.user, size: 128, alt: membership.user.name, class: "h-10 w-10 rounded-full object-cover") %>
              <span class="text-sm font-medium text-stone-800"><%= membership.user.name %></span>
              <span class="rounded-full px-2 py-1 text-xs font-medium <%= group_membership_status_badge_classes(membership.status) %>" data-membership-status="<%= membership.status %>"><%= group_membership_status_label(membership.status) %></span>
            </div>
            <div class="flex flex-wrap gap-2">
              <% if policy(membership).approve? %>
                <%= button_to t("group_memberships.actions.approve"),
                              group_group_membership_path(@group, membership),
                              method: :patch,
                              class: "rounded-full bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
              <% end %>
              <% if policy(membership).reject? %>
                <%= button_to t("group_memberships.actions.reject"),
                              reject_group_group_membership_path(@group, membership),
                              method: :delete,
                              class: "rounded-full border border-red-200 px-4 py-2 text-sm font-medium text-red-700" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @group.private_group? %>
    <section class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold text-stone-900"><%= t("groups.invitations.sent_title") %></h2>

      <% if @sent_invitations.any? %>
        <div class="mt-2 divide-y divide-stone-100">
          <% @sent_invitations.each do |membership| %>
            <div class="flex items-center justify-between gap-4 py-3">
              <div class="flex items-center gap-3">
                <%= user_avatar_image(membership.user, size: 128, alt: membership.user.name, class: "h-10 w-10 rounded-full object-cover") %>
                <span class="text-sm font-medium text-stone-800"><%= membership.user.name %></span>
                <span class="rounded-full px-2 py-1 text-xs font-medium <%= group_membership_status_badge_classes(membership.status) %>" data-membership-status="<%= membership.status %>"><%= group_membership_status_label(membership.status) %></span>
              </div>
              <% if @group.active? && policy(membership).revoke? %>
                <%= button_to t("group_memberships.actions.revoke"),
                              revoke_group_group_membership_path(@group, membership),
                              method: :delete,
                              class: "rounded-full border border-red-200 px-3 py-1.5 text-sm font-medium text-red-700" %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="mt-4 text-sm text-stone-500"><%= t("groups.invitations.sent_empty") %></p>
      <% end %>
    </section>
  <% end %>

  <% if @group_member_bans.any? %>
    <section class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold text-stone-900"><%= t("group_member_bans.title") %></h2>
      <div class="mt-4 divide-y divide-stone-100">
        <% @group_member_bans.each do |ban| %>
          <% ban_action = @ban_actions_by_id[ban.id] %>
          <div id="<%= dom_id(ban) %>" class="py-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div class="flex min-w-0 items-center gap-3">
                <%= user_avatar_image(ban.user, size: 128, alt: ban.user.name, class: "h-10 w-10 rounded-full object-cover") %>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-sm font-medium text-stone-800"><%= ban.user.name %></span>
                  <span class="rounded-full px-2 py-1 text-xs font-medium <%= group_member_ban_status_badge_classes %>" data-restriction-status="banned"><%= group_member_ban_status_label %></span>
                </div>
              </div>
              <% if policy(ban).unban? %>
                <%= link_to t("group_member_bans.moderation.unban.submit"),
                            new_group_group_member_ban_restoration_path(@group, ban),
                            class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700",
                            data: { member_action: "unban_from_group" } %>
              <% end %>
            </div>
            <% if ban_action.present? %>
              <p class="mt-2 pl-[3.25rem] whitespace-pre-wrap text-sm text-stone-600"><%= t("group_memberships.moderation.public_reason") %>: <%= ban_action.public_reason %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <%= render "group_members/membership_history", membership_history: @membership_history %>

</section>
