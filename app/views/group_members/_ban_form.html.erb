<% membership_policy = local_assigns[:membership_policy] || policy(membership) %>

<% if membership_policy.ban_from_group? %>
  <div class="rounded-2xl border border-stone-200 p-4" data-member-action="ban_from_group">
    <h4 class="text-sm font-semibold text-stone-800"><%= t("group_memberships.management.actions.ban_from_group") %></h4>
    <p class="mt-3 text-sm text-stone-600"><%= t("group_memberships.management.descriptions.ban_from_group") %></p>
    <%= form_with url: group_group_member_bans_path(@group), scope: :moderation_action, class: "mt-3 space-y-3" do |form| %>
      <%= hidden_field_tag :membership_id, membership.id %>
      <%= form.label :public_reason, t("group_memberships.moderation.public_reason"), class: "block text-sm font-medium text-stone-700" %>
      <%= form.text_area :public_reason, rows: 2, required: true, class: "w-full rounded-xl border border-stone-300 bg-white px-3 py-2 text-sm" %>
      <%= form.label :internal_note, t("group_memberships.moderation.internal_note"), class: "block text-sm font-medium text-stone-700" %>
      <%= form.text_area :internal_note, rows: 2, class: "w-full rounded-xl border border-stone-300 bg-white px-3 py-2 text-sm" %>
      <p class="text-xs text-stone-500"><%= t("group_memberships.moderation.internal_note_hint") %></p>
      <%= form.submit t("group_member_bans.actions.create"), class: "rounded-full bg-red-700 px-4 py-2 text-sm font-medium text-white" %>
    <% end %>
  </div>
<% end %>
