<article class="rounded-3xl border border-stone-200 bg-white p-5 shadow-sm" data-restricted-requote>
  <div class="flex items-start justify-between gap-3">
    <div class="flex min-w-0 items-start gap-3">
      <% if policy(source).view_restricted_requote_details?(requote) %>
        <%= user_avatar_image(requote.user, size: 128, alt: requote.user.name, class: "h-10 w-10 shrink-0 rounded-full object-cover") %>
        <div class="min-w-0">
          <div class="text-sm text-stone-600">
            <%= t("requotes.restricted.context_html",
                  author_name: link_to(requote.user.name, user_path(requote.user), class: "font-semibold text-stone-900 hover:text-stone-700"),
                  source_author_name: link_to(source.user.name, user_path(source.user), class: "font-semibold text-stone-900 hover:text-stone-700"),
                  source_kind: t(source.book.present? ? "jjaeks.contexts.quoted_book" : "jjaeks.contexts.quoted_general"),
                  group_name: link_to(requote.group.name, group_path(requote.group), class: "font-semibold text-stone-900 hover:text-stone-700")) %>
          </div>
          <div class="mt-1 text-xs text-stone-500">
            <%= t("jjaeks.meta.created_at", time: l(requote.created_at, format: :short)) %>
          </div>
        </div>
      <% else %>
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-stone-100 text-stone-500" aria-hidden="true">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="12" cy="8" r="4" />
            <path d="M4 21a8 8 0 0 1 16 0" />
          </svg>
        </span>
      <% end %>
    </div>
  </div>
  <p class="mt-4 text-sm leading-6 text-stone-600"><%= t("requotes.restricted.notice") %></p>
</article>
