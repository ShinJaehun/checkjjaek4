<section class="mx-auto w-full max-w-2xl space-y-6">
  <header class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm">
    <h1 class="text-3xl font-semibold tracking-tight text-stone-900"><%= t("settings.title") %></h1>
    <p class="mt-2 text-sm text-stone-600"><%= t("settings.description") %></p>
  </header>

  <section id="profile-settings" class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-semibold text-stone-900"><%= t("settings.profile.title") %></h2>
    <p class="mt-2 text-sm text-stone-500"><%= t("settings.profile.description") %></p>

    <%= form_with model: @user, url: account_settings_path, method: :patch, class: "mt-6 space-y-5" do |form| %>
      <% if @user.errors.any? %>
        <p class="text-sm text-red-700"><%= @user.errors.full_messages.to_sentence %></p>
      <% end %>

      <div>
        <%= form.label :name, t("settings.profile.name"), class: "mb-2 block text-sm font-medium text-stone-800" %>
        <%= form.text_field :name, required: true, class: "w-full rounded-2xl border border-stone-300 px-4 py-3 text-sm" %>
      </div>

      <div>
        <% if @user.handle_in_database.present? %>
          <p class="mb-2 text-sm font-medium text-stone-800"><%= t("settings.profile.handle") %></p>
          <p class="text-sm text-stone-700"><%= @user.handle_in_database %></p>
        <% else %>
          <%= form.label :handle, t("settings.profile.handle"), class: "mb-2 block text-sm font-medium text-stone-800" %>
          <%= form.text_field :handle, minlength: 3, maxlength: 30, autocomplete: "username", class: "w-full rounded-2xl border border-stone-300 px-4 py-3 text-sm" %>
          <p class="mt-2 text-xs text-stone-500"><%= t("settings.profile.handle_hint") %></p>
          <p class="mt-2 text-xs text-stone-500"><%= t("user_handle.guidance") %></p>
        <% end %>
      </div>

      <%= form.submit t("settings.actions.save"), class: "ui-button ui-button-primary" %>
    <% end %>
  </section>

  <section id="avatar-settings" class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm" data-controller="avatar-preview" data-avatar-preview-max-size-value="<%= User::MAX_AVATAR_SIZE %>" data-action="turbo:before-cache@document->avatar-preview#reset">
    <h2 class="text-xl font-semibold text-stone-900"><%= t("settings.avatar.title") %></h2>
    <p class="mt-2 text-sm text-stone-500"><%= t("settings.avatar.description") %></p>
    <div class="mt-5">
      <%= user_avatar_image(@user, size: 128, alt: @user.name, class: "h-24 w-24 rounded-full object-cover", data: { avatar_preview_target: "image", action: "error->avatar-preview#imageError" }) %>
    </div>
    <p class="mt-2 hidden text-xs text-stone-600" data-avatar-preview-target="status"><%= t("settings.avatar.preview_pending") %></p>
    <p class="mt-2 hidden text-xs text-red-700" data-avatar-preview-target="error"><%= t("settings.avatar.preview_invalid") %></p>

    <% if @avatar_errors.present? %>
      <p class="mt-4 text-sm text-red-700"><%= @avatar_errors.to_sentence %></p>
    <% end %>

    <%= form_with model: @user, url: avatar_account_settings_path, method: :patch, multipart: true, class: "mt-5 space-y-4" do |form| %>
      <div>
        <%= form.label :avatar, t("settings.avatar.upload"), class: "mb-2 block text-sm font-medium text-stone-800" %>
        <%= form.file_field :avatar, accept: "image/jpeg,image/png,image/webp", class: "block w-full text-sm text-stone-700", data: { avatar_preview_target: "input", action: "change->avatar-preview#change cancel->avatar-preview#cancel" } %>
      </div>
      <%= form.submit t("settings.avatar.save"), class: "ui-button ui-button-primary" %>
    <% end %>

    <% if @user.avatar.attached? %>
      <%= button_to t("settings.avatar.remove"), avatar_account_settings_path, method: :delete, class: "ui-button ui-button-secondary mt-4" %>
    <% end %>
  </section>

  <section id="interaction-preferences" class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-semibold text-stone-900"><%= t("settings.interactions.title") %></h2>
    <p class="mt-2 text-sm text-stone-500"><%= t("settings.interactions.description") %></p>

    <%= form_with model: @user, url: account_settings_path, method: :patch, class: "mt-6 space-y-5" do |form| %>
      <% %i[accepts_book_friend_requests accepts_group_invitations allows_new_followers].each do |setting| %>
        <div class="flex items-start gap-3">
          <%= form.check_box setting, class: "mt-1 rounded border-stone-300 text-stone-900" %>
          <div>
            <%= form.label setting, t("settings.interactions.#{setting}.label"), class: "text-sm font-medium text-stone-800" %>
            <p class="mt-1 text-xs text-stone-500"><%= t("settings.interactions.#{setting}.description") %></p>
          </div>
        </div>
      <% end %>

      <%= form.submit t("settings.actions.save"), class: "ui-button ui-button-primary" %>
    <% end %>
  </section>

  <section id="password-settings" class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-semibold text-stone-900"><%= t("settings.password.title") %></h2>
    <p class="mt-2 text-sm text-stone-500"><%= t("settings.password.description") %></p>

    <% if @password_errors.present? %>
      <p role="alert" class="mt-4 text-sm text-red-700"><%= @password_errors.to_sentence %></p>
    <% end %>

    <%= form_with model: @user, url: password_account_settings_path, method: :patch, class: "mt-6 space-y-5" do |form| %>
      <div>
        <%= form.label :current_password, t("settings.password.current_password"), class: "mb-2 block text-sm font-medium text-stone-800" %>
        <%= form.password_field :current_password, autocomplete: "current-password", required: true, class: "w-full rounded-2xl border border-stone-300 px-4 py-3 text-sm" %>
      </div>

      <div>
        <%= form.label :password, t("settings.password.new_password"), class: "mb-2 block text-sm font-medium text-stone-800" %>
        <%= form.password_field :password, autocomplete: "new-password", required: true, class: "w-full rounded-2xl border border-stone-300 px-4 py-3 text-sm" %>
      </div>

      <div>
        <%= form.label :password_confirmation, t("settings.password.password_confirmation"), class: "mb-2 block text-sm font-medium text-stone-800" %>
        <%= form.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "w-full rounded-2xl border border-stone-300 px-4 py-3 text-sm" %>
      </div>

      <%= form.submit t("settings.password.title"), class: "ui-button ui-button-primary" %>
    <% end %>
  </section>

  <section id="account-management" class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
    <h2 class="text-xl font-semibold text-stone-900"><%= t("settings.account.title") %></h2>
    <p class="mt-2 text-sm text-stone-500"><%= t("settings.account.description") %></p>
    <%= link_to t("account_withdrawals.title"), account_withdrawal_path, class: "ui-button ui-button-danger mt-5" %>
  </section>
</section>
