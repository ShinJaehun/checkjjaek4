<% friendship = record %>
<% user = direction == :received ? friendship.requester : friendship.addressee %>
<article class="flex min-w-0 items-center gap-2 rounded-2xl border border-stone-200 bg-white p-4 shadow-sm">
  <%= render "relationships/user_identity", user: user %>
  <div class="ml-auto flex shrink-0 flex-nowrap items-center gap-1">
    <% if direction == :received %>
      <%= button_to t("users.actions.accept_book_friend"),
                    user_book_friendship_path(friendship.requester),
                    method: :patch,
                    params: relationship_action_params,
                    class: "ui-button ui-button-primary whitespace-nowrap px-2 text-xs" %>
      <%= button_to t("users.actions.reject_book_friend_request"),
                    user_book_friendship_path(friendship.requester),
                    method: :delete,
                    params: relationship_action_params,
                    class: "ui-button ui-button-secondary whitespace-nowrap px-2 text-xs" %>
    <% else %>
      <%= button_to t("users.actions.cancel_book_friend_request"),
                    user_book_friendship_path(friendship.addressee),
                    method: :delete,
                    params: relationship_action_params,
                    class: "ui-button ui-button-secondary whitespace-nowrap px-2 text-xs" %>
    <% end %>
  </div>
</article>
