<% followee = record %>
<article class="rounded-[2rem] border border-stone-200 bg-white p-5 shadow-sm">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <%= user_avatar_link(followee, image_class: "h-10 w-10 shrink-0 rounded-full object-cover", text_class: "font-medium text-stone-900") %>
    <%= button_to t("users.actions.unfollow"),
                  user_follow_path(followee),
                  method: :delete,
                  params: { return_to: "relationships" },
                  class: "ui-button ui-button-secondary" %>
  </div>
</article>
