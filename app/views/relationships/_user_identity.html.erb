<%= link_to user_path(user), title: user.name, class: "flex min-w-0 flex-1 items-center gap-2" do %>
  <%= user_avatar_image(user, size: 128, alt: user.name, class: "h-10 w-10 shrink-0 rounded-full object-cover") %>
  <div class="min-w-0 flex-1 space-y-1">
    <p class="min-w-0 truncate font-medium text-stone-900"><%= user.name %></p>
    <% if user.handle.present? %>
      <p class="truncate text-xs text-stone-500">@<%= user.handle %></p>
    <% end %>
  </div>
<% end %>
