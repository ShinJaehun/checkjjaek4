<section class="mx-auto flex w-full max-w-4xl flex-col gap-6">
  <section class="mx-auto w-full max-w-3xl rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
    <%= render "jjaeks/composer", jjaek: @jjaek %>
  </section>

  <section class="mx-auto w-full max-w-3xl space-y-4">
    <div>
      <h2 class="text-2xl font-semibold tracking-tight text-stone-900"><%= t("home.feed_title") %></h2>
    </div>

    <%= render "feeds/list", page: @feed_page, context: :home,
               next_url: @feed_next_url,
               empty_text: t("home.empty_feed") %>
  </section>
</section>
