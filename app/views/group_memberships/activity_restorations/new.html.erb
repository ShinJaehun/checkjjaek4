<section class="mx-auto w-full max-w-2xl rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
  <h1 class="text-2xl font-semibold text-stone-900"><%= t("group_memberships.moderation.restore.title") %></h1>
  <p class="mt-2 text-sm text-stone-600"><%= t("group_memberships.management.descriptions.restore_activity") %></p>

  <%= render "group_members/moderation_target_context",
             group: @group,
             user: @membership.user,
             membership: @membership,
             restricted: false %>

  <% if @current_activity_suspension.present? %>
    <section class="mt-6">
      <h2 class="text-lg font-semibold text-stone-900"><%= t("group_memberships.moderation.current_suspension") %></h2>
      <%= render "group_members/activity_moderation_history_entry", record: @current_activity_suspension, user: @membership.user %>
    </section>
  <% end %>

  <% if @error_message.present? %>
    <p class="mt-5 rounded-2xl bg-red-50 p-4 text-sm text-red-700"><%= @error_message %></p>
  <% end %>

  <%= render "form" %>
  <%= link_to t("group_memberships.moderation.cancel"), group_members_path(@group), class: "mt-5 inline-block text-sm font-medium text-stone-600 underline" %>
</section>
