<% if bookshelf_entry.present? %>
  <% can_move = local_assigns[:bookshelves]&.size.to_i > 1 %>
  <% dialog_title = t("books.show.manage_bookshelf") %>
  <div class="min-w-0" data-controller="book-modal" data-action="turbo:before-cache@document->book-modal#close">
    <button type="button" data-action="book-modal#open" aria-haspopup="dialog" aria-controls="book-move-dialog" class="ui-button ui-button-secondary shrink-0">
      <%= dialog_title %>
    </button>
    <dialog id="book-move-dialog" aria-labelledby="book-move-dialog-title" data-book-modal-target="dialog" data-action="close->book-modal#restore" class="m-auto max-h-[90dvh] w-[calc(100%_-_2rem)] max-w-lg overflow-y-auto rounded-3xl bg-white p-6 shadow-xl backdrop:bg-stone-900/40">
      <div class="mb-5 flex items-center justify-between gap-4">
        <h2 id="book-move-dialog-title" class="text-lg font-semibold text-stone-900"><%= dialog_title %></h2>
        <button type="button" data-action="book-modal#close" class="ui-button ui-button-secondary shrink-0"><%= t("bookshelves.actions.close") %></button>
      </div>
      <% if can_move %>
        <%= form_with url: move_bookshelf_entry_path(bookshelf_entry), method: :patch, class: "min-w-0 space-y-5" do %>
          <%= hidden_field_tag :return_to, "book" %>
          <%= hidden_field_tag :tab, "reading", id: nil %>
          <%= hidden_field_tag :book_return_to, @book_return_path if @book_return_path %>
          <%= hidden_field_tag :group_id, local_assigns[:group_id] if local_assigns[:group_id].present? %>

          <fieldset class="min-w-0 space-y-3">
            <legend class="text-sm font-medium text-stone-600"><%= t("bookshelf_entries.form.move_bookshelf") %></legend>
            <div class="flex flex-wrap gap-2">
              <% bookshelves.each do |bookshelf| %>
                <label class="ui-choice">
                  <%= radio_button_tag :bookshelf_id, bookshelf.id, bookshelf.id == bookshelf_entry.bookshelf_id, required: true, class: "shrink-0" %>
                  <span class="min-w-0 break-words"><%= bookshelf.name %></span>
                </label>
              <% end %>
            </div>
          </fieldset>
          <%= submit_tag t("bookshelf_entries.actions.move"), class: "ui-button ui-button-primary" %>
        <% end %>
      <% end %>
      <%= button_to t("bookshelf_entries.actions.remove"), bookshelf_entry_path(bookshelf_entry),
                    method: :delete,
                    params: { return_to: "book", group_id: local_assigns[:group_id], book_return_to: @book_return_path }.compact,
                    form: { class: ("mt-5 border-t border-stone-200 pt-4" if can_move), data: { turbo_confirm: bookshelf_removal_confirmation } },
                    class: "ui-button ui-button-secondary text-red-700" %>
    </dialog>
  </div>
<% else %>
  <div class="min-w-0 text-sm text-stone-500" data-controller="book-modal" data-action="turbo:before-cache@document->book-modal#close">
    <button type="button" data-action="book-modal#open" aria-haspopup="dialog" aria-controls="book-shelf-dialog" class="ui-button ui-button-primary">
      <%= t("bookshelf_entries.new.title") %>
    </button>
    <dialog id="book-shelf-dialog" aria-labelledby="book-shelf-dialog-title" data-book-modal-target="dialog" data-action="close->book-modal#restore" class="m-auto max-h-[90dvh] w-[calc(100%_-_2rem)] max-w-lg overflow-y-auto rounded-3xl bg-white p-6 shadow-xl backdrop:bg-stone-900/40">
      <div class="mb-5 flex items-center justify-between gap-4">
        <h2 id="book-shelf-dialog-title" class="text-lg font-semibold text-stone-900"><%= t("bookshelf_entries.new.title") %></h2>
        <button type="button" data-action="book-modal#close" class="ui-button ui-button-secondary shrink-0"><%= t("bookshelves.actions.close") %></button>
      </div>
      <%= form_with url: bookshelf_entries_path, method: :post, local: true, class: "min-w-0 space-y-5" do |form| %>
        <%= hidden_field_tag :return_to, @book_return_path if @book_return_path %>
        <%= hidden_field_tag :tab, "reading", id: nil %>
        <% if book.persisted? %>
          <%= hidden_field_tag :book_id, book.id %>
        <% else %>
          <%= hidden_field_tag :search_result_token, search_result_token %>
        <% end %>
        <%= hidden_field_tag :group_id, local_assigns[:group_id] if local_assigns[:group_id].present? %>

        <fieldset class="min-w-0 space-y-3">
          <legend class="text-sm font-medium text-stone-600"><%= t("bookshelf_entries.form.target_bookshelf") %></legend>
          <div class="flex flex-wrap gap-2">
            <% bookshelves.each_with_index do |bookshelf, index| %>
              <label class="ui-choice">
                <%= radio_button_tag "bookshelf_entry[bookshelf_id]", bookshelf.id, index.zero?, required: true, class: "shrink-0" %>
                <span class="min-w-0 break-words"><%= bookshelf.name %></span>
              </label>
            <% end %>
          </div>
        </fieldset>
        <%= form.submit t("bookshelf_entries.new.title"), class: "ui-button ui-button-primary" %>
      <% end %>
    </dialog>
  </div>
<% end %>
