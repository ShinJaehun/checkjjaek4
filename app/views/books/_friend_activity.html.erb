<article id="<%= dom_id(activity, :book_friend_activity) %>" class="rounded-3xl border border-amber-200 bg-amber-50/60 p-5 text-sm text-stone-700 shadow-sm" data-book-friend-activity>
  <div class="flex items-start gap-3">
    <%= link_to user_path(activity.user) do %>
      <%= user_avatar_image(activity.user, size: 128, alt: activity.user.name, class: "h-10 w-10 shrink-0 rounded-full object-cover") %>
    <% end %>
    <div class="min-w-0 flex-1">
      <p class="leading-6"><%= book_activity_card_message(activity, context: :book, sticker_definitions: @book_friend_sticker_definitions) %></p>
      <p class="mt-1 text-xs text-stone-500"><%= l(activity.created_at, format: :short) %></p>
    </div>
  </div>
</article>
