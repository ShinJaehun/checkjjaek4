<% select_destination = quoted_jjaek.blank? && @book_post_groups.any? %>
<% group_post = jjaek.group_id.present? && (quoted_jjaek.present? || select_destination) %>
<section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm"
         data-controller="<%= 'book-posting' if select_destination %>"
         data-book-posting-personal-label-value="<%= t('jjaeks.actions.publish_book') %>"
         data-book-posting-group-label-value="<%= t('jjaeks.actions.publish_group_book') %>"
         data-book-posting-group-prompt-value="<%= t('jjaeks.form.choose_posting_group') %>"
         data-book-posting-no-groups-value="<%= t('jjaeks.form.no_postable_groups') %>">
  <h2 data-book-posting-target="title" class="mb-3 text-xl font-semibold text-stone-900"><%= t(group_post ? "jjaeks.actions.publish_group_book" : "jjaeks.actions.publish_book") %></h2>
  <% if group_post && !select_destination %>
    <p class="mb-4 text-sm text-stone-600"><%= t("books.show.group_destination", name: jjaek.group.name) %></p>
  <% end %>
  <% if quoted_jjaek.present? %>
    <div class="rounded-2xl bg-stone-50 px-4 py-3 text-sm text-stone-600">
      <div class="font-medium text-stone-900"><%= t("books.show.requote_source", name: quoted_jjaek.user.name) %></div>
      <p class="mt-2 line-clamp-4 whitespace-pre-wrap"><%= quoted_jjaek.content %></p>
    </div>
  <% end %>

  <div class="<%= quoted_jjaek.present? ? 'mt-5' : nil %>">
    <% form_url = !select_destination && group_post ? group_jjaeks_path(jjaek.group) : jjaeks_path %>
    <%= form_with model: jjaek, url: form_url, class: "space-y-4" do |form| %>
      <%= hidden_field_tag :return_to, jjaek_navigation_params[:return_to] if jjaek_navigation_params[:return_to] %>
      <%= form.hidden_field :book_id, value: book.id %>
      <%= form.hidden_field :quoted_jjaek_id, value: quoted_jjaek&.id %>

      <% if select_destination %>
        <div class="space-y-2">
          <%= label_tag :book_post_destination, t("jjaeks.form.posting_location"), class: "text-sm font-medium text-stone-700" %>
          <%= select_tag :book_post_destination,
                         options_for_select([[t("jjaeks.actions.publish_book"), "personal"], [t("jjaeks.actions.publish_group_book"), "group"]], group_post ? "group" : "personal"),
                         data: { book_posting_target: "location", action: "change->book-posting#change" },
                         class: "w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm" %>
        </div>

        <div data-book-posting-target="group" <%= 'hidden' unless group_post %> class="space-y-2">
          <%= form.label :group_id, t("jjaeks.form.posting_group"), class: "text-sm font-medium text-stone-700" %>
          <% group_options = @book_post_groups.map do |group|
               [group.name, group.id, { "data-destination-message" => t("books.show.group_destination", name: group.name) }]
             end %>
          <%= form.select :group_id,
                          options_for_select(group_options, jjaek.group_id),
                          { include_blank: t("jjaeks.form.choose_posting_group") },
                          disabled: !group_post, required: group_post,
                          data: { book_posting_target: "groupSelect", action: "change->book-posting#change" },
                          class: "w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm" %>
          <p data-book-posting-target="groupMessage" aria-live="polite" class="text-sm text-stone-600"><%= group_post ? t("books.show.group_destination", name: jjaek.group.name) : t("jjaeks.form.choose_posting_group") %></p>
        </div>
      <% end %>

      <% if select_destination || !group_post %>
        <div data-book-posting-target="personal" <%= 'hidden' if group_post %> class="space-y-2">
          <%= form.label :visibility, t("jjaeks.form.visibility"), class: "text-sm font-medium text-stone-700" %>
          <%= form.select :visibility,
                          Jjaek.visibilities.keys.map { |visibility| [t("jjaeks.visibility.#{visibility}"), visibility] },
                          {},
                          disabled: group_post, data: { book_posting_target: "visibility" },
                          class: "w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm shadow-sm focus:border-stone-500 focus:outline-none" %>
        </div>
      <% end %>

      <%= render "shared/content_field", form: form, label_key: "jjaeks.form.book_jjaek_content", rows: 8 %>

      <%= form.submit t(group_post ? "jjaeks.actions.publish_group_book" : "jjaeks.actions.publish_book"), data: { book_posting_target: "submit" }, class: "rounded-full bg-stone-900 px-4 py-2 text-sm font-medium text-stone-50 disabled:opacity-50" %>
    <% end %>
  </div>
</section>
