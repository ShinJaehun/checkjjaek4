<% submit_label = t(@group_book_post ? "jjaeks.actions.publish_group_book" : "jjaeks.actions.publish_book") %>
<% posting_destination = @group_book_post ? "group" : "personal" %>
<section class="<%= local_assigns[:modal] ? 'p-6' : 'rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm' %>"
         data-controller="<%= 'book-posting' if @select_book_post_destination %>"
         data-book-posting-personal-label-value="<%= t('jjaeks.actions.publish_book') %>"
         data-book-posting-group-label-value="<%= t('jjaeks.actions.publish_group_book') %>"
         data-book-posting-group-prompt-value="<%= t('jjaeks.form.choose_posting_group') %>"
         data-book-posting-no-groups-value="<%= t('jjaeks.form.no_postable_groups') %>">
  <% unless local_assigns[:modal] %>
    <h2 data-book-posting-target="title" class="mb-3 text-xl font-semibold text-stone-900"><%= submit_label %></h2>
  <% end %>
  <% if @group_book_post && !@select_book_post_destination %>
    <p class="mb-4 text-sm text-stone-600"><%= t("books.show.group_destination", name: jjaek.group.name) %></p>
  <% end %>
  <% if quoted_jjaek.present? %>
    <div class="rounded-2xl bg-stone-50 px-4 py-3 text-sm text-stone-600">
      <div class="font-medium text-stone-900"><%= t("books.show.requote_source", name: quoted_jjaek.user.name) %></div>
      <p class="mt-2 line-clamp-4 whitespace-pre-wrap"><%= quoted_jjaek.content %></p>
    </div>
  <% end %>

  <div class="<%= quoted_jjaek.present? ? 'mt-5' : nil %>">
    <%= form_with model: jjaek, url: @book_post_form_path, class: "space-y-4" do |form| %>
      <%= hidden_field_tag :return_to, jjaek_navigation_params[:return_to] if jjaek_navigation_params[:return_to] %>
      <%= form.hidden_field :book_id, value: book.id %>
      <%= form.hidden_field :quoted_jjaek_id, value: quoted_jjaek&.id %>

      <% if @select_book_post_destination %>
        <fieldset>
          <legend class="mb-2 text-sm font-medium text-stone-700"><%= t("jjaeks.form.posting_location") %></legend>
          <div class="grid grid-cols-2 gap-3">
            <% { "personal" => "publish_book", "group" => "publish_group_book" }.each do |destination, label| %>
              <label class="<%= book_posting_card_classes %>">
                <%= radio_button_tag :book_post_destination, destination, destination == posting_destination,
                                     data: { book_posting_target: "location", action: "change->book-posting#change" }, class: "sr-only" %>
                <%= book_posting_icon(destination) %>
                <span><%= t("jjaeks.actions.#{label}") %></span>
              </label>
            <% end %>
          </div>
        </fieldset>

        <div data-book-posting-target="group" <%= 'hidden' unless @group_book_post %> class="space-y-2">
          <%= form.label :group_id, t("jjaeks.form.posting_group"), class: "text-sm font-medium text-stone-700" %>
          <%= form.select :group_id,
                          options_for_select(book_post_group_options(@book_post_groups), jjaek.group_id),
                          { include_blank: t("jjaeks.form.choose_posting_group") },
                          disabled: !@group_book_post, required: @group_book_post,
                          data: { book_posting_target: "groupSelect", action: "change->book-posting#change" },
                          class: "w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm" %>
          <p data-book-posting-target="groupMessage" aria-live="polite" class="text-sm text-stone-600"><%= @group_book_post ? t("books.show.group_destination", name: jjaek.group.name) : t("jjaeks.form.choose_posting_group") %></p>
        </div>
      <% end %>

      <% if @select_book_post_destination || !@group_book_post %>
        <fieldset data-book-posting-target="personal" <%= 'hidden' if @group_book_post %> class="space-y-2">
          <legend class="mb-2 text-sm font-medium text-stone-700"><%= t("jjaeks.form.visibility") %></legend>
          <div class="grid gap-2 sm:grid-cols-3">
            <% Jjaek.visibilities.each_key do |visibility| %>
              <label class="<%= book_posting_card_classes %>">
                <%= form.radio_button :visibility, visibility, disabled: @group_book_post, required: true,
                                      data: { book_posting_target: "visibility" }, class: "sr-only" %>
                <%= book_posting_icon(visibility) %>
                <span><%= t("jjaeks.visibility.#{visibility}") %></span>
              </label>
            <% end %>
          </div>
        </fieldset>
      <% end %>

      <% if !@select_book_post_destination && quoted_jjaek.blank? %>
        <p class="text-sm text-stone-500"><%= t("jjaeks.form.no_postable_groups") %></p>
      <% end %>

      <%= render "shared/content_field", form: form, label_key: "jjaeks.form.book_jjaek_content", rows: 8 %>

      <%= form.submit submit_label, data: { book_posting_target: "submit" }, class: "rounded-full bg-stone-900 px-4 py-2 text-sm font-medium text-stone-50 disabled:opacity-50" %>
    <% end %>
  </div>
</section>
