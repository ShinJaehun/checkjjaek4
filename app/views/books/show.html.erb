<section class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render "shared/back_link", path: jjaek_back_path(default_path: @group.present? ? group_path(@group) : user_library_path(current_user)) %>
  <% can_write_book_jjaek = @bookshelf_entry&.persisted? && @jjaek.present? && policy(@jjaek).create? %>
  <%= render "books/book_header",
             book: @book,
             jjaek: can_write_book_jjaek ? @jjaek : nil,
             quoted_jjaek: @quoted_jjaek,
             bookshelf_entry: @bookshelf_entry,
             bookshelves: @bookshelves,
             search_result_token: @search_result_token,
             group_id: @group&.id,
             sticker_definitions: @sticker_definitions,
             form_values: @reading_state_form_values || {} %>

  <% if @book_friend_activities.present? %>
    <section class="mx-auto w-full max-w-3xl space-y-4">
      <h2 class="text-2xl font-semibold text-stone-900"><%= t("books.show.friend_activity_title") %></h2>
      <div class="space-y-3">
        <% @book_friend_activities.each do |item| %>
          <%= render "books/friend_activity", item: item %>
        <% end %>
      </div>
    </section>
  <% end %>

  <%= render "books/timeline", jjaeks: @jjaeks, book: @book %>
</section>
