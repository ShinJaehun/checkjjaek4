<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<section class="mx-auto flex w-full max-w-6xl flex-col gap-4 sm:gap-6"
         data-controller="book-detail" data-action="hashchange@window->book-detail#revealAnchor">
  <%= render "shared/back_link", path: jjaek_back_path(default_path: @group.present? ? group_path(@group) : user_library_path(current_user)) %>
  <%= render "books/book_header", book: @book %>

  <div class="mx-auto w-full max-w-3xl space-y-4">
    <% if @bookshelf_entry %>
      <%= render "books/detail_tabs", book: @book, selected_tab: @book_detail_tab %>
      <section id="book-my-reading" role="tabpanel" aria-labelledby="book-reading-tab"
               class="space-y-4" <%= "hidden" unless @book_detail_tab == "reading" %>>
        <%= render "books/my_reading", book: @book, entry: @bookshelf_entry %>
      </section>
    <% end %>

    <%= tag.section id: "book-sharing", class: "space-y-4 sm:space-y-6",
                    role: ("tabpanel" if @bookshelf_entry),
                    aria: { labelledby: ("book-jjaeks-tab" if @bookshelf_entry) },
                    hidden: @book_detail_tab == "reading" do %>
      <% if !@bookshelf_entry || @can_write_book_jjaek %>
        <div class="flex flex-wrap items-start gap-2">
          <% unless @bookshelf_entry %>
            <%= render "books/bookshelf_panel", book: @book, bookshelf_entry: nil, bookshelves: @bookshelves,
                       search_result_token: @search_result_token, group_id: @group&.id %>
          <% end %>
          <% if @can_write_book_jjaek %>
            <button type="button" class="ui-button ui-button-secondary group" aria-controls="book-jjaek-form"
                    aria-expanded="<%= !!@book_jjaek_form_open %>"
                    data-book-detail-target="composerToggle" data-action="book-detail#toggleComposer">
              <%= t("jjaeks.actions.publish_short") %>
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" class="size-4 group-aria-expanded:rotate-180">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </button>
          <% end %>
        </div>
      <% end %>

      <% if @can_write_book_jjaek %>
        <%= render "books/jjaek_form_panel", book: @book, jjaek: @jjaek %>
      <% end %>

      <% if !@bookshelf_entry && @book_note_page&.total_count.to_i.positive? %>
        <%= render "book_notes/book_section", book: @book, page: @book_note_page %>
      <% end %>

      <%= render "books/timeline", book: @book %>

      <% if @book.persisted? %>
        <section id="book-friend-activities" class="scroll-mt-20 space-y-4">
          <h2 class="text-2xl font-semibold text-stone-900"><%= t("books.show.friend_activity_title") %></h2>
          <% if @book_friend_activities.present? %>
            <div class="space-y-3">
              <% @book_friend_activities.each do |item| %>
                <%= render "books/friend_activity", item: item %>
              <% end %>
            </div>
          <% else %>
            <p class="rounded-3xl border border-dashed border-stone-300 bg-white p-6 text-sm text-stone-500">
              <%= t("books.show.empty_friend_activities") %>
            </p>
          <% end %>
        </section>
      <% end %>
    <% end %>
  </div>
</section>
