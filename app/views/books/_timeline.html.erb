<section class="space-y-4">
  <div>
    <h2 class="text-2xl font-semibold tracking-tight text-stone-900"><%= t("books.show.timeline_title") %></h2>
  </div>

  <%= render "feeds/list", page: @feed_page, context: :book, book:,
             next_url: @feed_page&.next_cursor && book_path(book, group_id: @group&.id,
               return_to: validated_jjaek_return_path(params[:return_to]), cursor: @feed_page.next_cursor),
             empty_text: t("books.show.empty_jjaeks") %>
</section>
