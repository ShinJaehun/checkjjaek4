<div class="flex min-w-0 items-start justify-between gap-3 text-sm text-stone-700"
         data-controller="book-modal"
         data-book-modal-auto-open-value="<%= bookshelf_entry.errors.any? %>"
         data-action="turbo:before-cache@document->book-modal#close">
  <div class="flex min-w-0 flex-1 flex-wrap gap-2">
    <% if bookshelf_entry.status.present? %>
      <%= reading_status_badge(bookshelf_entry.status) %>
    <% end %>
    <% bookshelf_entry.sticker_definitions.each do |sticker| %>
      <%= reading_sticker_badge(sticker) %>
    <% end %>
  </div>

  <button type="button" data-action="book-modal#open" aria-haspopup="dialog" aria-controls="book-reading-dialog" class="shrink-0 rounded-full border border-stone-300 px-3 py-1.5 text-xs font-medium text-stone-700">
    <%= t("books.show.edit_reading_record") %>
  </button>
  <dialog id="book-reading-dialog" aria-labelledby="book-reading-dialog-title" data-book-modal-target="dialog" data-action="close->book-modal#restore" class="m-auto max-h-[90dvh] w-[calc(100%_-_2rem)] max-w-lg overflow-y-auto rounded-3xl bg-white p-6 shadow-xl backdrop:bg-stone-900/40">
    <div class="mb-5 flex items-center justify-between gap-4">
      <h2 id="book-reading-dialog-title" class="text-lg font-semibold text-stone-900"><%= t("books.show.reading_record_title") %></h2>
      <button type="button" data-action="book-modal#close" class="shrink-0 text-sm text-stone-600"><%= t("bookshelves.actions.close") %></button>
    </div>
    <%= render "books/reading_state", bookshelf_entry: bookshelf_entry, sticker_definitions: sticker_definitions, form_values: local_assigns[:form_values] || {} %>
  </dialog>
</div>
