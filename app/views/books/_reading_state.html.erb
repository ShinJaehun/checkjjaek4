<% form_values = local_assigns[:form_values] || {} %>
<% selected_status = form_values.fetch("status", bookshelf_entry.status) %>
<% selected_sticker_ids = Array(form_values.fetch("sticker_definition_ids", bookshelf_entry.sticker_definition_ids)).map(&:to_s) %>
<% return_path = validated_jjaek_return_path(params[:return_to]) %>
<%= form_with model: bookshelf_entry, url: bookshelf_entry_path(bookshelf_entry), method: :patch, class: "space-y-5" do |form| %>
  <%= hidden_field_tag :group_id, @group.id if @group.present? %>
  <%= hidden_field_tag :quote_id, @quoted_jjaek&.id || params[:quote_id] if @quoted_jjaek.present? || params[:quote_id].present? %>
  <%= hidden_field_tag :return_to, return_path if return_path %>

  <% if bookshelf_entry.errors.any? %>
    <p role="alert" class="text-sm text-red-700"><%= bookshelf_entry.errors.full_messages.to_sentence %></p>
  <% end %>

  <fieldset class="space-y-3" data-reading-status-card>
    <legend class="text-sm font-semibold text-stone-900"><%= t("books.show.status_label") %></legend>
    <div class="flex flex-wrap gap-2">
      <label class="<%= reading_badge_classes(:status, selectable: true) %>">
        <%= form.radio_button :status, "", checked: selected_status.blank?, class: "shrink-0" %>
        <span><%= t("books.show.clear_status") %></span>
      </label>
      <% BookshelfEntry.statuses.keys.each do |status| %>
        <label class="<%= reading_badge_classes(:status, selectable: true) %>">
          <%= form.radio_button :status, status, checked: selected_status == status, class: "shrink-0" %>
          <%= reading_status_content(status) %>
        </label>
      <% end %>
    </div>
  </fieldset>

  <fieldset class="space-y-3" data-reading-stickers-card>
    <legend class="text-sm font-semibold text-stone-900"><%= t("bookshelf_entries.form.stickers") %></legend>
    <%= form.hidden_field :sticker_definition_ids, value: "", multiple: true %>
    <div class="flex flex-wrap gap-2">
      <%= form.collection_check_boxes :sticker_definition_ids, sticker_definitions, :id, :name, include_hidden: false, checked: selected_sticker_ids do |builder| %>
        <label class="<%= reading_badge_classes(:sticker, selectable: true) %>">
          <%= builder.check_box class: "shrink-0" %>
          <%= reading_sticker_content(builder.object) %>
        </label>
      <% end %>
    </div>
  </fieldset>

  <%= form.submit t("books.show.save_reading_record"), class: "ui-button ui-button-primary" %>
<% end %>
