<section class="mx-auto w-full max-w-4xl min-w-0 overflow-hidden rounded-[2rem] border border-stone-200 bg-white shadow-sm">
  <div class="grid grid-cols-[6rem_minmax(0,1fr)] gap-x-4 gap-y-6 p-6 md:grid-cols-[10rem_minmax(0,1fr)] md:gap-x-7 lg:p-8">
    <div class="flex items-start justify-center md:row-span-2">
      <%= render "books/thumbnail",
                 title: book.title,
                 thumbnail: book.thumbnail,
                 url: nil,
                 size: :book_detail,
                 link: false,
                 extra_classes: "shadow-sm" %>
    </div>

    <div class="min-w-0">
      <h1 class="break-words text-xl font-semibold leading-tight tracking-tight text-stone-900 sm:text-4xl"><%= book.title %></h1>

      <dl class="mt-3 space-y-2 text-xs leading-5 md:mt-5 md:text-sm md:leading-6">
        <div class="flex gap-2 md:gap-3">
          <dt class="w-10 shrink-0 text-stone-400 md:w-14"><%= t("books.show.authors") %></dt>
          <dd class="min-w-0 break-words font-medium text-stone-700"><%= book.authors_text.presence || "-" %></dd>
        </div>
        <div class="flex gap-2 md:gap-3">
          <dt class="w-10 shrink-0 text-stone-400 md:w-14"><%= t("books.show.publisher") %></dt>
          <dd class="min-w-0 break-words text-stone-600"><%= book.publisher.presence || "-" %></dd>
        </div>
        <div class="flex gap-2 md:gap-3">
          <dt class="w-10 shrink-0 text-stone-400 md:w-14"><%= t("books.show.isbn") %></dt>
          <dd class="min-w-0 break-all text-stone-500"><%= book.isbn.presence || "-" %></dd>
        </div>
      </dl>
    </div>

    <div class="col-span-2 min-w-0 md:col-span-1 md:col-start-2">
      <div data-controller="book-description">
        <p id="book-description" data-book-description-target="text" class="line-clamp-4 whitespace-pre-wrap break-words text-sm leading-7 text-stone-600 lg:line-clamp-none"><%= book.description.presence || t("books.show.empty_description") %></p>
        <button type="button" hidden data-book-description-target="toggle" data-action="book-description#toggle" aria-expanded="false" aria-controls="book-description" class="mt-3 rounded-lg text-sm font-medium text-stone-900 underline decoration-stone-300 underline-offset-4 hover:decoration-stone-700 lg:hidden">
          <span data-book-description-target="expand"><%= t("books.show.expand_description") %></span>
          <span data-book-description-target="collapse" hidden><%= t("books.show.collapse_description") %></span>
        </button>
      </div>

      <% if book.external_url.present? %>
        <div class="mt-5">
          <%= link_to t("books.show.external_link"), book.external_url, target: "_blank", rel: "noopener", class: "inline-flex rounded-full border border-stone-200 px-3 py-1.5 text-xs font-medium text-stone-600 hover:border-stone-400 hover:text-stone-900" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mx-6 space-y-4 border-t border-stone-100 py-6 lg:mx-8 lg:py-8">
    <%= render "books/bookshelf_panel",
               book: book,
               bookshelf_entry: bookshelf_entry,
               bookshelves: bookshelves,
               search_result_token: search_result_token,
               group_id: group_id %>
    <% if bookshelf_entry&.persisted? %>
      <%= render "books/reading_record_panel", bookshelf_entry: bookshelf_entry, sticker_definitions: sticker_definitions, form_values: form_values %>
    <% end %>
    <% if jjaek.present? %>
      <div data-controller="book-modal"
           data-book-modal-auto-open-value="<%= !bookshelf_entry.errors.any? && (quoted_jjaek.present? || jjaek.errors.any?) %>"
           data-action="turbo:before-cache@document->book-modal#close">
        <div class="flex justify-end">
          <button type="button" data-action="book-modal#open" aria-haspopup="dialog" aria-controls="book-writing-dialog" class="rounded-full bg-stone-900 px-3 py-1.5 text-xs font-medium text-white">
            <%= t("books.show.write_book_jjaek") %>
          </button>
        </div>
        <dialog id="book-writing-dialog" aria-labelledby="book-writing-dialog-title" data-book-modal-target="dialog" data-action="close->book-modal#restore" class="m-auto max-h-[90dvh] w-[calc(100%_-_2rem)] max-w-2xl overflow-y-auto rounded-3xl bg-white p-0 shadow-xl backdrop:bg-stone-900/40">
          <div class="flex items-center justify-between gap-4 px-6 pt-6">
            <h2 id="book-writing-dialog-title" class="text-lg font-semibold text-stone-900"><%= t("books.show.write_book_jjaek") %></h2>
            <button type="button" data-action="book-modal#close" class="shrink-0 text-sm text-stone-600"><%= t("bookshelves.actions.close") %></button>
          </div>
          <%= render "books/jjaek_form_panel", book: book, jjaek: jjaek, quoted_jjaek: quoted_jjaek, modal: true %>
        </dialog>
      </div>
    <% end %>
  </div>
</section>
