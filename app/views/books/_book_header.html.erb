<section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm">
  <div class="space-y-6">
    <div class="flex gap-5">
      <div class="shrink-0 self-center md:self-start">
        <%= render "books/thumbnail",
                   title: book.title,
                   thumbnail: book.thumbnail,
                   url: nil,
                   size: :large,
                   link: false,
                   extra_classes: "shadow-sm" %>
      </div>

      <div class="min-w-0 flex-1">
        <h1 class="text-2xl font-semibold leading-tight tracking-tight text-stone-900 sm:text-3xl"><%= book.title %></h1>

        <div class="mt-3 space-y-1 text-sm leading-6 text-stone-500">
          <p><%= t("books.show.authors") %>: <%= book.authors_text.presence || "-" %></p>
          <p><%= t("books.show.publisher") %>: <%= book.publisher.presence || "-" %></p>
          <p><%= t("books.show.isbn") %>: <%= book.isbn.presence || "-" %></p>
        </div>

        <% if book.external_url.present? %>
          <div class="mt-5">
            <%= link_to t("books.show.external_link"), book.external_url, target: "_blank", rel: "noopener", class: "text-sm font-medium text-stone-900" %>
          </div>
        <% end %>
      </div>
    </div>

    <div data-controller="book-description">
      <p id="book-description" data-book-description-target="text" class="line-clamp-4 whitespace-pre-wrap text-sm leading-7 text-stone-700 lg:line-clamp-none"><%= book.description.presence || t("books.show.empty_description") %></p>
      <button type="button" hidden data-book-description-target="toggle" data-action="book-description#toggle" aria-expanded="false" aria-controls="book-description" class="mt-3 text-sm font-medium text-stone-900 lg:hidden">
        <span data-book-description-target="expand"><%= t("books.show.expand_description") %></span>
        <span data-book-description-target="collapse" hidden><%= t("books.show.collapse_description") %></span>
      </button>
    </div>
  </div>
</section>
