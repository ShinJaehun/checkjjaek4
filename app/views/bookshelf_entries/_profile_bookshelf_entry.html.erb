<%
  metadata = [ bookshelf_entry.book.authors_text.presence, bookshelf_entry.book.publisher.presence ].compact.join(" · ").presence || "-"
  profile_summary = local_assigns.fetch(:profile_summary, false)
  visible_stickers = bookshelf_entry.sticker_definitions.first(5)
  remaining_stickers = bookshelf_entry.sticker_definitions.drop(5)
%>

<article class="w-full max-w-full rounded-2xl border border-stone-200 bg-white p-3 shadow-sm <%= profile_summary ? "relative min-h-36 overflow-visible focus-within:z-20 sm:h-36" : "h-full min-h-36 overflow-hidden" %> <%= "cursor-grab active:cursor-grabbing" if local_assigns.fetch(:show_sort_handle, false) %>"
         data-bookshelf-entry-id="<%= bookshelf_entry.id %>"
         data-bookshelf-entry-view="detail"
         <% if local_assigns.fetch(:show_sort_handle, false) %>
           data-bookshelf-entries-sort-handle
         <% end %>>
  <div class="flex min-w-0 gap-3 <%= profile_summary ? "h-auto sm:h-full" : "h-full" %>">
    <div class="flex w-20 shrink-0 justify-center"
         <% if local_assigns.fetch(:show_sort_handle, false) %>
           data-bookshelf-entries-sort-handle
         <% end %>>
      <%= render "books/thumbnail",
                 title: bookshelf_entry.book.title,
                 thumbnail: bookshelf_entry.book.thumbnail,
                 url: book_path(bookshelf_entry.book),
                 link: false,
                 size: :medium %>
    </div>

    <div class="flex min-w-0 flex-1 flex-col <%= profile_summary ? "overflow-visible" : "overflow-hidden" %>">
      <div class="min-w-0 overflow-hidden">
        <%= link_to bookshelf_entry.book.title,
                    book_path(bookshelf_entry.book),
                    class: "block truncate text-sm font-semibold leading-5 text-stone-900 hover:text-stone-700",
                    title: bookshelf_entry.book.title %>
        <p class="mt-1 truncate text-sm text-stone-500"
           title="<%= metadata %>"><%= metadata %></p>
      </div>

      <% if profile_summary && local_assigns.fetch(:show_status, false) %>
        <div class="mt-3 flex min-w-0 flex-wrap content-start items-start gap-1.5 overflow-visible sm:h-16">
          <span class="shrink-0 rounded-full bg-stone-100 px-2.5 py-1 text-xs font-medium text-stone-700">
            <%= bookshelf_entry.status.present? ? t("bookshelf_entries.statuses.#{bookshelf_entry.status}") : t("users.profile.no_reading_status") %>
          </span>
          <% visible_stickers.each do |sticker| %>
            <span class="min-w-0 max-w-24 truncate rounded-full border border-stone-300 px-2.5 py-1 text-xs text-stone-600"><%= sticker.name %></span>
          <% end %>
          <% if remaining_stickers.any? %>
            <details class="relative shrink-0">
              <summary class="cursor-pointer list-none rounded-full border border-stone-300 px-2.5 py-1 text-xs text-stone-600"
                       aria-label="<%= t("bookshelf_entries.stickers.summary", count: remaining_stickers.size) %>">
                +<%= remaining_stickers.size %>
              </summary>
              <div class="absolute right-0 top-full z-30 mt-1 max-h-48 w-max max-w-56 overflow-y-auto rounded-xl border border-stone-200 bg-white p-2 shadow-lg">
                <div class="flex flex-wrap gap-1">
                  <% remaining_stickers.each do |sticker| %>
                    <span class="max-w-full break-words rounded-full border border-stone-200 px-2.5 py-1 text-xs text-stone-600"><%= sticker.name %></span>
                  <% end %>
                </div>
              </div>
            </details>
          <% end %>
        </div>
      <% elsif local_assigns.fetch(:show_status, false) && (bookshelf_entry.status.present? || bookshelf_entry.sticker_definitions.any?) %>
        <div class="mt-2 flex h-[3.25rem] min-w-0 flex-wrap content-start items-start gap-1.5 overflow-hidden">        
          <% if bookshelf_entry.status.present? %>
            <span class="max-w-full truncate rounded-full bg-stone-100 px-3 py-1 text-xs font-medium text-stone-700"><%= t("bookshelf_entries.statuses.#{bookshelf_entry.status}") %></span>
          <% end %>

          <% if bookshelf_entry.sticker_definitions.any? %>
            <details class="relative min-w-0 max-w-full md:hidden [&[open]>summary]:absolute [&[open]>summary]:inset-0 [&[open]>summary]:z-10 [&[open]>summary]:opacity-0">
              <summary class="inline-flex h-6 min-w-6 cursor-pointer list-none items-center justify-center rounded-full border border-stone-300 px-2 text-xs font-medium text-stone-600"
                       aria-label="<%= t("bookshelf_entries.stickers.summary", count: bookshelf_entry.sticker_definitions.size) %>">
                <span aria-hidden="true"><%= bookshelf_entry.sticker_definitions.size %></span>
                <span class="sr-only"><%= t("bookshelf_entries.stickers.summary", count: bookshelf_entry.sticker_definitions.size) %></span>
              </summary>
              <div class="mt-1 flex max-w-full flex-wrap gap-1">
                <% bookshelf_entry.sticker_definitions.each do |sticker| %>
                  <span class="max-w-full truncate rounded-full border border-stone-200 px-2.5 py-1 text-xs text-stone-500"><%= sticker.name %></span>
                <% end %>
              </div>
            </details>

            <div class="hidden min-w-0 max-w-full flex-wrap gap-1 md:flex">
              <% bookshelf_entry.sticker_definitions.each do |sticker| %>
                <span class="max-w-full truncate rounded-full border border-stone-300 px-2.5 py-1 text-xs text-stone-600"><%= sticker.name %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</article>
