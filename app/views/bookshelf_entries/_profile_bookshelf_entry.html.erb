<article class="relative h-36 w-full max-w-full overflow-hidden rounded-2xl border border-stone-200 bg-white p-3 shadow-sm <%= "md:cursor-grab md:active:cursor-grabbing" if local_assigns.fetch(:show_sort_handle, false) %>"
         data-bookshelf-entry-id="<%= bookshelf_entry.id %>"
         data-bookshelf-entry-view="detail"
         <% if local_assigns.fetch(:show_sort_handle, false) %>
           data-bookshelf-entries-sort-handle
         <% end %>>
  <div class="flex min-w-0 items-start gap-3">
    <div class="flex w-20 shrink-0 justify-center"
         <% if local_assigns.fetch(:show_sort_handle, false) %>
           data-bookshelf-entries-sort-handle
         <% end %>>
      <%= render "books/thumbnail",
                 title: bookshelf_entry.book.title,
                 thumbnail: bookshelf_entry.book.thumbnail,
                 url: book_path(bookshelf_entry.book, book_navigation_params),
                 link: false,
                 size: :medium %>
    </div>

    <div class="min-w-0 flex-1">
      <%= render "bookshelf_entries/card_information",
                 bookshelf_entry: bookshelf_entry,
                 show_status: local_assigns.fetch(:show_status, false) %>
    </div>
  </div>

  <% if local_assigns.fetch(:show_mobile_reorder_controls, false) %>
    <div class="absolute right-2 top-1/2 z-10 hidden -translate-y-1/2 flex-col gap-1 md:hidden"
         data-bookshelf-entries-sort-target="controls">
      <button type="button"
              class="flex h-10 w-10 items-center justify-center rounded-lg border border-stone-200 bg-stone-50 text-stone-700 transition enabled:hover:border-stone-300 enabled:hover:bg-stone-100 enabled:active:bg-stone-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-500 disabled:cursor-not-allowed disabled:border-stone-100 disabled:text-stone-300"
              data-action="bookshelf-entries-sort#moveUp"
              aria-label="<%= t("users.profile.bookshelf_sort.move_up", title: bookshelf_entry.book.title) %>">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m6 15 6-6 6 6" />
        </svg>
      </button>
      <button type="button"
              class="flex h-10 w-10 items-center justify-center rounded-lg border border-stone-200 bg-stone-50 text-stone-700 transition enabled:hover:border-stone-300 enabled:hover:bg-stone-100 enabled:active:bg-stone-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-500 disabled:cursor-not-allowed disabled:border-stone-100 disabled:text-stone-300"
              data-action="bookshelf-entries-sort#moveDown"
              aria-label="<%= t("users.profile.bookshelf_sort.move_down", title: bookshelf_entry.book.title) %>">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </button>
    </div>
  <% end %>
</article>
