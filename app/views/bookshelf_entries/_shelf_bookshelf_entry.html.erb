<%
  book = bookshelf_entry.book
  dialog_id = dom_id(bookshelf_entry, :shelf_information)
  title_id = "#{dialog_id}_title"
  transfer_selection = local_assigns.fetch(:show_transfer_selection, false)
  mobile_reorder = local_assigns.fetch(:enable_mobile_reorder, false)
  detail_path = book_path(book, book_detail_options)
  details_label = t("bookshelf_entries.actions.details")
%>

<article class="relative min-w-0 rounded-sm <%= '[&.bookshelf-reorder-held]:shadow-md [&.bookshelf-reorder-held]:outline-2 [&.bookshelf-reorder-held]:outline-stone-900 [&.bookshelf-reorder-placeholder]:opacity-40 [&.bookshelf-reorder-placeholder]:outline-dashed [@media(max-width:767px),(pointer:coarse)]:data-[reorder-selected]:outline-2 [@media(max-width:767px),(pointer:coarse)]:data-[reorder-selected]:outline-stone-900' if mobile_reorder %>"
         data-bookshelf-entry-id="<%= bookshelf_entry.id %>"
         data-controller="book-modal"
         data-action="turbo:before-cache@document->book-modal#close"
         <% if transfer_selection %>
           data-bookshelf-transfer-target="entry"
         <% end %>
         <% if local_assigns.fetch(:show_sort_handle, false) %>
           data-bookshelf-entries-sort-handle
         <% end %>>
  <% if transfer_selection %>
    <label class="absolute right-1 top-1 z-10 hidden h-11 w-11 items-center justify-center rounded-full border border-stone-300 bg-white/95"
           data-bookshelf-transfer-target="selectionCheckboxWrapper">
      <span class="sr-only"><%= t("users.library.transfer.select_book", title: book.title) %></span>
      <%= check_box_tag "transfer_selection_#{bookshelf_entry.id}",
                        bookshelf_entry.id,
                        false,
                        class: "h-4 w-4 rounded border-stone-300 text-stone-900",
                        data: { bookshelf_transfer_target: "selectionCheckbox", action: "change->bookshelf-transfer#syncSelection" },
                        autocomplete: "off" %>
    </label>
  <% end %>

  <button type="button"
          class="bookshelf-cover rounded-sm focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-stone-700 <%= 'md:cursor-grab md:active:cursor-grabbing' if local_assigns.fetch(:show_sort_handle, false) %> <%= 'group-data-[touch-reorder]:select-none group-data-[touch-reorder]:[-webkit-touch-callout:none]' if mobile_reorder %>"
          data-bookshelf-cover
          <% if mobile_reorder %>aria-describedby="library-bookshelf-order-hint"<% end %>
          data-action="<%= 'bookshelf-entries-sort#handleCoverClick contextmenu->bookshelf-entries-sort#preventCoverContextMenu keydown.shift+enter->bookshelf-entries-sort#selectWithKeyboard keydown.esc->bookshelf-entries-sort#clearSelection ' if mobile_reorder %><%= 'bookshelf-transfer#selectFromCover ' if transfer_selection %>book-modal#open"
          aria-haspopup="dialog" aria-controls="<%= dialog_id %>" aria-label="<%= book.title %>">
    <% if book.thumbnail.present? %>
      <%= image_tag book.thumbnail, alt: "", loading: "lazy", draggable: false %>
    <% else %>
      <span class="bookshelf-cover-placeholder"><span class="line-clamp-4 break-words"><%= book.title %></span></span>
    <% end %>
  </button>

  <dialog id="<%= dialog_id %>" aria-labelledby="<%= title_id %>"
          class="m-auto max-h-[90dvh] w-[calc(100%_-_2rem)] max-w-md overflow-y-auto overscroll-contain rounded-2xl bg-white p-5 shadow-xl backdrop:bg-stone-900/40"
          data-book-modal-target="dialog" data-action="close->book-modal#restore">
    <div class="flex items-start gap-3">
      <div class="flex w-20 shrink-0 justify-center">
        <%= render "books/thumbnail", title: book.title, thumbnail: book.thumbnail, url: nil, size: :medium, loading: "lazy" %>
      </div>
      <div class="min-w-0 flex-1">
        <%= render "bookshelf_entries/card_information", bookshelf_entry:, show_status:, title_id: %>
      </div>
    </div>
    <div class="mt-5 flex flex-wrap justify-end gap-2 border-t border-stone-200 pt-4">
      <% if local_assigns[:removal_params] %>
        <%= button_to t("bookshelf_entries.actions.remove"), bookshelf_entry_path(bookshelf_entry),
                      method: :delete, params: removal_params,
                      form: { data: {
                        turbo_confirm: bookshelf_removal_confirmation,
                        controller: "bookshelf-form-recovery",
                        bookshelf_form_recovery_message_value: t("bookshelf_entries.alerts.remove_failed"),
                        action: "turbo:before-fetch-response->bookshelf-form-recovery#checkResponse turbo:fetch-request-error->bookshelf-form-recovery#recover"
                      } },
                      class: "ui-button ui-button-secondary text-red-700" %>
      <% end %>
      <button type="button" class="ui-button ui-button-secondary" data-action="book-modal#close" autofocus>
        <%= t("bookshelves.actions.close") %>
      </button>
      <%= link_to details_label, detail_path, class: "ui-button ui-button-primary" %>
    </div>
  </dialog>

  <noscript>
    <%= link_to details_label, detail_path, class: "ui-button ui-button-secondary absolute inset-x-0 bottom-0" %>
  </noscript>
</article>
