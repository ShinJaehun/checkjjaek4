<%
  book = bookshelf_entry.book
  title_id = local_assigns[:title_id]
  metadata = [ book.authors_text.presence, book.publisher.presence ].compact.join(" · ").presence
  stickers = if show_status
    bookshelf_entry.user_book.sticker_definitions.sort_by { |sticker| [sticker.position, sticker.id] }
  else
    []
  end
  extra_names = stickers.drop(6).map { |sticker| reading_sticker_label(sticker) }
  remaining_stickers = stickers.drop(3)
  remaining_names = remaining_stickers.map { |sticker| reading_sticker_label(sticker) }.join(", ")
%>

<div class="flex w-full min-w-0 shrink-0 flex-col <%= 'h-28' unless title_id %>" data-book-card-information>
  <% if title_id %>
    <h2 id="<%= title_id %>" class="break-words text-lg font-semibold text-stone-900"><%= book.title %></h2>
    <% if metadata %>
      <p class="mt-1 break-words text-sm text-stone-600"><%= metadata %></p>
    <% end %>
  <% else %>
    <% profile_metadata = metadata || "-" %>
    <%= link_to book.title, book_path(book, book_navigation_params),
                class: "block h-5 shrink-0 truncate text-sm font-semibold leading-5 text-stone-900 hover:text-stone-700",
                title: book.title %>
    <p class="mt-1 h-5 shrink-0 truncate text-xs leading-5 text-stone-500" title="<%= profile_metadata %>"><%= profile_metadata %></p>
  <% end %>

  <div class="mt-2 space-y-1">
    <div class="flex h-7 min-w-0 items-center" data-reading-status-row>
      <%= reading_status_badge(bookshelf_entry.user_book.status) if show_status %>
    </div>
    <div class="flex h-7 min-w-0 items-center gap-0.5 overflow-hidden"
         data-reading-stickers-row
         data-controller="sticker-overflow"
         data-sticker-overflow-extra-names-value="<%= extra_names.to_json %>"
         data-sticker-overflow-summary-label-value="<%= t("bookshelf_entries.stickers.summary", count: "{count}") %>">
      <% stickers.first(6).each_with_index do |sticker, index| %>
        <span class="shrink-0" data-sticker-overflow-target="sticker" style="<%= 'display: none;' if index >= 3 %>">
          <%= reading_sticker_badge(sticker, icon_only: true) %>
        </span>
      <% end %>
      <% if stickers.any? %>
        <span class="<%= reading_badge_classes(:sticker, icon_only: true) %> whitespace-nowrap"
              style="<%= 'display: none;' if remaining_stickers.empty? %>"
              data-sticker-overflow-target="summary"
              title="<%= remaining_names %>"
              aria-label="<%= t("bookshelf_entries.stickers.summary", count: remaining_stickers.size) %>: <%= remaining_names %>"
              role="img"
              tabindex="0"
              data-reading-sticker-overflow>+<%= remaining_stickers.size %></span>
      <% end %>
    </div>
  </div>
</div>
