<% if params[:bookshelf_entry_source] == "jjaek_attachment" %>
  <%= turbo_stream.replace "attachment_shelf_#{book_search_result_dom_id(@book_search_result)}" do %>
    <%= render "jjaeks/attachment_shelf", book: @book_search_result, bookshelves: @bookshelves %>
  <% end %>
<% else %>
  <%= turbo_stream.replace book_search_result_dom_id(@book_search_result) do %>
    <%= render "book_searches/result_card", book: @book_search_result, bookshelves: @bookshelves, group_id: params[:group_id], return_path: validated_jjaek_return_path(params[:return_to]) %>
  <% end %>
<% end %>

<%= turbo_stream.update "flash-messages" do %>
  <%= render "shared/flash" %>
<% end %>
