<% transfer_selection = local_assigns.fetch(:show_transfer_selection, false) %>

<article class="relative w-full border border-stone-200 bg-white shadow-sm transition <%= transfer_selection ? "h-36 max-w-full overflow-hidden rounded-2xl p-3 md:h-64 md:max-w-40 md:overflow-visible md:rounded-xl md:p-2.5 lg:max-w-44" : "h-64 max-w-44 rounded-xl p-2.5 md:max-w-40 lg:max-w-44" %> <%= "md:cursor-grab md:active:cursor-grabbing" if local_assigns.fetch(:show_sort_handle, false) %>"
         data-bookshelf-entry-id="<%= bookshelf_entry.id %>"
         data-bookshelf-entry-view="compact"
         <% if transfer_selection %>
           data-bookshelf-transfer-target="entry"
           data-action="click->bookshelf-transfer#toggleCardSelection"
         <% end %>
         <% if local_assigns.fetch(:show_sort_handle, false) %>
           data-bookshelf-entries-sort-handle
         <% end %>>
  <% if transfer_selection %>
    <label class="absolute right-2 top-2 z-10 hidden h-9 w-9 items-center justify-center rounded-full border border-stone-300 bg-white/95 md:hidden"
           data-bookshelf-transfer-target="selectionCheckboxWrapper">
      <span class="sr-only"><%= t("users.library.transfer.select_book", title: bookshelf_entry.book.title) %></span>
      <%= check_box_tag "transfer_selection_#{bookshelf_entry.id}",
                        bookshelf_entry.id,
                        false,
                        class: "h-4 w-4 rounded border-stone-300 text-stone-900",
                        data: { bookshelf_transfer_target: "selectionCheckbox", action: "bookshelf-transfer#toggleEntrySelection" },
                        autocomplete: "off" %>
    </label>
  <% end %>

  <% if local_assigns[:removal_params] %>
    <% remove_label = t("bookshelf_entries.actions.remove_book", title: bookshelf_entry.book.title) %>
    <%= button_to bookshelf_entry_path(bookshelf_entry), method: :delete, params: removal_params,
                  form: { class: "absolute right-2 top-2 z-10 hidden md:block", data: { turbo_confirm: bookshelf_removal_confirmation } },
                  class: "inline-flex h-10 w-10 items-center justify-center rounded-full border border-stone-300 bg-white text-red-700 shadow-sm hover:bg-red-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-700",
                  title: remove_label, aria: { label: remove_label } do %>
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 18V5a2 2 0 0 1 2-2h12v18H8a3 3 0 0 1 0-6h11M9 9h6" />
      </svg>
    <% end %>
  <% end %>

  <div class="flex h-full min-w-0 <%= transfer_selection ? "items-start gap-3 md:flex-col md:gap-2" : "flex-col gap-2" %>">
    <div class="flex items-start justify-center <%= transfer_selection ? "w-20 shrink-0 md:min-h-28 md:w-full md:shrink" : "min-h-28" %>"
         <% if local_assigns.fetch(:show_sort_handle, false) %>
           data-bookshelf-entries-sort-handle
         <% end %>>
      <%= render "books/thumbnail",
                 title: bookshelf_entry.book.title,
                 thumbnail: bookshelf_entry.book.thumbnail,
                 url: book_path(bookshelf_entry.book, book_navigation_params),
                 link: false,
                 size: :medium %>
    </div>

    <div class="min-w-0 <%= "flex-1 md:w-full" if transfer_selection %>">
      <%= render "bookshelf_entries/card_information",
                 bookshelf_entry: bookshelf_entry,
                 show_status: local_assigns.fetch(:show_status, false) %>
    </div>
  </div>
</article>
