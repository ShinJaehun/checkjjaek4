<% transfer_selection = local_assigns.fetch(:show_transfer_selection, false) %>

<article class="relative h-64 w-full max-w-44 rounded-xl border border-stone-200 bg-white p-2.5 shadow-sm transition md:max-w-40 lg:max-w-44 <%= "md:cursor-grab md:active:cursor-grabbing" if local_assigns.fetch(:show_sort_handle, false) %>"
         data-bookshelf-entry-id="<%= bookshelf_entry.id %>"
         data-bookshelf-entry-view="compact"
         <% if transfer_selection %>
           data-bookshelf-transfer-target="entry"
           data-action="click->bookshelf-transfer#toggleCardSelection"
         <% end %>
         <% if local_assigns.fetch(:show_sort_handle, false) %>
           data-bookshelf-entries-sort-handle
         <% end %>>
  <% if transfer_selection %>
    <label class="absolute right-2 top-2 z-10 hidden h-9 w-9 items-center justify-center rounded-full border border-stone-300 bg-white/95 shadow-sm md:hidden"
           data-bookshelf-transfer-target="selectionCheckboxWrapper">
      <span class="sr-only"><%= t("users.library.transfer.select_book", title: bookshelf_entry.book.title) %></span>
      <%= check_box_tag "transfer_selection_#{bookshelf_entry.id}",
                        bookshelf_entry.id,
                        false,
                        class: "h-4 w-4 rounded border-stone-300 text-stone-900",
                        data: { bookshelf_transfer_target: "selectionCheckbox", action: "bookshelf-transfer#toggleEntrySelection" },
                        autocomplete: "off" %>
    </label>
  <% end %>

  <div class="flex h-full flex-col gap-2">
    <div class="flex min-h-28 items-start justify-center"
         <% if local_assigns.fetch(:show_sort_handle, false) %>
           data-bookshelf-entries-sort-handle
         <% end %>>
      <%= render "books/thumbnail",
                 title: bookshelf_entry.book.title,
                 thumbnail: bookshelf_entry.book.thumbnail,
                 url: book_path(bookshelf_entry.book),
                 link: false,
                 size: :medium %>
    </div>

    <%= render "bookshelf_entries/card_information",
               bookshelf_entry: bookshelf_entry,
               show_status: local_assigns.fetch(:show_status, false) %>
  </div>
</article>
