<% preview = note.body.to_plain_text.squish %>
<% book_details = [ book.authors_text, book.publisher ].compact_blank.join(" · ") %>
<%= link_to book_book_note_path(book, note, return_to:),
            class: "book-note-paper book-note-card flex h-full min-w-0 flex-col gap-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-600" do %>
  <div class="space-y-1">
    <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
      <h3 class="book-note-title wrap-anywhere text-lg font-semibold"><%= note.title.presence || t("book_notes.untitled") %></h3>
      <time class="book-note-date" datetime="<%= note.created_at.iso8601 %>"><%= l(note.created_at, format: :short) %></time>
    </div>
    <% if preview.present? %>
      <p class="book-note-preview wrap-anywhere text-sm leading-6 text-stone-700"><%= truncate(preview, length: 120) %></p>
    <% end %>
  </div>

  <div class="mt-auto flex min-w-0 items-center gap-3 border-t border-[color:var(--book-note-border)] pt-3">
    <div class="flex h-20 w-14 shrink-0 items-center justify-center">
      <%= render "books/thumbnail", title: book.title, thumbnail: book.thumbnail, url: nil, size: :small %>
    </div>
    <div class="min-w-0 space-y-1">
      <p class="wrap-anywhere text-sm font-medium text-stone-800"><%= book.title %></p>
      <% if book_details.present? %>
        <p class="wrap-anywhere text-xs text-stone-600"><%= book_details %></p>
      <% end %>
    </div>
  </div>
<% end %>
