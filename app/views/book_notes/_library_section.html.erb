<% library_options = library_options.merge(library_tab: "notes") %>
<% library_path = user_library_path(@user, **library_options, notes_page: page.page) %>
<section id="book-notes" class="scroll-mt-20 space-y-4" aria-labelledby="library-book-notes-heading">
  <h2 id="library-book-notes-heading" class="sr-only"><%= t("book_notes.heading") %></h2>
  <% if page.total_count.positive? %>
    <ul class="grid gap-3 sm:grid-cols-2">
      <% page.records.each do |note| %>
        <li class="min-w-0">
          <%= render "book_notes/card", note:, book: note.user_book.book, return_to: library_path %>
        </li>
      <% end %>
    </ul>
    <% if page.total_pages > 1 %>
      <%= render "shared/pagination", page:, page_param: :notes_page,
                 query_params: library_options.merge(controller: "/users/libraries", action: "show", user_id: @user.to_param, anchor: "book-notes") %>
    <% end %>
  <% else %>
    <p class="rounded-2xl border border-dashed border-stone-300 bg-white p-6 text-sm text-stone-500"><%= t("book_notes.empty") %></p>
  <% end %>
</section>
