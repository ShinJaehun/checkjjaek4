<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<section class="mx-auto w-full max-w-3xl space-y-4">
  <%= render "shared/back_link", path: @note_back_path %>
  <article class="book-note-paper space-y-5 sm:space-y-6">
    <header class="space-y-5">
      <div class="book-note-meta">
        <% book_details = [ @book.authors_text, @book.publisher ].compact_blank.join(" · ") %>
        <%= link_to book_path(@book, tab: "reading"),
                    class: "flex min-w-0 items-center gap-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-600" do %>
          <% if @book.thumbnail.present? %>
            <div class="flex h-20 w-14 shrink-0 items-center justify-center">
              <%= render "books/thumbnail", title: @book.title, thumbnail: @book.thumbnail, url: nil, size: :small %>
            </div>
          <% end %>
          <div class="min-w-0 space-y-1">
            <p class="wrap-anywhere font-semibold underline underline-offset-2"><%= @book.title %></p>
            <% if book_details.present? %>
              <p class="wrap-anywhere text-sm text-stone-600"><%= book_details %></p>
            <% end %>
          </div>
        <% end %>
        <time class="book-note-date" datetime="<%= @book_note.created_at.iso8601 %>"><%= l(@book_note.created_at.to_date, format: :book_note) %></time>
      </div>
      <h1 class="book-note-title wrap-anywhere text-2xl font-semibold sm:text-3xl"><%= @book_note.title.presence || t("book_notes.untitled") %></h1>
    </header>

    <div class="book-note-body">
      <div class="trix-content"><%= book_note_body_html(@book_note) %></div>
    </div>

    <% if @can_change_book_note %>
      <footer class="flex flex-wrap justify-end gap-2">
        <%= render "book_notes/editor", book_note: @book_note_draft || @book_note, book: @book,
                   url: @note_path, discard_path: @note_path, label: t("book_notes.edit") %>
        <%= button_to t("book_notes.delete"), @note_path, method: :delete,
                      class: "ui-button ui-button-danger",
                      form: { data: { turbo_confirm: t("book_notes.confirm_delete") } } %>
      </footer>
    <% end %>
  </article>
</section>
