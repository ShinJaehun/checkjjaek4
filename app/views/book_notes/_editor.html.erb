<% invalid_body = book_note.errors[:body].any? %>
<% editor_value = String.new(sanitize_action_text_content(book_note.editable_body)) %>
<% note_date = book_note.created_at&.to_date || Date.current %>
<div data-controller="book-note-editor"
     data-book-note-editor-discard-message-value="<%= t("book_notes.confirm_discard") %>"
     <% if book_note.errors.any? %>
       data-book-note-editor-discard-path-value="<%= discard_path %>"
     <% end %>>
  <button type="button" class="ui-button ui-button-primary" aria-haspopup="dialog" aria-controls="book-note-editor"
          data-book-note-editor-target="opener" data-action="book-note-editor#open"><%= label %></button>

  <dialog id="book-note-editor" class="book-note-dialog"
          aria-labelledby="book-note-editor-heading" data-book-note-editor-target="dialog"
          data-action="cancel->book-note-editor#close click->book-note-editor#backdrop">
    <div class="book-note-paper space-y-4">
      <header class="space-y-3">
        <h2 id="book-note-editor-heading" class="text-lg font-semibold"><%= t("book_notes.heading") %></h2>
        <div class="book-note-meta">
          <div class="flex min-w-0 items-start gap-3">
            <div class="flex h-[74px] w-[52px] shrink-0 items-center justify-center *:max-h-full *:max-w-full">
              <%= render "books/thumbnail", title: book.title, thumbnail: book.thumbnail, url: nil, size: :small %>
            </div>
            <div class="min-w-0 flex-1 space-y-1">
              <p class="line-clamp-2 wrap-anywhere font-semibold"><%= book.title %></p>
              <% if book.authors_text.present? %>
                <p class="truncate text-sm text-stone-600"><%= book.authors_text %></p>
              <% end %>
              <time class="book-note-date block w-fit" datetime="<%= note_date.iso8601 %>"><%= l(note_date, format: :book_note) %></time>
            </div>
          </div>
        </div>
      </header>
      <%= form_with model: book_note, url:, class: "space-y-4",
                    data: { action: "trix-file-accept->book-note-editor#rejectFile trix-attachment-add->book-note-editor#rejectAttachment" } do |form| %>
        <div class="space-y-1">
          <%= form.label :title, t("book_notes.title"), class: "block text-sm font-medium" %>
          <%= form.text_field :title, class: "book-note-title w-full",
                              data: { book_note_editor_target: "title" } %>
        </div>

        <div class="space-y-1">
          <%= form.label :body, t("book_notes.body"), id: "book-note-body-label", class: "block text-sm font-medium" %>
          <%= form.rich_text_area :body, value: editor_value,
                                  aria: { labelledby: "book-note-body-label", invalid: ("true" if invalid_body),
                                          describedby: ("book-note-body-error" if invalid_body) },
                                  data: { book_note_editor_target: "editor", direct_upload_url: "", blob_url_template: "" } %>
          <% if invalid_body %>
            <p id="book-note-body-error" role="alert" class="text-sm text-red-700"><%= book_note.errors[:body].first %></p>
          <% end %>
          <p hidden role="alert" class="text-sm text-red-700" data-book-note-editor-target="attachmentError"><%= t("book_notes.attachments_not_allowed") %></p>
        </div>

        <div class="flex flex-wrap justify-end gap-2">
          <button type="button" class="ui-button ui-button-secondary" data-action="book-note-editor#close"><%= t("book_notes.cancel") %></button>
          <%= form.submit t("book_notes.save"), class: "ui-button ui-button-primary" %>
        </div>
      <% end %>
    </div>
  </dialog>
</div>
