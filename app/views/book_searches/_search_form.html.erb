<% query_id = local_assigns[:modal] ? "book_search_modal_query" : "query" %>
<%= form_with url: book_search_path, method: :get, local: true, data: { turbo_frame: ("book_search_modal_results" if local_assigns[:modal]) }, class: "mt-6 space-y-3" do |form| %>
  <%= form.hidden_field :group_id, value: local_assigns[:group_id] if local_assigns[:group_id].present? %>
  <%= form.hidden_field :modal, value: "1" if local_assigns[:modal] %>
  <div class="space-y-2">
    <%= form.label :query, t("book_search.form.query"), for: query_id, class: "text-sm font-medium text-stone-700" %>
    <%= form.text_field :query, id: query_id, value: query, placeholder: t("book_search.placeholder"), class: "w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm shadow-sm focus:border-stone-500 focus:outline-none" %>
  </div>

  <%= form.submit t("book_search.form.submit"), class: "rounded-full bg-stone-900 px-4 py-2 text-sm font-medium text-stone-50" %>
<% end %>
