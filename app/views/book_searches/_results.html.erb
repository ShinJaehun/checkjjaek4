<% if @query.present? %>
  <div class="space-y-5">
    <% if @external_search_failed %>
      <p role="status" class="rounded-xl bg-amber-50 p-4 text-sm text-amber-900"><%= t("search_ui.external_unavailable") %></p>
    <% end %>
    <% if @local_results.any? || @results.any? %>
      <section class="space-y-3" aria-label="<%= t("book_search.results.title") %>">
        <h2 class="text-lg font-semibold"><%= t("book_search.results.title") %></h2>
        <% (@local_results + @results).each do |book| %>
          <%= render "book_searches/result_card", book: book, bookshelves: @bookshelves, group_id: @group&.id %>
        <% end %>
      </section>
    <% elsif !@external_search_failed %>
      <section class="rounded-2xl border border-stone-200 bg-white p-5">
        <h2 class="font-semibold"><%= t("book_search.empty.title") %></h2>
        <p class="mt-2 text-sm text-stone-500"><%= t("book_search.empty.description") %></p>
      </section>
    <% end %>
    <%= render "book_searches/pagination", query: @query, page: @page, group_id: @group&.id,
               has_previous_page: @has_previous_page, has_next_page: @has_next_page %>
  </div>
<% end %>
