<% if @query.present? %>
  <div class="space-y-5">
    <% if @local_results.any? %>
      <section class="space-y-3" aria-label="<%= t("search_ui.local_results") %>">
        <h2 class="text-lg font-semibold"><%= t("search_ui.local_results") %></h2>
        <% @local_results.each do |book| %>
          <%= render "book_searches/result_card", book: book, bookshelves: @bookshelves, group_id: @group&.id, modal: modal %>
        <% end %>
      </section>
    <% end %>
    <% if @external_search_failed %>
      <p role="status" class="rounded-xl bg-amber-50 p-4 text-sm text-amber-900"><%= t("search_ui.external_unavailable") %></p>
    <% end %>
    <% if @results.any? %>
      <section class="space-y-3">
        <h2 class="text-lg font-semibold"><%= t("book_search.results.title") %></h2>
        <p class="text-sm text-stone-500"><%= t("book_search.results.meta", count: @meta[:pageable_count]) %></p>
        <% @results.each do |book| %>
          <%= render "book_searches/result_card", book: book, bookshelves: @bookshelves, group_id: @group&.id, modal: modal %>
        <% end %>
      </section>
    <% elsif @local_results.empty? && !@external_search_failed %>
      <section class="rounded-2xl border border-stone-200 bg-white p-5">
        <h2 class="font-semibold"><%= t("book_search.empty.title") %></h2>
        <p class="mt-2 text-sm text-stone-500"><%= t("book_search.empty.description") %></p>
      </section>
    <% end %>
    <%= render "book_searches/pagination", query: @query, page: @page, group_id: @group&.id,
               has_previous_page: @has_previous_page, has_next_page: @has_next_page, modal: modal %>
  </div>
<% end %>
