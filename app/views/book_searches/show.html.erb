<% if @recommendation_edit_start %>
  <template data-recommendation-edit-start>
    <%= render "jjaeks/recommendation_panel" %>
  </template>
<% end %>
<section class="mx-auto flex w-full max-w-4xl flex-col gap-6">
  <%= render "shared/back_link", path: (@editing_recommendation ? recommendation_origin_path : (book_search_origin_path || (@group.present? ? group_path(@group) : user_library_path(current_user)))) %>
  <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm">
    <h1 class="text-3xl font-semibold tracking-tight text-stone-900"><%= t(@recommendation_context ? "book_search.results.title" : "book_search.title") %></h1>
    <p class="mt-2 text-sm leading-6 text-stone-500"><%= t(@recommendation_context ? "recommendations.select_description" : "book_search.description") %></p>

    <% if @group.present? %>
      <p class="mt-2 text-sm font-medium text-amber-700"><%= t(@recommendation_context ? "recommendations.group_context" : "groups.jjaeks.book_search_context", group_name: @group.name) %></p>
    <% end %>

    <%= render "book_searches/search_form", query: @query, group_id: @group&.id unless @recommendation_context %>
  </section>

  <% if @recommendation_context %>
    <%= turbo_frame_tag "recommendation-search-results", data: { turbo_action: "advance" } do %>
      <%= render "book_searches/results" %>
    <% end %>
  <% else %>
    <%= render "book_searches/results" %>
  <% end %>
</section>
