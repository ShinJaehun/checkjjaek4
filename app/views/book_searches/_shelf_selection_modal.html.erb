<% dialog_id = "#{book_search_result_dom_id(book)}_shelf_dialog" %>
<div class="min-w-0" data-controller="book-modal"
     data-action="turbo:before-visit@document->book-modal#close turbo:before-cache@document->book-modal#close">
  <button type="button" data-action="book-modal#open" aria-haspopup="dialog" aria-controls="<%= dialog_id %>" class="ui-button ui-button-primary">
    <%= t("book_search.actions.add_to_shelf") %>
  </button>
  <dialog id="<%= dialog_id %>" aria-labelledby="<%= dialog_id %>_title" data-book-modal-target="dialog"
          data-action="close->book-modal#restore" class="m-auto max-h-[90dvh] w-[calc(100%_-_2rem)] max-w-lg overflow-y-auto rounded-3xl bg-white p-6 shadow-xl backdrop:bg-stone-900/40">
    <div class="mb-5 flex items-start justify-between gap-4">
      <h2 id="<%= dialog_id %>_title" class="text-lg font-semibold text-stone-900"><%= t("book_search.actions.add_to_shelf") %></h2>
      <button type="button" data-action="book-modal#close" class="ui-button ui-button-secondary shrink-0"><%= t("bookshelves.actions.close") %></button>
    </div>
    <%= render "book_searches/add_to_shelf_form", book: book, bookshelves: bookshelves, group_id: local_assigns[:group_id], return_path: return_path %>
  </dialog>
</div>
