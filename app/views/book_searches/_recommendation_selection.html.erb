<section data-recommendation-composer-target="selection" <%= "hidden" if @recommendation_step == "writing" %>
         class="min-w-0" aria-label="<%= t("recommendations.selected_books") %>">
  <h3 class="text-sm font-semibold"><%= t("recommendations.selected_count", count: @selected_books.size, max: Jjaek::MAX_RECOMMENDATION_BOOKS) %></h3>
  <% if @selected_books.size >= Jjaek::MAX_RECOMMENDATION_BOOKS %>
    <p class="mt-2 text-sm text-amber-700"><%= t("recommendations.limit_reached", count: Jjaek::MAX_RECOMMENDATION_BOOKS) %></p>
  <% end %>
  <% if @selected_books.empty? %>
    <p class="mt-3 text-sm text-stone-500"><%= t("recommendations.choose_books") %></p>
  <% else %>
    <ul class="mt-2 space-y-1 sm:mt-3 sm:space-y-3">
      <% @selected_books.each_with_index do |book, index| %>
        <li class="flex items-center gap-2 sm:gap-3" data-recommendation-composer-target="book"
            data-book-id="<%= book.id %>" data-isbn="<%= book.canonical_isbn %>" data-url="<%= book.external_url %>">
          <div class="hidden shrink-0 sm:block">
            <%= render "books/thumbnail", title: book.title, thumbnail: book.thumbnail, url: nil, size: :small, link: false %>
          </div>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium max-sm:truncate max-sm:text-xs max-sm:leading-tight sm:break-words sm:[overflow-wrap:anywhere]"><%= book.title %></p>
            <p class="truncate text-[11px] leading-tight text-stone-500 sm:hidden"><%= book.authors_text.presence || "-" %></p>
          </div>
          <%= form_with url: recommendation_book_path(@selected_book_keys[index]), method: :delete,
                        data: { recommendation_selection_form: "remove" },
                        class: "shrink-0" do %>
            <%= hidden_field_tag :group_id, @group.id, id: nil if @group %>
            <%= hidden_field_tag :editing_jjaek_id, @editing_recommendation.id, id: nil if @editing_recommendation %>
            <%= hidden_field_tag :return_to, validated_jjaek_return_path(params[:return_to]), id: nil if @editing_recommendation %>
            <%= hidden_field_tag :query, @query, id: nil %>
            <%= hidden_field_tag :page, @page, id: nil %>
            <%= hidden_field_tag :search_origin, recommendation_origin_path, id: nil if recommendation_origin_path %>
            <% @selected_book_keys.each do |key| %>
              <%= hidden_field_tag "selected_books[]", key, id: nil %>
            <% end %>
            <%= button_tag aria: { label: t("recommendations.remove_book", title: book.title) },
                           class: "ui-button ui-button-secondary max-sm:h-9 max-sm:w-9 max-sm:min-h-9 max-sm:min-w-9 max-sm:p-0" do %>
              <svg class="h-3.5 w-3.5 sm:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M6 6l12 12M6 18L18 6" />
              </svg>
              <span class="hidden sm:inline"><%= t("recommendations.remove") %></span>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

<section data-recommendation-composer-target="writing" <%= "hidden" unless @recommendation_step == "writing" %>
         class="min-w-0 space-y-2" aria-label="<%= t("recommendations.selected_books") %>">
  <h3 class="text-sm font-semibold"><%= t("recommendations.summary_count", count: @selected_books.size) %></h3>
  <p class="text-sm text-stone-600 break-words [overflow-wrap:anywhere]">
    <% if @selected_books.any? %>
      <%= truncate(@selected_books.first.title, length: 48) %>
      <% if @selected_books.size > 1 %>
        <%= t("recommendations.additional_books", count: @selected_books.size - 1) %>
      <% end %>
    <% else %>
      <%= t("recommendations.choose_books") %>
    <% end %>
  </p>
  <button type="button" data-action="recommendation-composer#select" class="ui-button ui-button-secondary"><%= t("recommendations.edit_books") %></button>
</section>
