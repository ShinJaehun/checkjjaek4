<dialog class="m-auto max-h-[90dvh] w-[calc(100%_-_1.5rem)] max-w-3xl overflow-y-auto rounded-3xl border border-stone-200 bg-stone-50 p-4 text-stone-900 shadow-xl backdrop:bg-stone-900/40 sm:p-6"
        aria-labelledby="book-search-dialog-title"
        data-book-search-modal-target="dialog"
        data-action="cancel->book-search-modal#cancel click->book-search-modal#backdrop">
  <div class="mb-4 flex items-center justify-between gap-4">
    <h2 id="book-search-dialog-title" class="text-2xl font-semibold"><%= t("book_search.title") %></h2>
    <button type="button" class="rounded-full border border-stone-300 bg-white px-3 py-2 text-sm" data-action="book-search-modal#close"><%= t("search_ui.close") %></button>
  </div>
  <%= turbo_frame_tag "book_search_modal_results", data: { book_search_modal_target: "frame", action: "turbo:frame-load->book-search-modal#loaded turbo:frame-missing->book-search-modal#missing" } do %>
    <p role="status" class="text-sm text-stone-500"><%= t("search_ui.loading") %></p>
  <% end %>
</dialog>
