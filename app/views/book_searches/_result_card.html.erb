<% return_path = local_assigns.fetch(:return_path) { book_search_return_path } %>
<%= render layout: "book_searches/result_card_layout",
           locals: { book: book, card_id: book_search_result_dom_id(book) } do %>
  <%= link_to t("book_search.actions.open_internal"),
              book_search_result_path(book, group_id: local_assigns[:group_id], return_path: return_path),
              class: "ui-button ui-button-secondary" %>

  <% if book[:bookshelf_entry].present? %>
    <% bookshelf = book[:bookshelf_entry].bookshelf %>
    <button type="button" disabled class="ui-button ui-button-secondary max-w-full break-words text-left">
      <span class="min-w-0 break-words">
        <% if bookshelf.is_default? %>
          <%= t("book_search.actions.in_shelf") %>
        <% else %>
          <%= t("book_search.actions.in_bookshelf", bookshelf_name: bookshelf.name) %>
        <% end %>
      </span>
    </button>
  <% elsif bookshelves.size > 1 %>
    <%= render "book_searches/shelf_selection_modal", book: book, bookshelves: bookshelves, group_id: local_assigns[:group_id], return_path: return_path %>
  <% else %>
    <%= render "book_searches/add_to_shelf_form", book: book, bookshelves: bookshelves, group_id: local_assigns[:group_id], return_path: return_path %>
  <% end %>
<% end %>
