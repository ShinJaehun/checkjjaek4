<article class="min-w-0 rounded-3xl border border-stone-200 bg-white p-3 shadow-sm sm:p-4"
         data-recommendation-result data-book-id="<%= book[:existing_book_id] %>"
         data-isbn="<%= recommendation_result_isbn(book) %>" data-url="<%= book[:url] %>">
  <div class="flex min-w-0 items-start gap-3">
    <%= render "books/thumbnail", title: book[:title], thumbnail: book[:thumbnail],
               url: nil, size: :small, link: false %>
    <div class="min-w-0 flex-1 space-y-3 break-words [overflow-wrap:anywhere]">
      <h3 class="text-base font-semibold text-stone-900"><%= book[:title].presence || t("search_ui.untitled") %></h3>
      <p class="text-sm text-stone-500"><%= [book[:authors_text].presence, book[:publisher].presence].compact.join(" · ") %></p>
      <p class="line-clamp-3 text-sm leading-6 text-stone-700"><%= book[:contents_excerpt] %></p>
    </div>
  </div>
  <div class="mt-3">
    <div data-recommendation-selected <%= "hidden" unless recommendation_result_selected?(book) %>>
      <button type="button" disabled class="ui-button ui-button-secondary max-w-full"><%= t("jjaek_books.selected") %></button>
    </div>
    <div data-recommendation-add <%= "hidden" if recommendation_result_selected?(book) %>>
      <%= form_with url: recommendation_books_path,
                    data: { recommendation_selection_form: "add" },
                    class: "space-y-2" do %>
        <%= render "jjaeks/selection_context" %>
        <% if book[:existing_book_id].present? %>
          <%= hidden_field_tag :book_id, book[:existing_book_id], id: nil %>
        <% else %>
          <%= hidden_field_tag :search_result_token, book[:search_result_token], id: nil %>
        <% end %>
        <%= submit_tag t("jjaek_books.choose"), name: nil, disabled: @selected_books.size >= Jjaek::MAX_RECOMMENDATION_BOOKS,
                       class: "ui-button ui-button-primary max-w-full" %>
      <% end %>
    </div>
  </div>
</article>
