<%= tag.article id: local_assigns[:card_id], data: local_assigns[:card_data],
                class: "min-w-0 rounded-3xl border border-stone-200 bg-white p-5 shadow-sm" do %>
  <div class="flex min-w-0 flex-col gap-4 sm:flex-row">
    <div class="shrink-0">
      <%= render "books/thumbnail",
                 title: book[:title].presence || t("search_ui.untitled"),
                 thumbnail: book[:thumbnail],
                 url: nil,
                 size: :large,
                 link: false %>
    </div>

    <div class="flex min-w-0 flex-1 flex-col gap-3 break-words [overflow-wrap:anywhere]">
      <div class="space-y-2">
        <h3 class="text-lg font-semibold text-stone-900"><%= book[:title].presence || t("search_ui.untitled") %></h3>
        <p class="text-sm text-stone-500"><%= [ book[:authors_text].presence, book[:publisher].presence ].compact.join(" · ").presence || "-" %></p>
        <p class="line-clamp-3 text-sm leading-6 text-stone-700"><%= book[:contents_excerpt].presence || "-" %></p>
      </div>

      <div class="mt-auto flex flex-wrap items-center gap-3 pt-1" data-field="actions">
        <%= yield %>
      </div>
    </div>
  </div>
<% end %>
