<article class="mx-auto w-full max-w-3xl rounded-3xl border border-stone-200 bg-white px-5 py-8 shadow-sm sm:px-10 sm:py-12">
  <header class="border-b border-stone-200 pb-6">
    <h1 class="font-serif text-3xl font-semibold text-stone-950 sm:text-4xl"><%= t("legal.#{@document}.title") %></h1>
    <p class="mt-3 text-sm text-stone-600"><%= t("legal.effective_date", date: @effective_date.iso8601) %></p>
    <p class="mt-5 text-sm leading-7 text-stone-700 sm:text-base"><%= t("legal.#{@document}.intro") %></p>
  </header>

  <div class="space-y-9 pt-8">
    <% t("legal.#{@document}.sections").each do |section| %>
      <section class="space-y-3">
        <h2 class="text-xl font-semibold text-stone-900"><%= section.fetch(:title) %></h2>
        <% section.fetch(:paragraphs).each do |paragraph| %>
          <p class="whitespace-pre-line break-words text-sm leading-7 text-stone-700 sm:text-base"><%= paragraph %></p>
        <% end %>
      </section>
    <% end %>

    <section class="space-y-3 border-t border-stone-200 pt-7">
      <h2 class="text-xl font-semibold text-stone-900"><%= t("legal.contact_title") %></h2>
      <p class="text-sm leading-7 text-stone-700 sm:text-base"><%= t("legal.contact_body") %> <%= mail_to "support@jjaek.kr", "support@jjaek.kr", class: "font-medium underline underline-offset-4" %></p>
    </section>
  </div>
</article>
