<section class="space-y-4">
  <% bookshelves = Array(local_assigns[:bookshelves]) %>
  <% library_tab_options = @library_notes_page_number ? { library_tab: "bookshelves", notes_page: @library_notes_page_number } : {} %>
  <% return_to = "library" %>
  <% bookshelf_entry_counts = local_assigns[:bookshelf_entry_counts] || {} %>
  <% bookshelf_sort = local_assigns[:bookshelf_sort] || "recent" %>
  <% bookshelf_sort_enabled = local_assigns[:show_move_control] && bookshelf_sort == "manual" && selected_bookshelf.present? %>
  <% bookshelf_reorder_available = bookshelf_sort_enabled && bookshelf_entries.any? %>
  <% mobile_reorder_enabled = bookshelf_sort_enabled && bookshelf_entries.size > 1 %>
  <% bookshelf_sort_options = local_assigns[:bookshelf_sort_options] || [] %>
  <% new_bookshelf = local_assigns[:new_bookshelf] %>
  <% managed_bookshelf = local_assigns[:managed_bookshelf] %>
  <% bookshelf_management_modal_mode = local_assigns[:bookshelf_management_modal_mode] %>
  <% bookshelf_order_controls = local_assigns[:bookshelf_order_controls] || {} %>
  <% bookshelf_visibility_options = local_assigns[:bookshelf_visibility_options] || [] %>
  <% bookshelf_color_options = local_assigns[:bookshelf_color_options] || [] %>
  <% empty_message = local_assigns[:empty_message] || t("users.profile.empty_bookshelf") %>

  <% if bookshelves.any? || selected_bookshelf.present? %>
    <div class="space-y-2 md:space-y-0">
  <% end %>

  <% if bookshelves.any? %>
    <%= render "users/libraries/mobile_bookshelf_picker", bookshelves:, selected_bookshelf:, bookshelf_entry_counts:,
               path_for_bookshelf: ->(bookshelf) { user_library_path(user, **library_tab_options, bookshelf_id: bookshelf.id, sort: bookshelf_sort) } %>

    <div class="relative z-10 mx-[calc(0.5rem+1px)] hidden items-center gap-1 md:flex" data-controller="horizontal-scroll">
      <button type="button"
              class="hidden flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-stone-200 bg-white/90 text-xs font-semibold text-stone-500 shadow-sm disabled:opacity-40"
              data-horizontal-scroll-target="previous"
              data-action="horizontal-scroll#scrollLeft"
              disabled
              aria-label="<%= t("users.profile.bookshelf_scroll.previous") %>">
        &lt;
      </button>

      <nav class="relative flex min-w-0 flex-1 items-end gap-1 overflow-x-auto pt-2 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
           data-horizontal-scroll-target="scroller"
           data-action="scroll->horizontal-scroll#updateControls"
           aria-label="<%= t("users.profile.bookshelf_tabs") %>">
        <% bookshelves.each do |bookshelf| %>
          <% selected = bookshelf == selected_bookshelf %>
          <% tab_data = selected ? { horizontal_scroll_target: "selected" } : {} %>
          <%= link_to user_library_path(user, **library_tab_options, bookshelf_id: bookshelf.id, sort: bookshelf_sort),
                      class: [
                        "inline-flex shrink-0 items-center gap-1 whitespace-nowrap rounded-t-xl border-2 px-4 py-2 text-sm font-semibold transition",
                        ("max-w-48" unless selected),
                        (selected ? "relative z-20" : "relative z-0"),
                        bookshelf_tab_class(bookshelf, selected: selected)
                      ].compact,
                      data: tab_data do %>
            <span class="<%= selected ? "whitespace-nowrap" : "min-w-0 truncate" %>"><%= bookshelf.name %></span>
            <span class="shrink-0 <%= bookshelf_tab_count_class(bookshelf, selected: selected) %>">(<%= bookshelf_entry_counts.fetch(bookshelf.id, 0) %>)</span>
          <% end %>
        <% end %>
      </nav>
      <button type="button"
              class="hidden flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-stone-200 bg-white/90 text-xs font-semibold text-stone-500 shadow-sm disabled:opacity-40"
              data-horizontal-scroll-target="next"
              data-action="horizontal-scroll#scrollRight"
              disabled
              aria-label="<%= t("users.profile.bookshelf_scroll.next") %>">
        &gt;
      </button>
    </div>
  <% end %>

  <% if selected_bookshelf.present? %>
    <%# The outer margin, border and inner padding keep the shelf's previous width. %>
    <section class="relative z-0 mx-[calc(0.5rem+1px)] rounded-xl border shadow-sm md:rounded-tl-none <%= bookshelf_selected_border_class(selected_bookshelf) %>"
             aria-labelledby="library-selected-bookshelf-title"
             <% if bookshelf_reorder_available %>
               data-controller="bookshelf-entries-sort"
               data-action="pointerdown->bookshelf-entries-sort#prepareInput:capture mousedown->bookshelf-entries-sort#prepareInput:capture touchstart->bookshelf-entries-sort#prepareInput:capture turbo:before-visit@document->bookshelf-entries-sort#clearSelection turbo:before-cache@document->bookshelf-entries-sort#clearSelection"
               data-bookshelf-entries-sort-bookshelf-id-value="<%= selected_bookshelf.id %>"
               data-bookshelf-entries-sort-reorder-url-value="<%= reorder_bookshelf_entries_path %>"
               data-bookshelf-entries-sort-error-message-value="<%= t('bookshelf_entries.alerts.reorder_failed') %>"
               data-bookshelf-entries-sort-move-up-label-value="<%= t('users.profile.bookshelf_sort.move_up', title: '%{title}') %>"
               data-bookshelf-entries-sort-move-down-label-value="<%= t('users.profile.bookshelf_sort.move_down', title: '%{title}') %>"
             <% end %>>
      <%= render layout: "users/libraries/bookshelf_header", locals: {
        bookshelf: selected_bookshelf, title_id: "library-selected-bookshelf-title",
        bookshelf_entry_count: bookshelf_entry_counts.fetch(selected_bookshelf.id, 0)
      } do %>
        <div class="flex flex-wrap items-center gap-2 sm:shrink-0">
          <% if bookshelf_sort_options.any? %>
            <%= form_with url: user_library_path(user), method: :get, class: "flex flex-wrap items-center gap-2" do |form| %>
              <% library_tab_options.each do |name, value| %>
                <%= form.hidden_field name, value:, id: nil %>
              <% end %>
              <%= form.hidden_field :bookshelf_id, value: selected_bookshelf.id %>

              <%= form.label :sort, t("users.profile.bookshelf_sort.label"), class: "sr-only" %>
              <%= form.select :sort,
                              bookshelf_sort_options.map { |sort| [ t("users.profile.bookshelf_sort.options.#{sort}"), sort ] },
                              { selected: bookshelf_sort },
                              class: "h-11 rounded-xl border border-stone-200 bg-white px-3 text-sm text-stone-700" %>

              <%= form.submit t("users.profile.bookshelf_sort.submit"),
                              class: "ui-button ui-button-secondary h-11" %>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <div class="space-y-3 px-2 pb-2">
        <% if bookshelf_entries.any? %>
          <% book_detail_options = book_navigation_params %>
          <% book_detail_options[:tab] = "reading" if local_assigns[:show_move_control] %>
        <% end %>
        <div class="bookshelf-shelf group"
             <% if bookshelf_reorder_available %>
               data-bookshelf-entries-sort-target="list"
             <% end %>>
          <% bookshelf_entries.each do |bookshelf_entry| %>
            <%= render "bookshelf_entries/shelf_bookshelf_entry",
                       bookshelf_entry:,
                       book_detail_options:,
                       show_status: show_status,
                       removal_params: ({ return_to: "library", bookshelf_id: selected_bookshelf.id, sort: bookshelf_sort, **library_tab_options } if local_assigns[:show_move_control]),
                       show_sort_handle: bookshelf_sort_enabled,
                       enable_mobile_reorder: mobile_reorder_enabled %>
          <% end %>
        </div>
        <% if bookshelf_entries.empty? %>
          <p class="px-1 text-sm text-stone-500"><%= empty_message %></p>
        <% end %>
      </div>
      <% if mobile_reorder_enabled %>
        <div class="md:hidden [@media(pointer:coarse)]:md:block">
          <p id="library-bookshelf-order-hint" class="sr-only"><%= t("users.profile.bookshelf_sort.reorder_keyboard_hint") %></p>
          <div class="hidden h-[calc(env(safe-area-inset-bottom)+4rem)]" aria-hidden="true"
               data-bookshelf-entries-sort-target="spacer"></div>
          <div class="fixed inset-x-0 bottom-0 z-40 hidden border-t border-stone-200 bg-white/95 px-4 pt-2 pb-[calc(env(safe-area-inset-bottom)+0.5rem)] shadow-2xl backdrop-blur"
               role="group" aria-labelledby="library-bookshelf-selected-order"
               data-bookshelf-entries-sort-target="controls" data-action="keydown.esc->bookshelf-entries-sort#clearSelection">
            <div class="mx-auto flex max-w-4xl items-center gap-2">
              <p id="library-bookshelf-selected-order" class="min-w-0 flex-1 truncate text-sm font-semibold text-stone-900"
                 data-bookshelf-entries-sort-target="selectedStatus" role="status"></p>
              <div class="flex shrink-0 items-center gap-1">
                <button type="button" class="ui-button ui-button-secondary h-11 w-11 p-0"
                        data-bookshelf-entries-sort-target="upButton" data-action="bookshelf-entries-sort#moveUp" disabled><span aria-hidden="true">↑</span></button>
                <button type="button" class="ui-button ui-button-secondary h-11 w-11 p-0"
                        data-bookshelf-entries-sort-target="downButton" data-action="bookshelf-entries-sort#moveDown" disabled><span aria-hidden="true">↓</span></button>
                <button type="button" class="ui-button ui-button-secondary h-11 whitespace-nowrap px-3"
                        data-action="bookshelf-entries-sort#clearSelection">
                  <%= t("users.library.transfer.clear_selection") %>
                </button>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </section>
  <% end %>

  <% if bookshelves.any? || selected_bookshelf.present? %>
    </div>
  <% end %>

  <% if local_assigns[:show_create_form] && new_bookshelf.present? %>
    <%= render "users/libraries/bookshelf_management_modal",
               modal_mode: bookshelf_management_modal_mode,
               new_bookshelf: new_bookshelf,
               managed_bookshelf: managed_bookshelf,
               return_to: return_to,
               selected_bookshelf: selected_bookshelf,
               bookshelf_sort: bookshelf_sort,
               bookshelf_visibility_options: bookshelf_visibility_options,
               bookshelf_color_options: bookshelf_color_options,
               bookshelf_order_controls: bookshelf_order_controls,
               bookshelf_entry_counts: bookshelf_entry_counts %>
  <% end %>
</section>
