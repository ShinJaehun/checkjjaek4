<% if current_user == @user %>
  <% content_for :head do %>
    <meta name="turbo-cache-control" content="no-cache">
  <% end %>
<% end %>

<section class="mx-auto flex w-full max-w-4xl flex-col gap-2 md:gap-4"
         data-controller="bookshelf-management-modal"
         data-action="keydown.esc@window->bookshelf-management-modal#close">
  <header class="flex min-w-0 items-center gap-3 rounded-2xl border border-stone-200 bg-white p-4 shadow-sm" data-library-summary>
    <%= user_avatar_image(@user, size: 128, alt: @user.name, class: "h-12 w-12 shrink-0 rounded-full object-cover") %>
    <div class="min-w-0">
      <h1 class="truncate text-2xl font-semibold tracking-tight text-stone-900"><%= t("users.library.title_with_name", name: @user.name) %></h1>
      <% if current_user != @user %>
        <p class="mt-1 text-sm text-stone-500"><%= t("users.library.book_friend_read_only_notice") %></p>
      <% end %>
    </div>
  </header>

  <% if current_user == @user %>
    <% library_options = { bookshelf_id: @selected_bookshelf&.id, sort: @profile_bookshelf_sort, notes_page: @library_notes_page_number }.compact %>
    <% tab_classes = "ui-button ui-button-secondary flex-1 aria-[current=page]:border-emerald-700 aria-[current=page]:bg-emerald-50 aria-[current=page]:text-emerald-900" %>
    <nav class="flex gap-2" aria-label="<%= t("users.library.tabs.label") %>" data-library-tabs>
      <%= link_to t("users.library.tabs.bookshelves"), user_library_path(@user, **library_options, library_tab: "bookshelves"),
                  class: tab_classes, aria: { current: ("page" unless @library_book_note_page) } %>
      <%= link_to t("book_notes.heading"), user_library_path(@user, **library_options, library_tab: "notes"),
                  class: tab_classes, aria: { current: ("page" if @library_book_note_page) },
                  data: { library_notes_link: true } %>
    </nav>
  <% end %>

  <% if @library_book_note_page %>
    <%= render "book_notes/library_section", page: @library_book_note_page, library_options: library_options.except(:notes_page) %>
  <% elsif @show_bookshelf %>
    <section id="library-bookshelves" class="space-y-4">
      <% if @show_profile_bookshelf_create_form %>
        <div class="flex flex-wrap gap-2">
          <button type="button" class="ui-button ui-button-primary" aria-haspopup="dialog" aria-controls="global-book-search-dialog"
                  data-action="book-modal#open"><%= t("book_search.nav") %></button>
          <button type="button" class="ui-button ui-button-secondary" aria-haspopup="dialog" aria-controls="library-bookshelf-management-dialog"
                  data-action="bookshelf-management-modal#openCreate"><%= t("bookshelves.actions.new") %></button>
          <%= link_to t("bookshelves.form.manage_title"),
                      transfer_user_library_path(@user, source_bookshelf_id: @selected_bookshelf&.id),
                      class: "ui-button ui-button-secondary" %>
        </div>
      <% end %>

      <%= render "users/bookshelf_section",
                 user: @user,
                 bookshelves: @profile_bookshelves,
                 selected_bookshelf: @selected_bookshelf,
                 bookshelf_entries: @bookshelf_entries,
                 bookshelf_entry_counts: @profile_bookshelf_entry_counts,
                 bookshelf_sort: @profile_bookshelf_sort,
                 bookshelf_sort_options: @profile_bookshelf_sort_options,
                 show_status: @show_profile_bookshelf_status,
                 show_move_control: @show_profile_bookshelf_move_control,
                 show_create_form: @show_profile_bookshelf_create_form,
                 new_bookshelf: @bookshelf,
                 managed_bookshelf: @managed_bookshelf,
                 bookshelf_management_modal_mode: @bookshelf_management_modal_mode,
                 bookshelf_order_controls: @profile_bookshelf_order_controls,
                 bookshelf_visibility_options: @profile_bookshelf_visibility_options,
                 bookshelf_color_options: @profile_bookshelf_color_options,
                 bookshelf_view: "detail" %>
    </section>
  <% end %>
</section>
