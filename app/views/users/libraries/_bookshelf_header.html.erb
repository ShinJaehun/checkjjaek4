<%= tag.header class: "flex flex-col gap-3 rounded-t-xl px-4 py-4 sm:flex-row sm:items-end sm:justify-between md:rounded-tl-none #{bookshelf_header_class(bookshelf)}",
               data: local_assigns[:header_data] do %>
  <div class="min-w-0 space-y-1">
    <div class="flex flex-wrap items-baseline gap-x-2">
      <%= tag.h2 bookshelf.name, id: title_id, class: "min-w-0 break-words text-xl font-semibold text-stone-900",
                 aria: { label: local_assigns[:title_label] } %>
      <span class="shrink-0 text-sm text-stone-600" data-bookshelf-book-count><%= t("reading_experience.book_count", count: bookshelf_entry_count) %></span>
    </div>
    <%= bookshelf_visibility_badge(bookshelf) %>
  </div>
  <%= yield if block_given? %>
<% end %>
