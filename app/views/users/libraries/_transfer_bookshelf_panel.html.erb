<%
  panel_role = local_assigns.fetch(:panel_role)
  target_panel = panel_role == :target
  title_id = "library-transfer-#{panel_role}-title"
  title_label = "#{t("users.library.transfer.#{panel_role}_label")}, #{bookshelf.name}"
  if target_panel
    header_data = {
      bookshelf_transfer_target: "append",
      bookshelf_transfer_bookshelf_id: bookshelf.id,
      action: "dragover->bookshelf-transfer#dragoverAppend drop->bookshelf-transfer#dropOnAppend"
    }
  end
  book_detail_options = book_navigation_params
  unless @organizing_bookshelf
    removal_params = {
      return_to: "library_transfer",
      bookshelf_id: bookshelf.id,
      source_bookshelf_id: (target_panel ? paired_bookshelf : bookshelf).id,
      target_bookshelf_id: (target_panel ? bookshelf : paired_bookshelf).id
    }
  end
%>

<section class="mt-2 animate-[fade-slide-in_180ms_ease-out] space-y-0">
  <div class="relative z-10 mx-[calc(0.25rem+1px)] hidden md:block">
    <nav class="flex items-end gap-1 overflow-x-auto pt-1 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
         aria-label="<%= t("users.library.transfer.#{@organizing_bookshelf ? 'mobile_source_label' : "choose_#{panel_role}"}") %>">
      <% bookshelves.each do |candidate| %>
        <% selected = candidate == bookshelf %>
        <% path =
          if target_panel
            transfer_path_for(source_bookshelf: paired_bookshelf, target_bookshelf: candidate, changed: "target")
          else
            transfer_path_for(source_bookshelf: candidate, target_bookshelf: paired_bookshelf, changed: "source")
          end %>

        <%= link_to path,
                    class: [
                      "inline-flex shrink-0 items-center gap-1 whitespace-nowrap rounded-t-xl border-2 px-4 py-1.5 text-sm font-semibold transition",
                      ("max-w-48" unless selected),
                      (selected ? "relative z-20" : "relative z-0"),
                      bookshelf_tab_class(candidate, selected: selected)
                    ].compact do %>
          <span class="<%= selected ? "whitespace-nowrap" : "min-w-0 truncate" %>"><%= candidate.name %></span>
          <span class="shrink-0 <%= bookshelf_tab_count_class(candidate, selected: selected) %>">(<%= bookshelf_entry_counts.fetch(candidate.id, 0) %>)</span>
        <% end %>
      <% end %>
    </nav>
  </div>

  <%# The outer margin replaces the removed border and padding so the shelf width stays the same. %>
  <section class="relative z-0 mx-[calc(0.25rem+1px)] rounded-xl border shadow-sm md:rounded-tl-none <%= bookshelf_selected_border_class(bookshelf) %>"
           aria-labelledby="<%= title_id %>">
    <%= render "users/libraries/bookshelf_header", bookshelf:, title_id:, title_label:, header_data:,
               bookshelf_entry_count: bookshelf_entry_counts.fetch(bookshelf.id, 0) %>

    <div class="px-2 pb-2">
      <div class="bookshelf-shelf"
           data-bookshelf-transfer-target="list"
           data-bookshelf-transfer-bookshelf-id="<%= bookshelf.id %>"
           data-bookshelf-transfer-list-role="<%= panel_role %>">
        <% bookshelf_entries.each do |bookshelf_entry| %>
          <%= render "bookshelf_entries/shelf_bookshelf_entry",
                     bookshelf_entry:,
                     book_detail_options:,
                     show_status: true,
                     show_sort_handle: !@organizing_bookshelf,
                     removal_params:,
                     show_transfer_selection: !target_panel %>
        <% end %>
      </div>

      <% if bookshelf_entries.empty? %>
        <p class="mt-3 px-1 text-sm text-stone-500">
          <%= t("users.library.empty_bookshelf_preview") %>
        </p>
      <% end %>
    </div>
  </section>
</section>
