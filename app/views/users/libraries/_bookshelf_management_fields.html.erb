<% if bookshelf.errors.any? %>
  <div class="rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
    <%= form_error_messages(bookshelf.errors.full_messages) %>
  </div>
<% end %>

<div>
  <%= form.label :name, t("bookshelves.form.name"), class: "block text-xs font-medium text-stone-500" %>
  <% name_options = { class: "mt-1 w-full rounded-xl border border-stone-200 px-3 py-2 text-sm text-stone-900" } %>
  <% name_options[:placeholder] = t("bookshelves.form.name_placeholder") if mode == :create %>
  <%= form.text_field :name,
                      **name_options %>
</div>

<fieldset class="min-w-0 space-y-2">
  <legend class="text-sm font-medium text-stone-700"><%= t("bookshelves.form.visibility") %></legend>
  <% visibility_icons = { "public" => "public_jjaek", "private" => "private_jjaek" } %>
  <div class="grid gap-2 sm:grid-cols-3">
    <% bookshelf_visibility_options.each do |visibility| %>
      <label class="<%= jjaek_option_card_classes %>">
        <%= form.radio_button :visibility, visibility, id: "bookshelf_#{mode}_visibility_#{visibility}", required: true, class: "sr-only" %>
        <%= jjaek_option_icon(visibility_icons.fetch(visibility, visibility)) %>
        <span class="min-w-0 break-words"><%= t("bookshelves.visibility.#{visibility}") %></span>
      </label>
    <% end %>
  </div>
</fieldset>

<div>
  <%= form.label :color_key, t("bookshelves.form.color_key"), class: "block text-xs font-medium text-stone-500" %>
  <div class="mt-2 flex flex-wrap gap-2">
    <% bookshelf_color_options.each do |color_key| %>
      <% color_name = t("bookshelves.color_keys.#{color_key}") %>
      <% radio_id = "bookshelf_#{mode}_color_key_#{color_key}" %>
      <%= label_tag radio_id, class: "inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center", title: color_name do %>
        <%= form.radio_button :color_key, color_key, id: radio_id, class: "peer sr-only" %>
        <span class="block h-7 w-7 rounded-full border <%= color_swatch_classes.fetch(color_key, "border-stone-300 bg-stone-300") %> ring-offset-2 peer-checked:ring-2 peer-checked:ring-stone-900 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-4 peer-focus-visible:outline-stone-900">
          <span class="sr-only"><%= color_name %></span>
        </span>
      <% end %>
    <% end %>
  </div>
</div>
