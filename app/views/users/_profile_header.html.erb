<section id="profile-header" class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-4">
      <%= user_avatar_image(user, size: 512, alt: user.name, class: "h-24 w-24 shrink-0 rounded-2xl object-cover") %>

      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-stone-900"><%= user.name %></h1>
        <p class="mt-3 text-sm text-stone-500"><%= t("users.profile.stats", followers: user.followers.count, following: user.followees.count) %></p>
      </div>
    </div>

    <% if user == current_user %>
      <div class="flex flex-wrap items-center gap-2">
        <%= link_to t("relationships.nav"), account_relationships_path,
                    class: "rounded-full border border-stone-300 px-3 py-1.5 text-sm font-medium text-stone-700" %>
        <%= link_to t("settings.nav"), account_settings_path,
                    class: "rounded-full border border-stone-300 px-3 py-1.5 text-sm font-medium text-stone-700" %>
      </div>
    <% elsif !user.withdrawn? %>
      <div class="flex flex-wrap items-center gap-3">
        <% follow_button = profile_follow_button_options(user) %>
        <% if follow_button %>
          <%= button_to follow_button[:label], follow_button[:path], method: follow_button[:method], class: follow_button[:class_name] %>
        <% end %>

        <% book_friend_button = profile_book_friend_button_options(user, book_friendship) %>
        <% if book_friend_button %>
          <%= button_to book_friend_button[:label], book_friend_button[:path], method: book_friend_button[:method], class: book_friend_button[:class_name] %>
        <% end %>

        <% if invitable_private_groups.any? || cancelable_private_group_invitations.any? %>
          <%= render "users/private_group_invitation", user:, groups: invitable_private_groups,
                                                       cancelable_invitations: cancelable_private_group_invitations %>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
