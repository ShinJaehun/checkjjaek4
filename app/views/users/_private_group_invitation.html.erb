<% if groups.one? %>
  <% group = groups.first %>
  <%= button_to t("users.profile.invite_to_group", group_name: group.name),
                invite_group_group_memberships_path(group),
                params: { user_id: user.id, return_context: "profile" },
                class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-800 hover:bg-stone-50" %>
<% else %>
  <details class="relative">
    <summary class="cursor-pointer rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-800 hover:bg-stone-50">
      <%= t("users.profile.invite_to_group_menu") %>
    </summary>
    <div class="absolute right-0 z-10 mt-2 min-w-48 space-y-1 rounded-2xl border border-stone-200 bg-white p-2 shadow-lg">
      <% groups.each do |group| %>
        <%= button_to group.name,
                      invite_group_group_memberships_path(group),
                      params: { user_id: user.id, return_context: "profile" },
                      class: "w-full rounded-xl px-3 py-2 text-left text-sm text-stone-800 hover:bg-stone-50" %>
      <% end %>
    </div>
  </details>
<% end %>
