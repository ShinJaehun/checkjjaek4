<section class="space-y-4">
  <div>
    <h2 class="text-2xl font-semibold tracking-tight text-stone-900"><%= t("users.profile.activity_title") %></h2>
  </div>

  <%= render "feeds/list", page: @feed_page, context: :profile, profile_user: user,
             next_url: @feed_page&.next_cursor && user_path(user, cursor: @feed_page.next_cursor),
             empty_text: t("users.profile.empty_activity") %>
</section>
