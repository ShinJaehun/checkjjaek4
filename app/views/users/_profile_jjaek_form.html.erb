<section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm">
  <%= form_with model: profile_jjaek, class: "space-y-4" do |form| %>
    <%= hidden_field_tag :return_to, jjaek_navigation_params[:return_to] if jjaek_navigation_params[:return_to] %>
    <%= form.hidden_field :target_user_id %>

    <fieldset class="space-y-2">
      <legend class="text-sm font-medium text-stone-700"><%= t("jjaeks.form.visibility") %></legend>
      <div class="grid gap-2 sm:grid-cols-2">
        <% profile_jjaek_visibility_options.each do |visibility| %>
          <label class="<%= jjaek_option_card_classes %>">
            <%= form.radio_button :visibility, visibility, required: true, class: "sr-only" %>
            <%= jjaek_option_icon(visibility) %>
            <span><%= t("jjaeks.visibility.#{visibility}") %></span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <%= render "shared/content_field", form: form, label_key: "jjaeks.form.jjaek_content", rows: 4 %>

    <%= form.submit t("jjaeks.actions.publish_short"), class: "ui-button ui-button-primary" %>
  <% end %>
</section>
