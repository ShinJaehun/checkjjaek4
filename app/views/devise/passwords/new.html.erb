<%= render layout: "devise/shared/auth_layout" do %>
  <h1 class="text-center text-2xl font-semibold text-stone-900"><%= t("auth.passwords.request_title") %></h1>
  <p class="mt-4 text-sm text-stone-700"><%= t("auth.passwords.request_description") %></p>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { class: "mt-8 space-y-4", data: { turbo: false } }) do |form| %>
    <div class="space-y-2">
      <%= form.label :email, t("auth.form.email"), class: "text-sm font-medium text-stone-700" %>
      <%= form.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "w-full rounded-2xl border border-stone-300 px-4 py-3 text-sm bg-white" %>
    </div>

    <%= form.submit t("auth.passwords.send_instructions"), class: "ui-button ui-button-primary w-full" %>
  <% end %>

  <p class="mt-6 text-sm text-stone-500">
    <%= link_to t("auth.actions.sign_in"), new_user_session_path, class: "font-medium text-stone-900" %>
  </p>
<% end %>
