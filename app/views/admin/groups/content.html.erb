<section id="admin_group_content" class="relative left-1/2 w-[95vw] max-w-none -translate-x-1/2 space-y-5">
  <section id="admin_group_activity_identity" class="mx-auto max-w-5xl rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-5">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-stone-900"><%= @group.name %></h1>
        <div class="mt-3 flex flex-wrap gap-2">
          <span class="rounded-full px-2 py-1 text-xs font-medium <%= admin_group_type_badge_classes(@group) %>" data-group-type="<%= @group.group_type %>">
            <%= t("admin.groups.types.#{@group.group_type}") %>
          </span>
          <span class="rounded-full px-2 py-1 text-xs <%= admin_group_status_badge_classes(@group) %>" data-field="current-status">
            <%= admin_group_current_status(@group) %>
          </span>
        </div>
        <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-stone-500">
          <span><%= t("admin.groups.fields.group_admin") %>: <%= @group.group_admin.name %></span>
          <span><%= t("admin.groups.fields.created") %>: <%= l(@group.created_at, format: :short) %></span>
        </div>
      </div>
      <div class="flex flex-wrap gap-2">
        <%= link_to t("admin.groups.actions.show"),
                    admin_group_path(@group, @return_params),
                    class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
        <%= link_to t("admin.groups.actions.back"),
                    admin_groups_path(@return_params),
                    class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
      </div>
    </div>
  </section>

  <section id="admin_group_activity_controls" class="mx-auto max-w-5xl space-y-5 rounded-3xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
    <header class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 class="text-2xl font-semibold text-stone-900"><%= t("admin.group_content.title") %></h2>
        <p class="mt-1 text-sm text-stone-500"><%= t("admin.group_content.description") %></p>
      </div>
      <span class="text-sm font-medium text-stone-500"><%= t("admin.group_content.total_count", count: @timeline_page.total_count) %></span>
    </header>

    <div class="flex flex-wrap items-center gap-3">
      <span class="w-16 text-sm font-semibold text-stone-600"><%= t("admin.group_content.navigation_label") %></span>
      <nav class="inline-flex flex-wrap gap-1 rounded-xl bg-stone-100 p-1" aria-label="<%= t('admin.group_content.navigation_label') %>">
        <% %w[all general book comments].each do |section| %>
          <% selected = @content_section == section %>
          <%
            classes = if selected
              "rounded-lg bg-white px-3 py-1.5 text-sm font-medium text-stone-900 shadow-sm"
            else
              "rounded-lg px-3 py-1.5 text-sm font-medium text-stone-600 hover:bg-white/70"
            end
          %>
          <%= link_to t("admin.group_content.navigation.#{section}"),
                      content_admin_group_path(
                        @group,
                        @return_params.merge(@content_filter_params).merge(content: section)
                      ),
                      class: classes,
                      aria: { current: ("page" if selected) } %>
        <% end %>
      </nav>
    </div>

    <%= form_with url: content_admin_group_path(@group),
                  method: :get,
                  class: "flex flex-col gap-3 border-t border-stone-200 pt-4 lg:flex-row lg:items-center" do |f| %>
      <%= f.hidden_field :content, value: @content_section %>
      <% @return_params.each do |key, value| %>
        <%= hidden_field_tag key, value %>
      <% end %>
      <%= f.search_field :content_q,
                         value: params[:content_q],
                         placeholder: t("admin.group_content.filters.search"),
                         class: "min-w-0 rounded-xl border border-stone-200 px-3 py-2 lg:flex-1" %>
      <%= f.select :content_status,
                   options_for_select(
                     [
                       [t("admin.user_content.filters.all"), ""],
                       [t("admin.user_content.statuses.active"), "active"],
                       [t("admin.user_content.statuses.hidden"), "hidden"],
                       [t("admin.user_content.statuses.deleted"), "deleted"]
                     ],
                     params[:content_status]
                   ),
                   {},
                   class: "rounded-xl border border-stone-200 px-3 py-2",
                   aria: { label: t("admin.user_content.fields.status") } %>
      <%= f.select :content_sort,
                   options_for_select(
                     [
                       [t("admin.user_content.sorts.recent"), "recent"],
                       [t("admin.user_content.sorts.oldest"), "oldest"]
                     ],
                     params[:content_sort]
                   ),
                   {},
                   class: "rounded-xl border border-stone-200 px-3 py-2" %>
      <%= f.submit t("admin.group_content.filters.apply"),
                   class: "whitespace-nowrap rounded-xl bg-stone-900 px-4 py-2 font-medium text-white hover:bg-stone-800" %>
      <%= link_to t("admin.group_content.filters.reset"),
                  content_admin_group_path(@group, @return_params.merge(content: @content_section)),
                  class: "whitespace-nowrap px-2 py-2 text-sm font-medium text-stone-600 hover:text-stone-900 hover:underline" %>
    <% end %>
  </section>

  <%= render "admin/groups/content_timeline",
             timeline_items: @timeline_items,
             page: @timeline_page %>
</section>
