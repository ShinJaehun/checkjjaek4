<section id="admin_group_content_timeline" class="space-y-5">
  <%= form_with url: admin_group_path(group),
                method: :get,
                class: "flex flex-col gap-3 rounded-2xl border bg-white p-4 lg:flex-row lg:items-center" do |f| %>
    <%= f.hidden_field :content, value: content_section %>
    <% return_params.each do |key, value| %>
      <%= hidden_field_tag key, value %>
    <% end %>
    <%= f.search_field :content_q,
                       value: params[:content_q],
                       placeholder: t("admin.group_content.filters.search"),
                       class: "min-w-0 rounded border p-2 lg:flex-1" %>
    <%= f.select :content_status,
                 options_for_select(
                   [
                     [t("admin.user_content.filters.all"), ""],
                     [t("admin.user_content.statuses.active"), "active"],
                     [t("admin.user_content.statuses.deleted"), "deleted"]
                   ],
                   params[:content_status]
                 ),
                 {},
                 class: "rounded border p-2",
                 aria: { label: t("admin.user_content.fields.status") } %>
    <%= f.select :content_sort,
                 options_for_select(
                   [
                     [t("admin.user_content.sorts.recent"), "recent"],
                     [t("admin.user_content.sorts.oldest"), "oldest"]
                   ],
                   params[:content_sort]
                 ),
                 {},
                 class: "rounded border p-2" %>
    <%= f.submit t("admin.user_content.filters.apply"),
                 class: "whitespace-nowrap rounded bg-stone-900 p-2 text-white" %>
    <%= link_to t("admin.user_content.filters.reset"),
                admin_group_path(group, return_params.merge(content: content_section)),
                class: "whitespace-nowrap p-2 underline" %>
  <% end %>

  <div class="overflow-x-auto rounded-2xl border bg-white">
    <table class="min-w-full text-sm">
      <thead>
        <tr class="border-b text-left">
          <th class="p-3 whitespace-nowrap"><%= t("admin.user_content.fields.kind") %></th>
          <th class="min-w-36 p-3 whitespace-nowrap"><%= t("admin.group_content.fields.author") %></th>
          <th class="min-w-80 p-3"><%= t("admin.user_content.fields.body") %></th>
          <th class="min-w-80 p-3"><%= t("admin.user_content.fields.reference") %></th>
          <th class="p-3 whitespace-nowrap"><%= t("admin.user_content.fields.status") %></th>
          <th class="p-3 whitespace-nowrap"><%= t("admin.user_content.fields.created") %></th>
          <th class="p-3 whitespace-nowrap"><%= t("admin.user_content.fields.actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% timeline_items.each do |item| %>
          <% record = item.record %>
          <% source_jjaek = record.jjaek if item.record_type == "Comment" %>
          <%
            body = if item.record_type == "Jjaek" && record.deleted?
              "-"
            else
              truncate(record.content.to_s, length: 220).presence || "-"
            end
          %>
          <tr id="group_timeline_<%= item.record_type.downcase %>_<%= record.id %>"
              class="border-b align-middle"
              data-content-kind="<%= item.kind %>">
            <td class="p-3 align-middle whitespace-nowrap">
              <span class="whitespace-nowrap rounded-full bg-stone-100 px-2 py-1 text-xs text-stone-700">
                <%= t("admin.user_content.kinds.#{item.kind}") %>
              </span>
            </td>
            <td class="p-3 align-middle" data-field="author">
              <%= link_to record.user.name,
                          admin_user_path(record.user),
                          class: "text-stone-700 underline" %>
            </td>
            <td class="p-3 align-middle leading-6" data-field="body"><%= body %></td>
            <td class="p-3 align-middle leading-6" data-field="reference">
              <% if item.kind == "general" %>
                -
              <% elsif item.kind == "book" %>
                <% if !record.deleted? && record.book %>
                  <span class="text-stone-500"><%= t("admin.user_content.references.book") %> ·</span>
                  <%= link_to record.book.title,
                              book_path(record.book),
                              class: "text-stone-700 underline" %>
                <% else %>
                  -
                <% end %>
              <% elsif source_jjaek %>
                <p>
                  <span class="text-stone-500"><%= t("admin.user_content.references.source") %> ·</span>
                  <%= link_to source_jjaek.user.name,
                              admin_user_path(source_jjaek.user),
                              class: "text-stone-700 underline" %>
                </p>
                <p class="mt-1 text-stone-500">
                  <%= truncate(source_jjaek.content.to_s, length: 220).presence || "-" %>
                </p>
              <% else %>
                -
              <% end %>
            </td>
            <td class="p-3 align-middle whitespace-nowrap" data-field="status">
              <% if item.record_type == "Jjaek" && record.deleted? %>
                <span class="rounded-full bg-stone-200 px-2 py-1 text-xs text-stone-700">
                  <%= t("admin.user_content.statuses.deleted") %>
                </span>
              <% end %>

              <% if item.record_type == "Jjaek" && record.hidden? %>
                <span class="rounded-full bg-red-100 px-2 py-1 text-xs text-red-800">
                  <%= t("admin.user_content.statuses.hidden") %>
                </span>
              <% else %>
                <% unless item.record_type == "Jjaek" && record.deleted? %>
                  -
                <% end %>
              <% end %>
            </td>
            <td class="p-3 align-middle whitespace-nowrap"><%= l(record.created_at, format: :short) %></td>
            <td class="p-3 align-middle whitespace-nowrap" data-field="actions">
              <% if item.record_type == "Comment" %>
                <%= link_to t("admin.user_content.actions.direct"),
                            jjaek_path(record.jjaek, anchor: dom_id(record)),
                            class: "text-stone-700 underline" %>
              <% else %>
                <%= link_to t("admin.user_content.actions.direct"),
                            jjaek_path(record),
                            class: "text-stone-700 underline" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if timeline_items.empty? %>
      <p class="p-6 text-center"><%= t("admin.group_content.empty") %></p>
    <% end %>
  </div>

  <%= render "admin/shared/pagination", page: page, page_param: :all_page %>
</section>
