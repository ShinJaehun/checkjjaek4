<section id="admin_group_content_timeline" class="space-y-5">
  <div class="overflow-x-auto rounded-3xl border border-stone-200 bg-white shadow-sm">
    <table class="min-w-full text-sm">
      <thead class="bg-stone-50/80 text-xs font-semibold text-stone-500">
        <tr class="border-b border-stone-200 text-left">
          <th class="px-4 py-3 whitespace-nowrap"><%= t("admin.user_content.fields.kind") %></th>
          <th class="min-w-36 px-4 py-3 whitespace-nowrap"><%= t("admin.group_content.fields.author") %></th>
          <th class="min-w-80 px-4 py-3"><%= t("admin.user_content.fields.body") %></th>
          <th class="min-w-80 px-4 py-3"><%= t("admin.user_content.fields.reference") %></th>
          <th class="px-4 py-3 whitespace-nowrap"><%= t("admin.user_content.fields.status") %></th>
          <th class="px-4 py-3 whitespace-nowrap"><%= t("admin.user_content.fields.created") %></th>
          <th class="px-4 py-3 whitespace-nowrap"><%= t("admin.user_content.fields.actions") %></th>
        </tr>
      </thead>

      <% threads.each do |thread| %>
        <tbody class="border-t-2 border-stone-300 first:border-t-0" data-thread-id="<%= thread.root.id %>">
          <% thread.comments.each do |comment| %>
            <%= render "admin/groups/content_timeline_row",
                       record: comment,
                       root: thread.root,
                       record_type: "Comment",
                       kind: "comments" %>
          <% end %>

          <%= render "admin/groups/content_timeline_row",
                     record: thread.root,
                     root: thread.root,
                     record_type: "Jjaek",
                     kind: thread.root.book_id.present? ? "book" : "general" %>
        </tbody>
      <% end %>
    </table>

    <% if threads.empty? %>
      <p class="p-6 text-center"><%= t("admin.group_content.empty") %></p>
    <% end %>
  </div>

  <%= render "shared/pagination", page: page, page_param: :all_page %>
</section>
