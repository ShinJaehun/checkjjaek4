<%
  root_row = record_type == "Jjaek"
  kind_key = admin_content_kind_key(kind, context: :group)
%>

<tr id="group_timeline_<%= record_type.downcase %>_<%= record.id %>"
    class="border-b border-stone-100 align-middle hover:bg-stone-50/60 last:border-b-0"
    data-content-kind="<%= kind %>"
    data-thread-row="<%= root_row ? 'root' : 'comment' %>">
  <td class="<%= root_row ? 'py-3.5 pr-4 pl-6' : 'px-4 py-3.5' %> align-middle whitespace-nowrap">
    <span class="whitespace-nowrap rounded-full px-2 py-1 text-xs font-medium <%= admin_content_kind_badge_classes(kind_key) %>" data-activity-kind="<%= kind %>">
      <%= admin_content_kind_label(kind_key) %>
    </span>
  </td>
  <td class="px-4 py-3.5 align-middle" data-field="author">
    <div class="flex items-center gap-2">
      <%= user_avatar_image(record.user,
                            size: 128,
                            alt: record.user.name,
                            class: "h-8 w-8 shrink-0 rounded-full object-cover") %>
      <%= link_to record.user.name,
                  admin_user_path(record.user),
                  class: "text-sm font-medium text-stone-800 hover:underline" %>
    </div>
  </td>
  <td class="px-4 py-3.5 align-middle leading-6 text-stone-800" data-field="body"><%= admin_content_body(record, record_type: record_type) %></td>
  <td class="px-4 py-3.5 align-middle leading-6" data-field="reference">
    <% if root_row && kind == "book" && !record.deleted? && record.book %>
      <span class="text-stone-500"><%= t("admin.user_content.references.book") %> ·</span>
      <%= link_to record.book.title,
                  book_path(record.book),
                  class: "text-stone-700 underline" %>
    <% end %>
  </td>
  <td class="px-4 py-3.5 align-middle whitespace-nowrap" data-field="status">
    <%= content_status_badge(admin_content_status(record, record_type: record_type)) %>
  </td>
  <td class="px-4 py-3.5 align-middle whitespace-nowrap"><%= l(record.created_at, format: :short) %></td>
  <td class="px-4 py-3.5 align-middle whitespace-nowrap" data-field="actions">
    <% if root_row %>
      <%= link_to t("admin.user_content.actions.direct"),
                  jjaek_path(root, jjaek_navigation_params),
                  class: "ui-button ui-button-secondary" %>
    <% else %>
      <%= link_to t("admin.user_content.actions.direct"),
                  jjaek_path(root, jjaek_navigation_params.merge(anchor: dom_id(record))),
                  class: "ui-button ui-button-secondary" %>
    <% end %>
  </td>
</tr>
