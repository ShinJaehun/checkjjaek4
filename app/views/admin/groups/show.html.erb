<section class="relative left-1/2 w-[95vw] max-w-none -translate-x-1/2 space-y-10">
  <div class="flex w-full max-w-4xl flex-col gap-6">
    <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <p class="text-sm font-medium text-amber-700">
            <%= @group.active? && @group.operation_suspended? ? t("groups.operation_suspension.label") : t("groups.lifecycle_statuses.#{@group.lifecycle_status}") %>
          </p>
          <h1 class="mt-2 text-3xl font-semibold tracking-tight text-stone-900"><%= @group.name %></h1>
          <p class="mt-2 text-sm text-stone-500"><%= t("groups.types.#{@group.group_type}") %> · <%= t("groups.group_admin", name: @group.group_admin.name) %></p>
        </div>
        <div class="flex flex-wrap gap-2">
          <%= link_to t("groups.members.management_title"),
                      group_members_path(@group),
                      class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
          <% if policy(@group).approve? %>
            <%= button_to t("admin.groups.actions.approve"),
                          approve_admin_group_path(@group),
                          method: :patch,
                          class: "rounded-full bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
          <% end %>
        </div>
      </div>

      <% if @group.description.present? %>
        <p class="mt-5 whitespace-pre-wrap text-sm leading-6 text-stone-700"><%= @group.description %></p>
      <% end %>

      <% unless @lifecycle_events.any?(&:opening_requested?) %>
        <div class="mt-5 rounded-2xl bg-amber-50 p-4">
          <p class="text-xs font-semibold text-amber-800"><%= t("groups.lifecycle_history.labels.application_purpose") %></p>
          <p class="mt-2 whitespace-pre-wrap text-sm text-stone-700"><%= @group.application_purpose.presence || t("admin.groups.application_purpose_missing") %></p>
        </div>
      <% end %>

      <% if @group.closed_at.present? && @lifecycle_events.none?(&:operations_closed?) %>
        <div class="mt-4 rounded-2xl bg-stone-50 p-4">
          <p class="text-xs font-semibold text-stone-600"><%= t("admin.groups.previous_closure") %></p>
          <p class="mt-2 text-sm text-stone-600"><%= l(@group.closed_at, format: :short) %></p>
          <p class="mt-2 whitespace-pre-wrap text-sm text-stone-700"><%= @group.closure_reason.presence || t("admin.groups.closure_reason_missing") %></p>
        </div>
      <% end %>

      <% if @current_operation_suspension.present? %>
        <div class="mt-5 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-900">
          <p class="font-semibold"><%= t("groups.operation_suspension.status") %></p>
          <p class="mt-2 whitespace-pre-wrap"><%= t("group_memberships.moderation.public_reason") %>: <%= @current_operation_suspension.public_reason %></p>
          <% if @current_operation_suspension.internal_note.present? %>
            <p class="mt-2 whitespace-pre-wrap"><%= t("group_memberships.moderation.internal_note") %>: <%= @current_operation_suspension.internal_note %></p>
          <% end %>
        </div>
      <% end %>

      <% if policy(@group).suspend_operation? %>
        <%= form_with url: suspend_operation_admin_group_path(@group), method: :patch, scope: :moderation_action, class: "mt-5 space-y-3 rounded-2xl bg-stone-50 p-4" do |form| %>
          <%= form.label :public_reason, t("admin.groups.operation_moderation.reason"), class: "block text-sm font-medium text-stone-700" %>
          <%= form.text_area :public_reason, rows: 2, required: true, class: "w-full rounded-xl border border-stone-300 bg-white px-3 py-2 text-sm" %>
          <%= form.label :internal_note, t("group_memberships.moderation.internal_note"), class: "block text-sm font-medium text-stone-700" %>
          <%= form.text_area :internal_note, rows: 2, class: "w-full rounded-xl border border-stone-300 bg-white px-3 py-2 text-sm" %>
          <%= form.submit t("admin.groups.actions.suspend_operation"), class: "rounded-full bg-red-700 px-4 py-2 text-sm font-medium text-white" %>
        <% end %>
      <% elsif policy(@group).restore_operation? %>
        <%= form_with url: restore_operation_admin_group_path(@group), method: :patch, scope: :moderation_action, class: "mt-5 space-y-3 rounded-2xl bg-stone-50 p-4" do |form| %>
          <%= form.label :public_reason, t("admin.groups.operation_moderation.reason"), class: "block text-sm font-medium text-stone-700" %>
          <%= form.text_area :public_reason, rows: 2, required: true, class: "w-full rounded-xl border border-stone-300 bg-white px-3 py-2 text-sm" %>
          <%= form.label :internal_note, t("group_memberships.moderation.internal_note"), class: "block text-sm font-medium text-stone-700" %>
          <%= form.text_area :internal_note, rows: 2, class: "w-full rounded-xl border border-stone-300 bg-white px-3 py-2 text-sm" %>
          <%= form.submit t("admin.groups.actions.restore_operation"), class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
        <% end %>
      <% end %>
    </section>

    <%= render "groups/lifecycle_history", lifecycle_events: @lifecycle_events, show_details: true %>
    <%= link_to t("admin.groups.actions.back"),
                admin_groups_path(@return_params),
                class: "text-sm font-medium text-stone-600 underline" %>
  </div>

  <section id="admin_group_content" class="space-y-5">
    <h2 class="text-2xl font-semibold"><%= t("admin.user_content.title") %></h2>
    <nav class="flex flex-wrap gap-2" aria-label="<%= t('admin.group_content.navigation_label') %>">
      <% %w[all general book comments].each do |section| %>
        <% selected = @content_section == section %>
        <%
          classes = if selected
            "rounded-full border border-stone-800 bg-stone-800 px-4 py-2 text-sm font-medium text-white"
          else
            "rounded-full border border-stone-200 bg-white px-4 py-2 text-sm font-medium text-stone-600 hover:bg-stone-50"
          end
        %>
        <%= link_to t("admin.user_content.navigation.#{section}"),
                    admin_group_path(
                      @group,
                      @return_params.merge(@content_filter_params).merge(content: section)
                    ),
                    class: classes,
                    aria: { current: ("page" if selected) } %>
      <% end %>
    </nav>
    <%= render "admin/groups/content_timeline",
               timeline_items: @timeline_items,
               page: @timeline_page,
               group: @group,
               content_section: @content_section,
               return_params: @return_params %>
  </section>
</section>
