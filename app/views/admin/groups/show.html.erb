<section class="relative left-1/2 w-[95vw] max-w-none -translate-x-1/2">
  <div class="mx-auto flex w-full max-w-5xl flex-col gap-6">
    <section id="admin_group_identity" class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm">
      <div class="flex flex-wrap items-start justify-between gap-5">
        <div class="min-w-0">
          <h1 class="truncate text-3xl font-semibold tracking-tight text-stone-900"><%= @group.name %></h1>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <span class="rounded-full bg-stone-100 px-2 py-1 text-xs text-stone-700" data-field="group-type">
              <%= t("admin.groups.types.#{@group.group_type}") %>
            </span>
            <span class="inline-flex items-center gap-1 text-xs text-stone-500">
              <%= t("admin.groups.current_status_label") %>:
              <span class="rounded-full px-2 py-1 <%= admin_group_status_badge_classes(@group) %>" data-field="current-status">
                <%= admin_group_current_status(@group) %>
              </span>
            </span>
          </div>
          <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-stone-600">
            <span data-field="group-admin">
              <%= t("admin.groups.fields.group_admin") %>:
              <%= link_to @group.group_admin.name,
                          admin_user_path(@group.group_admin),
                          class: "font-medium text-stone-800 underline" %>
            </span>
            <span data-field="created-at">
              <%= t("admin.groups.fields.created") %>: <%= l(@group.created_at, format: :short) %>
            </span>
          </div>
        </div>
        <div class="flex flex-wrap gap-2">
          <%= link_to t("groups.members.management_title"),
                      group_members_path(@group),
                      class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
          <%= link_to t("admin.actions.content"),
                      content_admin_group_path(@group, @return_params),
                      class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
          <% if policy(@group).approve? %>
            <%= button_to t("admin.groups.actions.approve"),
                          approve_admin_group_path(@group),
                          method: :patch,
                          class: "rounded-full bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
          <% end %>
        </div>
      </div>

      <% if @group.description.present? %>
        <p class="mt-5 whitespace-pre-wrap text-sm leading-6 text-stone-700"><%= @group.description %></p>
      <% end %>
    </section>

    <section id="group_membership_summary" class="rounded-3xl border border-stone-200 bg-white p-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-lg font-semibold text-stone-900"><%= t("admin.groups.membership_summary.title") %></h2>
        <%= link_to t("groups.members.management_title"),
                    group_members_path(@group),
                    class: "text-sm font-medium text-stone-600 underline" %>
      </div>

      <% if @membership_counts.any? %>
        <ul class="mt-4 flex flex-wrap gap-2">
          <% @membership_counts.each do |status, count| %>
            <li class="rounded-full bg-stone-100 px-3 py-1.5 text-sm text-stone-700" data-membership-status="<%= status %>">
              <%= t("group_memberships.statuses.#{status}") %> <span class="font-semibold"><%= count %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-4 text-sm text-stone-500"><%= t("admin.groups.membership_summary.empty") %></p>
      <% end %>
    </section>

    <% if @can_suspend_operation || @can_restore_operation %>
      <section id="group_operation_moderation" class="rounded-3xl border border-amber-200 bg-amber-50/60 p-5 text-sm text-amber-950">
        <h2 class="font-semibold"><%= t("admin.groups.operation_moderation.title") %></h2>

        <% if @current_operation_suspension.present? %>
          <div class="mt-4 rounded-2xl border border-amber-200 bg-white/70 p-4">
            <p class="font-semibold"><%= t("admin.groups.operation_moderation.current_suspension") %></p>
            <p class="mt-2 whitespace-pre-wrap"><%= t("admin.groups.operation_moderation.public_reason") %>: <%= Group.suspension_reason_label(@current_operation_suspension.public_reason) %></p>
            <% if @current_operation_suspension.internal_note.present? %>
              <p class="mt-2 whitespace-pre-wrap"><%= t("admin.groups.operation_moderation.internal_note") %>: <%= @current_operation_suspension.internal_note %></p>
            <% end %>
          </div>
        <% end %>

        <% moderation_action = @can_suspend_operation ? :suspend : :restore %>
        <% action_path = @can_suspend_operation ? suspend_operation_admin_group_path(@group) : restore_operation_admin_group_path(@group) %>
        <% submit_label = @can_suspend_operation ? t("admin.groups.actions.suspend_operation") : t("admin.groups.actions.restore_operation") %>
        <div class="mt-4 rounded-2xl border border-amber-200 bg-white/70 p-4" data-operation-action="<%= moderation_action %>">
          <h3 class="font-semibold text-amber-900">
            <%= t("admin.groups.operation_moderation.forms.#{moderation_action}.trigger") %>
          </h3>
          <%= form_with scope: :moderation_action, url: action_path, method: :patch, class: "mt-4 space-y-3" do |form| %>
            <div class="space-y-2">
              <%= form.label :public_reason,
                             t("admin.groups.operation_moderation.forms.#{moderation_action}.public_reason"),
                             class: "block font-medium" %>
              <% if @can_suspend_operation %>
                <%= form.select :public_reason,
                                options_for_select(Group::SUSPENSION_REASONS.map { |reason| [ Group.suspension_reason_label(reason), reason ] }),
                                { prompt: t("admin.groups.operation_moderation.forms.suspend.reason_prompt") },
                                required: true,
                                aria: { describedby: "operation_public_reason_hint" },
                                class: "w-full rounded-xl border border-amber-200 bg-white px-3 py-2" %>
              <% else %>
                <%= form.text_area :public_reason,
                                   required: true,
                                   rows: 3,
                                   aria: { describedby: "operation_public_reason_hint" },
                                   class: "w-full rounded-xl border border-amber-200 bg-white px-3 py-2" %>
              <% end %>
              <p id="operation_public_reason_hint" class="text-xs text-amber-800">
                <%= t("admin.groups.operation_moderation.forms.#{moderation_action}.public_reason_hint") %>
              </p>
            </div>
            <div class="space-y-2">
              <%= form.label :internal_note, t("admin.groups.operation_moderation.internal_note"), class: "block font-medium" %>
              <%= form.text_area :internal_note,
                                 rows: 3,
                                 aria: { describedby: "operation_internal_note_hint" },
                                 class: "w-full rounded-xl border border-amber-200 bg-white px-3 py-2" %>
              <p id="operation_internal_note_hint" class="text-xs text-amber-800">
                <%= t("admin.groups.operation_moderation.internal_note_hint") %>
              </p>
            </div>
            <%= form.submit submit_label, class: "rounded-full bg-amber-800 px-4 py-2 font-medium text-white" %>
          <% end %>
        </div>
      </section>
    <% end %>

    <%= render "groups/operation_history",
               lifecycle_events: @lifecycle_events,
               operation_actions: @operation_moderation_actions,
               show_internal_notes: true %>
    <%= link_to t("admin.groups.actions.back"),
                admin_groups_path(@return_params),
                class: "text-sm font-medium text-stone-600 underline" %>
  </div>
</section>
