<section class="relative left-1/2 w-[95vw] max-w-none -translate-x-1/2 space-y-5">
  <%= render "admin/shared/navigation" %>
  <div><h1 class="text-3xl font-semibold"><%= t("admin.groups.index.title") %></h1><p class="mt-2 text-sm text-stone-500"><%= t("admin.groups.index.description") %></p></div>
  <%= form_with url: admin_groups_path, method: :get, class: "flex flex-col gap-3 rounded-2xl border bg-white p-4 lg:flex-row lg:items-center" do |f| %>
    <%= f.search_field :q, value: params[:q], placeholder: t("admin.groups.filters.search"), class: "min-w-0 rounded border p-2 lg:flex-1" %>
    <%= f.select :group_type, options_for_select([[t("admin.filters.all"), ""]] + Group.group_types.keys.map { |type| [t("admin.groups.types.#{type}"), type] }, params[:group_type]), {}, class: "rounded border p-2" %>
    <%= f.select :status, options_for_select([[t("admin.filters.all"), ""]] + Group.lifecycle_statuses.keys.map { |status| [t("admin.groups.lifecycle_statuses.#{status}"), status] }, params[:status]), {}, class: "rounded border p-2" %>
    <%= f.select :sort, options_for_select([[t("admin.sorts.recent"), "recent"], [t("admin.sorts.oldest"), "oldest"], [t("admin.sorts.name"), "name"]], params[:sort]), {}, class: "rounded border p-2" %>
    <%= f.submit t("admin.filters.apply"), class: "whitespace-nowrap rounded bg-stone-900 p-2 text-white" %><%= link_to t("admin.filters.reset"), admin_groups_path, class: "whitespace-nowrap p-2 underline" %>
  <% end %>
  <div class="overflow-x-auto rounded-2xl border bg-white"><table class="min-w-full text-sm">
    <thead><tr class="border-b text-left"><th class="p-3"><%= t("admin.groups.fields.name") %></th><th class="p-3"><%= t("admin.groups.fields.type") %></th><th class="p-3"><%= t("admin.groups.fields.status") %></th><th class="p-3"><%= t("admin.groups.fields.group_admin") %></th><th class="p-3"><%= t("admin.groups.fields.active_members") %></th><th class="p-3"><%= t("admin.groups.fields.created") %></th><th class="p-3"><%= t("admin.groups.fields.actions") %></th></tr></thead>
    <tbody><% @groups.each do |group| %><tr id="<%= dom_id(group) %>" class="border-b"><td class="p-3"><%= group.name %></td><td class="p-3"><%= t("admin.groups.types.#{group.group_type}") %></td><td class="p-3"><span class="rounded-full bg-stone-100 px-2 py-1"><%= t("admin.groups.lifecycle_statuses.#{group.lifecycle_status}") %></span><% if group.pending_approval? %><br><span class="text-xs"><%= t(group.closed_at.present? ? "admin.groups.request_types.reactivation" : "admin.groups.request_types.initial") %></span><% end %></td><td class="p-3"><%= group.group_admin.name %><br><span class="text-xs text-stone-500"><%= group.group_admin.withdrawn? ? "-" : group.group_admin.email %></span></td><td class="p-3"><%= group.active_members_count %></td><td class="p-3 whitespace-nowrap"><%= l(group.created_at, format: :short) %></td><td class="space-y-2 p-3"><%= link_to t("admin.groups.actions.show"), admin_group_path(group, request.query_parameters), class: "block underline" %><% if policy(group).approve? %><%= button_to t("admin.groups.actions.approve"), approve_admin_group_path(group), method: :patch, class: "rounded bg-stone-900 px-3 py-1 text-white" %><% end %></td></tr><% end %></tbody>
  </table><% if @groups.empty? %><p class="p-6 text-center"><%= t("admin.filters.empty") %></p><% end %></div>
  <%= render "admin/shared/pagination", page: @inventory_page %>
</section>
