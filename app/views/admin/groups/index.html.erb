<section class="mx-auto max-w-7xl space-y-5">
  <%= render "admin/shared/navigation" %>
  <div><h1 class="text-3xl font-semibold"><%= t("admin.groups.index.title") %></h1><p class="mt-2 text-sm text-stone-500"><%= t("admin.groups.index.description") %></p></div>
  <%= form_with url: admin_groups_path, method: :get, class: "grid gap-3 rounded-2xl border bg-white p-4 md:grid-cols-4" do |f| %>
    <%= f.search_field :q, value: params[:q], placeholder: t("admin.groups.filters.search"), class: "rounded border p-2" %>
    <%= f.select :group_type, options_for_select([[t("admin.filters.all"), ""]] + Group.group_types.keys.map { |type| [t("groups.types.#{type}"), type] }, params[:group_type]), {}, class: "rounded border p-2" %>
    <%= f.select :status, options_for_select([[t("admin.filters.all"), ""]] + Group.lifecycle_statuses.keys.map { |status| [t("groups.lifecycle_statuses.#{status}"), status] }, params[:status]), {}, class: "rounded border p-2" %>
    <%= f.select :sort, options_for_select([[t("admin.sorts.recent"), "recent"], [t("admin.sorts.oldest"), "oldest"], [t("admin.sorts.updated"), "updated"], [t("admin.sorts.name"), "name"]], params[:sort]), {}, class: "rounded border p-2" %>
    <%= f.date_field :from, value: params[:from], class: "rounded border p-2", aria: { label: t("admin.filters.from") } %>
    <%= f.date_field :to, value: params[:to], class: "rounded border p-2", aria: { label: t("admin.filters.to") } %>
    <%= f.submit t("admin.filters.apply"), class: "rounded bg-stone-900 p-2 text-white" %><%= link_to t("admin.filters.reset"), admin_groups_path, class: "p-2 underline" %>
  <% end %>
  <div class="overflow-x-auto rounded-2xl border bg-white"><table class="min-w-full text-sm">
    <thead><tr class="border-b text-left"><th class="p-3">ID</th><th><%= t("admin.groups.fields.name") %></th><th><%= t("admin.groups.fields.type") %></th><th><%= t("admin.groups.fields.status") %></th><th><%= t("admin.groups.fields.group_admin") %></th><th><%= t("admin.groups.fields.active_members") %></th><th><%= t("admin.groups.fields.created") %></th><th><%= t("admin.groups.fields.updated") %></th><th></th></tr></thead>
    <tbody><% @groups.each do |group| %><tr id="<%= dom_id(group) %>" class="border-b"><td class="p-3"><%= group.id %></td><td><%= group.name %></td><td><%= t("groups.types.#{group.group_type}") %></td><td><span class="rounded-full bg-stone-100 px-2 py-1"><%= t("groups.lifecycle_statuses.#{group.lifecycle_status}") %></span><% if group.pending_approval? %><br><span class="text-xs"><%= t(group.closed_at.present? ? "admin.groups.request_types.reactivation" : "admin.groups.request_types.initial") %></span><% end %></td><td><%= group.group_admin.name %><br><span class="text-xs text-stone-500"><%= group.group_admin.email %></span></td><td><%= group.active_members_count %></td><td><%= l(group.created_at, format: :short) %></td><td><%= l(group.updated_at, format: :short) %></td><td class="space-y-2 p-2"><%= link_to t("admin.groups.actions.show"), admin_group_path(group, request.query_parameters), class: "block underline" %><% if policy(group).approve? %><%= button_to t("admin.groups.actions.approve"), approve_admin_group_path(group), method: :patch, class: "rounded bg-stone-900 px-3 py-1 text-white" %><% end %></td></tr><% end %></tbody>
  </table><% if @groups.empty? %><p class="p-6 text-center"><%= t("admin.filters.empty") %></p><% end %></div>
  <%= render "admin/shared/pagination", page: @inventory_page %>
</section>
