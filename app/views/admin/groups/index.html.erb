<section class="mx-auto flex w-full max-w-5xl flex-col gap-6">
  <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm">
    <h1 class="text-3xl font-semibold tracking-tight text-stone-900"><%= t("admin.groups.index.title") %></h1>
    <p class="mt-3 text-sm text-stone-500"><%= t("admin.groups.index.description") %></p>
  </section>

  <section class="space-y-4">
    <h2 class="text-2xl font-semibold text-stone-900"><%= t("admin.groups.index.pending_title") %></h2>
    <% if @pending_groups.any? %>
      <% @pending_groups.each do |group| %>
        <article class="rounded-3xl border border-stone-200 bg-white p-5 shadow-sm">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <p class="mb-2 text-xs font-semibold text-amber-700"><%= t(group.closed_at.present? ? "admin.groups.request_types.reactivation" : "admin.groups.request_types.initial") %></p>
              <h3 class="text-xl font-semibold text-stone-900"><%= group.name %></h3>
              <p class="mt-1 text-xs text-stone-500"><%= t("groups.types.#{group.group_type}") %></p>
              <p class="mt-1 text-xs text-stone-500"><%= t("groups.owner", name: group.owner.name) %></p>
            </div>
            <div class="flex gap-2">
              <%= link_to t("admin.groups.actions.show"), admin_group_path(group), class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
              <%= button_to t("admin.groups.actions.approve"), approve_admin_group_path(group), method: :patch, class: "rounded-full bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
            </div>
          </div>
          <% if group.description.present? %>
            <p class="mt-4 whitespace-pre-wrap text-sm leading-6 text-stone-600"><%= group.description %></p>
          <% end %>
        </article>
      <% end %>
    <% else %>
      <div class="rounded-3xl border border-dashed border-stone-300 bg-white/70 p-8 text-center text-sm text-stone-500"><%= t("admin.groups.index.empty") %></div>
    <% end %>
  </section>

  <section class="space-y-4">
    <h2 class="text-2xl font-semibold text-stone-900"><%= t("admin.groups.index.all_title") %></h2>
    <div class="overflow-hidden rounded-3xl border border-stone-200 bg-white shadow-sm">
      <% @all_groups.each do |group| %>
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-stone-100 px-5 py-4 last:border-b-0">
          <div>
            <p class="font-medium text-stone-900"><%= group.name %></p>
            <p class="mt-1 text-xs text-stone-500"><%= t("groups.types.#{group.group_type}") %> · <%= t("groups.owner", name: group.owner.name) %> · <%= t("groups.lifecycle_statuses.#{group.lifecycle_status}") %></p>
          </div>
          <%= link_to t("admin.groups.actions.show"), admin_group_path(group), class: "text-sm font-medium text-stone-700 underline" %>
        </div>
      <% end %>
    </div>
  </section>
</section>
