<section class="relative left-1/2 w-[95vw] max-w-none -translate-x-1/2 space-y-5">
  <section id="admin_group_inventory_header" class="mx-auto max-w-5xl rounded-3xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
    <h1 class="text-2xl font-semibold text-stone-900"><%= t("admin.groups.index.title") %></h1>
    <p class="mt-1 text-sm text-stone-500"><%= t("admin.groups.index.description") %></p>
  </section>

  <section id="admin_group_inventory_controls" class="mx-auto max-w-5xl rounded-3xl border border-stone-200 bg-white p-4 shadow-sm sm:p-5">
    <%= form_with url: admin_groups_path,
                  method: :get,
                  class: "flex flex-col gap-3 lg:flex-row lg:items-center" do |f| %>
      <%= f.search_field :q,
                         value: params[:q],
                         placeholder: t("admin.groups.filters.search"),
                         class: "min-w-0 rounded-xl border border-stone-200 px-3 py-2 lg:flex-1" %>
      <%= f.select :group_type,
                   options_for_select(
                     [[t("admin.filters.all"), ""]] + Group.group_types.keys.map { |type| [t("groups.types.#{type}"), type] },
                     params[:group_type]
                   ),
                   {},
                   class: "rounded-xl border border-stone-200 px-3 py-2" %>
      <%= f.select :status,
                   options_for_select([[t("admin.filters.all"), ""]] + admin_group_status_filter_options, params[:status]),
                   {},
                   class: "rounded-xl border border-stone-200 px-3 py-2",
                   aria: { label: t("admin.groups.fields.status") } %>
      <%= f.select :sort,
                   options_for_select(
                     [
                       [t("admin.sorts.recent"), "recent"],
                       [t("admin.sorts.oldest"), "oldest"],
                       [t("admin.sorts.name"), "name"]
                     ],
                     params[:sort]
                   ),
                   {},
                   class: "rounded-xl border border-stone-200 px-3 py-2" %>
      <%= f.submit t("admin.groups.index.search"),
                   class: "whitespace-nowrap rounded-xl bg-stone-900 px-4 py-2 font-medium text-white hover:bg-stone-800" %>
      <%= link_to t("admin.groups.index.reset"),
                  admin_groups_path,
                  class: "whitespace-nowrap px-2 py-2 text-sm font-medium text-stone-600 hover:text-stone-900 hover:underline" %>
    <% end %>
  </section>

  <div class="overflow-x-auto rounded-3xl border border-stone-200 bg-white shadow-sm">
    <table id="admin_group_inventory_table" class="min-w-full text-sm">
      <thead class="bg-stone-50/80 text-xs font-semibold text-stone-500">
        <tr class="border-b border-stone-200 text-left">
          <th class="px-4 py-3"><%= t("admin.groups.fields.name") %></th>
          <th class="px-4 py-3"><%= t("groups.group_admin_label") %></th>
          <th class="px-4 py-3"><%= t("admin.groups.fields.active_members") %></th>
          <th class="px-4 py-3"><%= t("admin.groups.fields.latest_activity") %></th>
          <th class="px-4 py-3"><%= t("admin.groups.fields.created") %></th>
          <th class="px-4 py-3"><%= t("admin.groups.fields.actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% @groups.each do |group| %>
          <% latest_activity = @latest_activities_by_group_id[group.id] %>
          <tr id="<%= dom_id(group) %>" class="border-b border-stone-100 hover:bg-stone-50/60 last:border-b-0">
            <td class="px-4 py-3.5" data-field="group-name">
              <%= link_to group.name,
                          group_path(group),
                          class: "block max-w-56 truncate font-medium text-stone-900 underline-offset-2 hover:underline",
                          data: { group_name: true },
                          title: group.name %>
              <div class="mt-1.5 flex items-center gap-1.5 whitespace-nowrap">
                <span class="rounded-full px-2 py-1 text-xs font-medium <%= group_type_badge_classes(group) %>" data-group-type="<%= group.group_type %>">
                  <%= group_type_label(group) %>
                </span>
                <span class="rounded-full px-2 py-1 text-xs font-medium <%= group_status_badge_classes(group) %>" data-field="current-status">
                  <%= group_current_status_label(group) %>
                </span>
              </div>
            </td>
            <td class="px-4 py-3.5" data-field="group-admin">
              <div class="flex items-center gap-2">
                <%= user_avatar_image(group.group_admin,
                                      size: 128,
                                      alt: group.group_admin.name,
                                      class: "h-8 w-8 shrink-0 rounded-full object-cover") %>
                <div>
                  <%= group.group_admin.name %><br>
                  <span class="text-xs text-stone-500"><%= group.group_admin.withdrawn? ? "-" : group.group_admin.email %></span>
                </div>
              </div>
            </td>
            <td class="px-4 py-3.5"><%= group.active_members_count %></td>
            <td class="px-4 py-3.5 whitespace-nowrap" data-field="latest-activity">
              <% if latest_activity %>
                <% activity_path = latest_activity.comment? ? jjaek_path(latest_activity.record.jjaek, anchor: dom_id(latest_activity.record)) : jjaek_path(latest_activity.record) %>
                <%= link_to activity_path, class: "inline-flex items-center gap-2 whitespace-nowrap underline-offset-2 hover:underline" do %>
                  <span class="rounded-full px-2 py-1 text-xs font-medium <%= admin_content_kind_badge_classes(latest_activity.kind) %>" data-activity-kind="<%= latest_activity.kind %>">
                    <%= admin_content_kind_label(latest_activity.kind) %>
                  </span>
                  <span class="text-sm text-stone-500"><%= l(latest_activity.created_at, format: :short) %></span>
                <% end %>
              <% else %>
                <span>-</span>
              <% end %>
            </td>
            <td class="px-4 py-3.5 whitespace-nowrap"><%= l(group.created_at, format: :short) %></td>
            <td class="px-4 py-3.5" data-field="actions">
              <div class="flex flex-wrap gap-2">
                <%= link_to t("admin.groups.index.actions.show"),
                            admin_group_path(group, request.query_parameters),
                            class: "inline-flex rounded-full border border-stone-200 px-3 py-1.5 text-xs font-medium text-stone-700 hover:bg-stone-50" %>
                <%= link_to t("admin.groups.index.actions.content"),
                            content_admin_group_path(group, request.query_parameters),
                            class: "inline-flex rounded-full border border-stone-200 px-3 py-1.5 text-xs font-medium text-stone-700 hover:bg-stone-50" %>
                <%= link_to t("admin.groups.index.actions.members"),
                            group_members_path(group, context: "admin"),
                            class: "inline-flex rounded-full border border-stone-200 px-3 py-1.5 text-xs font-medium text-stone-700 hover:bg-stone-50" %>
                <% if policy(group).approve? %>
                  <%= link_to t("admin.groups.index.actions.approve"),
                              new_admin_group_approval_path(group, request.query_parameters.merge(return_to: "inventory")),
                              class: "rounded-xl bg-stone-900 px-3 py-1.5 text-xs font-medium text-white" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @groups.empty? %>
      <p class="p-6 text-center"><%= t("admin.filters.empty") %></p>
    <% end %>
  </div>

  <%= render "admin/shared/pagination", page: @inventory_page %>
</section>
