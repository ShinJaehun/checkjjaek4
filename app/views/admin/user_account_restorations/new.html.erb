<section class="mx-auto w-full max-w-2xl rounded-3xl border border-amber-200 bg-white p-6 shadow-sm">
  <h1 class="text-2xl font-semibold text-stone-900"><%= t("admin.users.actions.restore") %></h1>
  <p class="mt-2 text-sm text-stone-600"><%= t("admin.users.moderation.forms.restore.description") %></p>

  <%= render "admin/users/account_action_context",
             user: @user,
             has_administered_groups: @has_administered_groups %>

  <% if @current_suspension_action.present? %>
    <section class="mt-6">
      <h2 class="mb-3 text-lg font-semibold text-stone-900"><%= t("admin.users.moderation.current_suspension") %></h2>
      <div class="rounded-2xl bg-amber-50 p-4 text-sm text-amber-950">
        <%= render "admin/users/account_moderation_history_entry",
                   action: @current_suspension_action,
                   event_type: :suspended,
                   occurred_at: @current_suspension_action.created_at %>
      </div>
    </section>
  <% end %>

  <% if @error_message.present? %>
    <p class="mt-5 rounded-2xl bg-red-50 p-4 text-sm text-red-700"><%= @error_message %></p>
  <% end %>

  <%= render "form" %>
  <%= link_to t("admin.users.moderation.cancel"),
              admin_user_path(@user),
              class: "mt-5 inline-block text-sm font-medium text-stone-600 underline" %>
</section>
