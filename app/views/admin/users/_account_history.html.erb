<section id="account_history" class="rounded-3xl border border-amber-200 bg-amber-50/60 p-5 text-sm text-amber-950">
  <h2 class="font-semibold"><%= t("admin.users.account_history.title") %></h2>

  <ol class="mt-3">
    <% entries.each do |entry| %>
      <li class="border-t border-amber-200 py-3 first:border-t-0 first:pt-0 last:pb-0" data-account-event="<%= entry.event_type %>">
        <% if entry.action %>
          <%= render "admin/users/account_moderation_history_entry",
                     action: entry.action,
                     event_type: entry.event_type,
                     occurred_at: entry.occurred_at %>
        <% else %>
          <p class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <span class="font-semibold"><%= t("admin.users.account_history.events.#{entry.event_type}.title") %></span>
            <span class="font-semibold">· <%= l(entry.occurred_at, format: :short) %></span>
          </p>
        <% end %>
      </li>
    <% end %>
  </ol>
</section>
