<section class="relative left-1/2 w-[95vw] max-w-none -translate-x-1/2">
  <div class="mx-auto max-w-5xl space-y-6">
    <%= render "admin/users/identity",
               user: @user,
               account_status: @account_status,
               has_administered_groups: @has_administered_groups,
               action_label: t("admin.users.actions.activity"),
               action_path: content_admin_user_path(@user) %>

    <section id="group_relationships" class="rounded-3xl border border-stone-200 bg-white p-5">
      <h2 class="text-lg font-semibold text-stone-900"><%= t("admin.users.sections.group_relationships") %></h2>

      <div class="mt-4" id="administered_groups">
        <h3 class="text-sm font-semibold text-stone-700"><%= t("admin.users.fields.groups") %></h3>
        <% if @administered_groups.any? %>
          <ul class="mt-2 flex flex-wrap gap-2">
            <% @administered_groups.each do |group| %>
              <li>
                <%= link_to group.name,
                            admin_group_path(group),
                            class: "inline-flex rounded-full bg-sky-50 px-3 py-1.5 text-sm text-sky-900 underline" %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-2 text-sm text-stone-500"><%= t("admin.users.empty.administered_groups") %></p>
        <% end %>
      </div>

      <div class="mt-5" id="joined_groups">
        <h3 class="text-sm font-semibold text-stone-700"><%= t("admin.users.fields.memberships") %></h3>
        <% if @joined_groups.any? %>
          <ul class="mt-2 flex flex-wrap gap-2">
            <% @joined_groups.each do |group| %>
              <li>
                <%= link_to group.name,
                            admin_group_path(group),
                            class: "inline-flex rounded-full bg-stone-100 px-3 py-1.5 text-sm text-stone-700 underline" %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-2 text-sm text-stone-500"><%= t("admin.users.empty.joined_groups") %></p>
        <% end %>
      </div>
    </section>

    <% if @current_suspension_action || @can_suspend || @can_restore %>
      <section class="rounded-3xl border border-amber-200 bg-amber-50/60 p-5 text-sm text-amber-950">
        <h2 class="font-semibold"><%= t("admin.users.moderation.title") %></h2>
        <p class="mt-3 font-medium">
          <%= t("admin.users.moderation.status") %>:
          <span class="inline-flex rounded-full bg-amber-200 px-2 py-0.5 text-xs"><%= t("admin.users.statuses.#{@account_status}") %></span>
        </p>
        <% if @can_suspend || @can_restore %>
          <% moderation_action = @can_suspend ? :suspend : :restore %>
          <% action_path = @can_suspend ? suspend_admin_user_path(@user) : restore_admin_user_path(@user) %>
          <% submit_label = @can_suspend ? t("admin.users.actions.suspend") : t("admin.users.actions.restore") %>
          <%= form_with scope: :moderation_action, url: action_path, method: :patch, class: "mt-4 space-y-3" do |form| %>
            <div class="space-y-2">
              <%= form.label :public_reason,
                             t("admin.users.moderation.forms.#{moderation_action}.public_reason"),
                             class: "block font-medium" %>
              <% if @can_suspend %>
                <%= form.select :public_reason,
                                options_for_select(User::SUSPENSION_REASONS.map { |reason| [ User.suspension_reason_label(reason), reason ] }),
                                { prompt: t("admin.users.moderation.forms.suspend.reason_prompt") },
                                required: true,
                                aria: { describedby: "moderation_public_reason_hint" },
                                class: "w-full rounded-xl border border-amber-200 bg-white px-3 py-2" %>
              <% else %>
                <%= form.text_area :public_reason,
                                   required: true,
                                   rows: 3,
                                   aria: { describedby: "moderation_public_reason_hint" },
                                   class: "w-full rounded-xl border border-amber-200 bg-white px-3 py-2" %>
              <% end %>
              <p id="moderation_public_reason_hint" class="text-xs text-amber-800">
                <%= t("admin.users.moderation.forms.#{moderation_action}.public_reason_hint") %>
              </p>
            </div>
            <div class="space-y-2">
              <%= form.label :internal_note, t("admin.users.moderation.internal_note"), class: "block font-medium" %>
              <%= form.text_area :internal_note,
                                 rows: 3,
                                 aria: { describedby: "moderation_internal_note_hint" },
                                 class: "w-full rounded-xl border border-amber-200 bg-white px-3 py-2" %>
              <p id="moderation_internal_note_hint" class="text-xs text-amber-800">
                <%= t("admin.users.moderation.internal_note_hint") %>
              </p>
            </div>
            <%= form.submit submit_label, class: "rounded-full bg-amber-800 px-4 py-2 font-medium text-white" %>
          <% end %>
        <% end %>
      </section>
    <% end %>

    <%= render "admin/users/account_history", entries: @account_history_entries %>
  </div>
</section>
