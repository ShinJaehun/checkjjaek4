<section class="relative left-1/2 w-[95vw] max-w-none -translate-x-1/2 space-y-5">
  <div class="max-w-4xl space-y-5">
    <h1 class="text-3xl font-semibold"><%= @user.name %></h1>

    <dl class="grid gap-3 rounded-2xl border bg-white p-5 md:grid-cols-2">
      <%
        {
          "ID" => @user.id,
          t("admin.users.fields.email") => (@user.withdrawn? ? "-" : @user.email),
          t("admin.users.fields.status") => t("admin.users.statuses.#{@account_status}"),
          t("admin.users.fields.joined") => l(@user.created_at, format: :short),
          t("admin.users.fields.updated") => l(@user.updated_at, format: :short),
          t("admin.users.fields.withdrawn") => (@user.withdrawn_at && l(@user.withdrawn_at, format: :short)),
          t("admin.users.fields.suspended") => (@user.suspended_at && l(@user.suspended_at, format: :short))
        }.each do |label, value|
      %>
        <div>
          <dt class="text-xs text-stone-500"><%= label %></dt>
          <dd><%= value.presence || "-" %></dd>
        </div>
      <% end %>

      <div>
        <dt class="text-xs text-stone-500"><%= t("admin.users.fields.role") %></dt>
        <dd class="mt-1 flex flex-wrap gap-1">
          <% if @user.global_admin? %>
            <span class="rounded-full bg-amber-100 px-2 py-1"><%= t("admin.users.roles.global_admin") %></span>
          <% end %>
          <% if @administered_groups.any? %>
            <span class="rounded-full bg-sky-100 px-2 py-1"><%= t("admin.users.roles.group_admin") %></span>
          <% end %>
          <% unless @user.global_admin? || @administered_groups.any? %>
            <span class="rounded-full bg-stone-100 px-2 py-1"><%= t("admin.users.roles.regular") %></span>
          <% end %>
        </dd>
      </div>
    </dl>

    <% if @current_suspension_action %>
      <section class="space-y-2 rounded-2xl border border-amber-200 bg-amber-50 p-5">
        <h2 class="text-xl font-semibold"><%= t("admin.users.moderation.current_suspension") %></h2>
        <p><%= @current_suspension_action.public_reason %></p>
        <% if @current_suspension_action.internal_note.present? %>
          <p class="text-sm text-stone-600">
            <%= t("admin.users.moderation.internal_note") %>: <%= @current_suspension_action.internal_note %>
          </p>
        <% end %>
        <p class="text-sm text-stone-600">
          <%= t("admin.users.moderation.performed_by",
                actor: @current_suspension_action.actor.name,
                time: l(@current_suspension_action.created_at, format: :short)) %>
        </p>
      </section>
    <% end %>

    <% if @can_suspend || @can_restore %>
      <section class="space-y-4 rounded-2xl border bg-white p-5">
        <h2 class="text-xl font-semibold"><%= t("admin.users.moderation.title") %></h2>
        <% moderation_action = @can_suspend ? :suspend : :restore %>
        <% action_path = @can_suspend ? suspend_admin_user_path(@user) : restore_admin_user_path(@user) %>
        <% submit_label = @can_suspend ? t("admin.users.actions.suspend") : t("admin.users.actions.restore") %>
        <%= form_with scope: :moderation_action, url: action_path, method: :patch, class: "space-y-4" do |form| %>
          <div class="space-y-2">
            <%= form.label :public_reason,
                           t("admin.users.moderation.forms.#{moderation_action}.public_reason"),
                           class: "text-sm font-medium" %>
            <%= form.text_area :public_reason,
                               required: true,
                               rows: 3,
                               aria: { describedby: "moderation_public_reason_hint" },
                               class: "w-full rounded border p-3" %>
            <p id="moderation_public_reason_hint" class="text-sm text-stone-500">
              <%= t("admin.users.moderation.forms.#{moderation_action}.public_reason_hint") %>
            </p>
          </div>
          <div class="space-y-2">
            <%= form.label :internal_note, t("admin.users.moderation.internal_note"), class: "text-sm font-medium" %>
            <%= form.text_area :internal_note,
                               rows: 3,
                               aria: { describedby: "moderation_internal_note_hint" },
                               class: "w-full rounded border p-3" %>
            <p id="moderation_internal_note_hint" class="text-sm text-stone-500">
              <%= t("admin.users.moderation.internal_note_hint") %>
            </p>
          </div>
          <%= form.submit submit_label, class: "rounded bg-stone-900 px-4 py-2 text-white" %>
        <% end %>
      </section>
    <% end %>

    <%= render "admin/users/account_history", entries: @account_history_entries %>

    <h2 class="text-xl font-semibold"><%= t("admin.users.fields.groups") %></h2>
    <ul>
      <% @administered_groups.each do |group| %>
        <li><%= link_to group.name, admin_group_path(group), class: "underline" %></li>
      <% end %>
    </ul>

    <h2 class="text-xl font-semibold"><%= t("admin.users.fields.memberships") %></h2>
    <ul class="flex flex-wrap gap-3">
      <% @membership_counts.each do |status, count| %>
        <li><%= t("group_memberships.statuses.#{status}") %>: <%= count %></li>
      <% end %>
    </ul>
  </div>

  <section class="mt-10 space-y-5">
    <h2 class="text-2xl font-semibold"><%= t("admin.user_content.title") %></h2>
    <nav class="flex flex-wrap gap-2" aria-label="<%= t('admin.user_content.navigation_label') %>">
      <% %w[all general book requote comments].each do |section| %>
        <% selected = @content_section == section %>
        <%
          classes = if selected
            "rounded-full border border-stone-800 bg-stone-800 px-4 py-2 text-sm font-medium text-white"
          else
            "rounded-full border border-stone-200 bg-white px-4 py-2 text-sm font-medium text-stone-600 hover:bg-stone-50"
          end
        %>
        <%= link_to t("admin.user_content.navigation.#{section}"),
                    admin_user_path(@user, @content_filter_params.merge(content: section)),
                    class: classes,
                    aria: { current: ("page" if selected) } %>
      <% end %>
    </nav>
    <%= render "admin/users/content_timeline",
               timeline_items: @timeline_items,
               page: @timeline_page,
               user: @user,
               content_section: @content_section %>
  </section>
</section>
