<section class="mx-auto max-w-4xl space-y-5">
  <h1 class="text-3xl font-semibold"><%= @user.name %></h1>

  <dl class="grid gap-3 rounded-2xl border bg-white p-5 md:grid-cols-2">
    <%
      {
        "ID" => @user.id,
        t("admin.users.fields.email") => (@user.withdrawn? ? "-" : @user.email),
        t("admin.users.fields.status") => t("admin.users.statuses.#{@user.withdrawn? ? 'withdrawn' : 'active'}"),
        t("admin.users.fields.joined") => l(@user.created_at, format: :short),
        t("admin.users.fields.updated") => l(@user.updated_at, format: :short),
        t("admin.users.fields.withdrawn") => (@user.withdrawn_at && l(@user.withdrawn_at, format: :short)),
        "Jjaek" => @user.jjaeks.count,
        "Comment" => @user.comments.count
      }.each do |label, value|
    %>
      <div>
        <dt class="text-xs text-stone-500"><%= label %></dt>
        <dd><%= value.presence || "-" %></dd>
      </div>
    <% end %>

    <div>
      <dt class="text-xs text-stone-500"><%= t("admin.users.fields.role") %></dt>
      <dd class="mt-1 flex flex-wrap gap-1">
        <% if @user.global_admin? %>
          <span class="rounded-full bg-amber-100 px-2 py-1"><%= t("admin.users.roles.global_admin") %></span>
        <% end %>
        <% if @administered_groups.any? %>
          <span class="rounded-full bg-sky-100 px-2 py-1"><%= t("admin.users.roles.group_admin") %></span>
        <% end %>
        <% unless @user.global_admin? || @administered_groups.any? %>
          <span class="rounded-full bg-stone-100 px-2 py-1"><%= t("admin.users.roles.regular") %></span>
        <% end %>
      </dd>
    </div>
  </dl>

  <h2 class="text-xl font-semibold"><%= t("admin.users.fields.groups") %></h2>
  <ul>
    <% @administered_groups.each do |group| %>
      <li><%= link_to group.name, admin_group_path(group), class: "underline" %></li>
    <% end %>
  </ul>

  <h2 class="text-xl font-semibold"><%= t("admin.users.fields.memberships") %></h2>
  <ul class="flex flex-wrap gap-3">
    <% @membership_counts.each do |status, count| %>
      <li><%= t("group_memberships.statuses.#{status}") %>: <%= count %></li>
    <% end %>
  </ul>
</section>
