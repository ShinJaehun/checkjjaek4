<section class="relative left-1/2 w-[95vw] max-w-none -translate-x-1/2 space-y-5">
  <%= render "admin/shared/navigation" %>
  <h1 class="text-3xl font-semibold"><%= t("admin.users.index.title") %></h1>
  <%= form_with url: admin_users_path, method: :get, class: "flex flex-col gap-3 rounded-2xl border bg-white p-4 lg:flex-row lg:items-center" do |f| %>
    <%= f.search_field :q, value: params[:q], placeholder: t("admin.filters.search"), class: "min-w-0 rounded border p-2 lg:flex-1" %>
    <%= f.select :status, options_for_select([[t("admin.filters.all"), ""], [t("admin.users.statuses.active"), "active"], [t("admin.users.statuses.withdrawn"), "withdrawn"]], params[:status]), {}, class: "rounded border p-2" %>
    <%= f.select :role, options_for_select([[t("admin.filters.all"), ""], [t("admin.users.roles.global_admin"), "global_admin"], [t("admin.users.roles.group_admin"), "group_admin"], [t("admin.users.roles.regular"), "regular"]], params[:role]), {}, class: "rounded border p-2", aria: { label: t("admin.users.fields.role") } %>
    <%= f.select :sort, options_for_select([[t("admin.sorts.recent"), "recent"], [t("admin.sorts.oldest"), "oldest"], [t("admin.sorts.name"), "name"]], params[:sort]), {}, class: "rounded border p-2" %>
    <%= f.submit t("admin.filters.apply"), class: "whitespace-nowrap rounded bg-stone-900 p-2 text-white" %><%= link_to t("admin.filters.reset"), admin_users_path, class: "whitespace-nowrap p-2 underline" %>
  <% end %>
  <div class="overflow-x-auto rounded-2xl border bg-white"><table class="min-w-full text-sm"><thead><tr class="border-b text-left"><th class="p-3"><span class="sr-only"><%= t("admin.users.fields.avatar") %></span></th><th class="p-3"><%= t("admin.users.fields.name") %></th><th class="p-3"><%= t("admin.users.fields.email") %></th><th class="p-3"><%= t("admin.users.fields.status") %></th><th class="p-3"><%= t("admin.users.fields.role") %></th><th class="p-3"><%= t("admin.users.fields.joined") %></th><th class="p-3"><%= t("admin.users.fields.withdrawn") %></th><th class="p-3"></th></tr></thead><tbody>
    <% @users.each do |user| %><tr id="<%= dom_id(user) %>" class="border-b <%= user.withdrawn? ? 'bg-stone-50 text-stone-400' : nil %>"><td class="p-3"><%= user_avatar_image(user, size: 128, alt: user.name, class: "h-9 w-9 shrink-0 rounded-full object-cover") %></td><td class="p-3"><%= user.name %></td><td class="p-3" data-field="email"><%= user.withdrawn? ? "-" : user.email %></td><td class="p-3 whitespace-nowrap"><span class="rounded-full px-2 py-1 <%= user.withdrawn? ? 'bg-stone-200 text-stone-700' : 'bg-stone-100' %>"><%= t("admin.users.statuses.#{user.withdrawn? ? 'withdrawn' : 'active'}") %></span></td><td class="p-3"><div class="flex flex-wrap gap-1"><% if user.global_admin? %><span class="rounded-full bg-amber-100 px-2 py-1"><%= t("admin.users.roles.global_admin") %></span><% end %><% if user.administered_groups_count.to_i.positive? %><span class="rounded-full bg-sky-100 px-2 py-1"><%= t("admin.users.roles.group_admin") %></span><% end %><% unless user.global_admin? || user.administered_groups_count.to_i.positive? %><span class="rounded-full bg-stone-100 px-2 py-1"><%= t("admin.users.roles.regular") %></span><% end %></div></td><td class="p-3 whitespace-nowrap"><%= l(user.created_at, format: :short) %></td><td class="p-3 whitespace-nowrap"><%= user.withdrawn_at ? l(user.withdrawn_at, format: :short) : "-" %></td><td class="p-3 whitespace-nowrap"><%= link_to t("admin.actions.show"), admin_user_path(user), class: "text-stone-700 underline" %></td></tr><% end %>
  </tbody></table><% if @users.empty? %><p class="p-6 text-center"><%= t("admin.filters.empty") %></p><% end %></div>
  <%= render "admin/shared/pagination", page: @inventory_page %>
</section>
