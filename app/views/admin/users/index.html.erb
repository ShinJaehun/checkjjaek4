<section class="mx-auto max-w-7xl space-y-5">
  <%= render "admin/shared/navigation" %>
  <h1 class="text-3xl font-semibold"><%= t("admin.users.index.title") %></h1>
  <%= form_with url: admin_users_path, method: :get, class: "grid gap-3 rounded-2xl border bg-white p-4 md:grid-cols-4" do |f| %>
    <%= f.search_field :q, value: params[:q], placeholder: t("admin.filters.search"), class: "rounded border p-2" %>
    <%= f.select :status, options_for_select([[t("admin.filters.all"), ""], [t("admin.users.statuses.active"), "active"], [t("admin.users.statuses.withdrawn"), "withdrawn"]], params[:status]), {}, class: "rounded border p-2" %>
    <%= f.select :global_admin, options_for_select([[t("admin.filters.all"), ""], [t("admin.filters.yes"), "yes"], [t("admin.filters.no"), "no"]], params[:global_admin]), {}, class: "rounded border p-2" %>
    <%= f.select :sort, options_for_select([[t("admin.sorts.recent"), "recent"], [t("admin.sorts.oldest"), "oldest"], [t("admin.sorts.name"), "name"]], params[:sort]), {}, class: "rounded border p-2" %>
    <%= f.date_field :from, value: params[:from], class: "rounded border p-2", aria: { label: t("admin.filters.from") } %><%= f.date_field :to, value: params[:to], class: "rounded border p-2", aria: { label: t("admin.filters.to") } %>
    <%= f.submit t("admin.filters.apply"), class: "rounded bg-stone-900 p-2 text-white" %><%= link_to t("admin.filters.reset"), admin_users_path, class: "p-2 underline" %>
  <% end %>
  <div class="overflow-x-auto rounded-2xl border bg-white"><table class="min-w-full text-sm"><thead><tr class="border-b text-left"><th class="p-3">ID</th><th><%= t("admin.users.fields.name") %></th><th><%= t("admin.users.fields.email") %></th><th><%= t("admin.users.fields.status") %></th><th>Global admin</th><th><%= t("admin.users.fields.joined") %></th><th><%= t("admin.users.fields.groups") %></th><th></th></tr></thead><tbody>
    <% @users.each do |user| %><tr id="<%= dom_id(user) %>" class="border-b"><td class="p-3"><%= user.id %></td><td><%= user.name %></td><td><%= user.email %></td><td><span class="rounded-full bg-stone-100 px-2 py-1"><%= t("admin.users.statuses.#{user.withdrawn? ? 'withdrawn' : 'active'}") %></span></td><td><%= user.global_admin? ? t("admin.filters.yes") : t("admin.filters.no") %></td><td><%= l(user.created_at, format: :short) %></td><td><%= user.administered_groups_count %></td><td><%= link_to t("admin.actions.show"), admin_user_path(user), class: "underline" %></td></tr><% end %>
  </tbody></table><% if @users.empty? %><p class="p-6 text-center"><%= t("admin.filters.empty") %></p><% end %></div>
  <%= render "admin/shared/pagination", page: @inventory_page %>
</section>
