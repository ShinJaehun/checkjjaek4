<div class="mt-5 rounded-2xl bg-amber-50 p-4 text-sm text-amber-950" data-account-action-context>
  <div class="flex min-w-0 items-center gap-3">
    <%= user_avatar_image(user, size: 128, alt: user.name, class: "h-10 w-10 shrink-0 rounded-full object-cover") %>
    <div class="min-w-0">
      <p class="truncate font-semibold"><%= user.name %></p>
      <p class="truncate text-xs text-amber-900/70" data-field="email"><%= user.email %></p>
    </div>
  </div>
  <div class="mt-3 flex flex-wrap items-center gap-2" data-field="account-status">
    <span><%= t("admin.users.fields.status") %>:</span>
    <span class="rounded-full px-2 py-1 text-xs <%= admin_user_status_badge_classes(user.moderation_status) %>">
      <%= admin_user_status_label(user.moderation_status) %>
    </span>
  </div>
  <div class="mt-2 flex flex-wrap items-center gap-2" data-field="role">
    <span><%= t("admin.users.fields.role") %>:</span>
    <% admin_user_role_keys(user, has_administered_groups:).each do |role| %>
      <span class="rounded-full px-2 py-1 text-xs <%= user_role_badge_classes(role) %>" data-role="<%= role.tr("_", "-") %>"><%= user_role_label(role) %></span>
    <% end %>
  </div>
</div>
