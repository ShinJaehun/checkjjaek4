<section id="admin_user_content_timeline" class="space-y-5">
  <div class="overflow-x-auto rounded-3xl border border-stone-200 bg-white shadow-sm">
    <table class="min-w-full text-sm">
      <thead class="bg-stone-50/80 text-xs font-semibold text-stone-500">
        <tr class="border-b border-stone-200 text-left">
          <th class="px-4 py-3 whitespace-nowrap"><%= t("admin.user_content.fields.kind") %></th>
          <th class="min-w-44 px-4 py-3 whitespace-nowrap"><%= t("admin.user_content.fields.location") %></th>
          <th class="min-w-80 px-4 py-3"><%= t("admin.user_content.fields.body") %></th>
          <th class="min-w-80 px-4 py-3"><%= t("admin.user_content.fields.reference") %></th>
          <th class="px-4 py-3 whitespace-nowrap"><%= t("admin.user_content.fields.status") %></th>
          <th class="px-4 py-3 whitespace-nowrap"><%= t("admin.user_content.fields.created") %></th>
          <th class="px-4 py-3 whitespace-nowrap"><%= t("admin.user_content.fields.actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% timeline_items.each do |item| %>
          <% record = item.record %>
          <% source_jjaek = item.kind == "comments" ? record.jjaek : record.quoted_jjaek %>
          <% group = item.kind == "comments" ? record.jjaek.group : record.group %>
          <%
            body = if item.record_type == "Jjaek" && record.deleted?
              "-"
            else
              truncate(record.content.to_s, length: 140, omission: " [...]").presence || "-"
            end
          %>
          <tr id="timeline_<%= item.record_type.downcase %>_<%= record.id %>"
              class="border-b border-stone-100 align-middle hover:bg-stone-50/60 last:border-b-0"
              data-content-kind="<%= item.kind %>">
            <td class="px-4 py-3.5 align-middle whitespace-nowrap">
              <span class="whitespace-nowrap rounded-full bg-stone-100 px-2 py-1 text-xs text-stone-700">
                <%= t("admin.user_content.kinds.#{item.kind}") %>
              </span>
            </td>
            <td class="px-4 py-3.5 align-middle" data-field="location">
              <% if group %>
                <div class="text-xs text-stone-500"><%= t("admin.user_content.locations.group") %></div>
                <%= link_to group.name, admin_group_path(group), class: "mt-1 block text-sm font-medium text-stone-800 hover:underline" %>
              <% else %>
                <%= t("admin.user_content.locations.personal") %>
              <% end %>
            </td>
            <td class="px-4 py-3.5 align-middle leading-6 text-stone-800" data-field="body"><%= body %></td>
            <td class="px-4 py-3.5 align-middle leading-6" data-field="reference">
              <% if item.kind == "general" %>
                <% if !record.deleted? && record.target_user.present? && record.target_user_id != record.user_id %>
                  <span class="text-stone-500"><%= t("admin.user_content.references.target") %> ·</span>
                  <%= link_to record.target_user.name,
                              admin_user_path(record.target_user),
                              class: "text-stone-700 underline" %>
                <% else %>
                  -
                <% end %>
              <% elsif item.kind == "book" %>
                <% if !record.deleted? && record.book %>
                  <span class="text-stone-500"><%= t("admin.user_content.references.book") %> ·</span>
                  <%= link_to record.book.title,
                              book_path(record.book),
                              class: "text-stone-700 underline" %>
                <% else %>
                  -
                <% end %>
              <% elsif source_jjaek %>
                <p>
                  <span class="text-stone-500"><%= t("admin.user_content.references.source") %> ·</span>
                  <%= link_to source_jjaek.user.name,
                              admin_user_path(source_jjaek.user),
                              class: "text-stone-700 underline" %>
                </p>
                <p class="mt-1 text-stone-500">
                  <%= truncate(source_jjaek.content.to_s, length: 140, omission: " [...]").presence || "-" %>
                </p>
              <% else %>
                -
              <% end %>
            </td>
            <td class="px-4 py-3.5 align-middle whitespace-nowrap" data-field="status">
              <% if item.record_type == "Jjaek" && record.deleted? %>
                <span class="rounded-full bg-stone-200 px-2 py-1 text-xs text-stone-700">
                  <%= t("admin.user_content.statuses.deleted") %>
                </span>
              <% elsif record.hidden? %>
                <span class="rounded-full bg-red-100 px-2 py-1 text-xs text-red-800">
                  <%= t("admin.user_content.statuses.hidden") %>
                </span>
              <% else %>
                -
              <% end %>
            </td>
            <td class="px-4 py-3.5 align-middle whitespace-nowrap"><%= l(record.created_at, format: :short) %></td>
            <td class="px-4 py-3.5 align-middle whitespace-nowrap" data-field="actions">
              <% if item.record_type == "Comment" %>
                <%= link_to t("admin.user_content.actions.direct"),
                            jjaek_path(record.jjaek, anchor: dom_id(record)),
                            class: "inline-flex rounded-full border border-stone-200 px-3 py-1.5 text-xs font-medium text-stone-700 hover:bg-stone-50" %>
              <% else %>
                <%= link_to t("admin.user_content.actions.direct"),
                            jjaek_path(record),
                            class: "inline-flex rounded-full border border-stone-200 px-3 py-1.5 text-xs font-medium text-stone-700 hover:bg-stone-50" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if timeline_items.empty? %>
      <p class="p-6 text-center"><%= t("admin.user_content.empty") %></p>
    <% end %>
  </div>

  <%= render "admin/shared/pagination", page: page, page_param: :all_page %>
</section>
