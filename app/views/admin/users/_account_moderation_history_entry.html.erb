<div data-account-moderation-action="<%= action.action_type %>">
  <p class="flex flex-wrap items-center gap-x-2 gap-y-1">
    <span class="font-semibold"><%= t("admin.users.account_history.events.#{event_type}.title") %></span>
    <span class="inline-flex rounded-full bg-red-100 px-2 py-0.5 text-xs text-red-800"><%= t("admin.users.moderation.platform_authority") %></span>
    <span><%= action.actor.name %></span>
    <span class="font-semibold">· <%= l(occurred_at, format: :short) %></span>
  </p>
  <div class="mt-3 grid gap-2">
    <div class="rounded-xl border border-amber-200 bg-white/70 p-3" data-account-moderation-detail="reason">
      <p class="text-xs font-semibold text-amber-800"><%= t("admin.users.account_history.reason") %></p>
      <p class="mt-1 whitespace-pre-wrap text-sm text-stone-800"><%= action.action_type_suspend? ? User.suspension_reason_label(action.public_reason) : action.public_reason %></p>
    </div>

    <% if action.internal_note.present? %>
      <div class="rounded-xl border border-stone-200 bg-white/70 p-3" data-account-moderation-detail="memo">
        <p class="text-xs font-semibold text-stone-600"><%= t("admin.users.account_history.memo") %></p>
        <p class="mt-1 whitespace-pre-wrap text-sm text-stone-800"><%= action.internal_note %></p>
      </div>
    <% end %>
  </div>
</div>
