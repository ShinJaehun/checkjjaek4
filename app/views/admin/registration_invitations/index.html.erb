<section class="mx-auto max-w-5xl space-y-6">
  <header class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
    <h1 class="text-2xl font-semibold text-stone-900"><%= t("registration_invitations.title") %></h1>
    <p class="mt-2 text-sm text-stone-600"><%= t("registration_invitations.description") %></p>
  </header>

  <section class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
    <%= form_with model: @invitation, url: admin_registration_invitations_path, class: "flex flex-col gap-3 sm:flex-row sm:items-end" do |form| %>
      <div class="flex-1 space-y-2">
        <%= form.label :email, t("auth.form.email"), class: "block text-sm font-medium text-stone-700" %>
        <%= form.email_field :email, required: true, autocomplete: "email", class: "w-full rounded-xl border border-stone-300 px-3 py-2" %>
      </div>
      <%= form.submit t("registration_invitations.actions.send"), class: "ui-button ui-button-primary" %>
    <% end %>
    <% if @invitation.errors.any? %>
      <p class="mt-3 text-sm text-red-700"><%= @invitation.errors.full_messages.to_sentence %></p>
    <% end %>
  </section>

  <section class="overflow-x-auto rounded-3xl border border-stone-200 bg-white shadow-sm">
    <table class="min-w-full text-left text-sm">
      <thead class="bg-stone-50 text-stone-600">
        <tr>
          <th class="px-4 py-3"><%= t("auth.form.email") %></th>
          <th class="px-4 py-3"><%= t("registration_invitations.fields.status") %></th>
          <th class="px-4 py-3"><%= t("registration_invitations.fields.expires_at") %></th>
          <th class="px-4 py-3"><%= t("registration_invitations.fields.actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% @invitations.each do |invitation| %>
          <tr class="border-t border-stone-200">
            <td class="px-4 py-3"><%= invitation.email %></td>
            <td class="px-4 py-3"><%= t("registration_invitations.status.#{invitation.status}") %></td>
            <td class="px-4 py-3"><%= l(invitation.expires_at, format: :short) %></td>
            <td class="flex gap-3 px-4 py-3">
              <% if policy(invitation).resend? %>
                <%= button_to t("registration_invitations.actions.resend"), resend_admin_registration_invitation_path(invitation), method: :post, class: "text-stone-800 underline" %>
                <%= button_to t("registration_invitations.actions.cancel"), admin_registration_invitation_path(invitation), method: :delete, class: "text-red-700 underline" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
  <%= render "admin/shared/pagination", page: @invitation_page if @invitation_page %>
</section>
