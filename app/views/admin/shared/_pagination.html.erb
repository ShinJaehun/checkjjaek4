<% page_param = local_assigns.fetch(:page_param, :page) %>

<nav class="flex flex-wrap items-center justify-between gap-3 text-sm" aria-label="<%= t('pagination.navigation') %>">
  <span><%= t("pagination.range", first: page.first_item, last: page.last_item, total: page.total_count) %></span>
  <% if page.total_pages > 1 %>
    <div class="flex flex-wrap items-center gap-1">
      <%= admin_pagination_link t("pagination.first"), (1 if page.previous_page), page_param: page_param %>
      <%= admin_pagination_link t("pagination.previous"), page.previous_page, page_param: page_param %>

      <% admin_pagination_numbers(page).each do |number| %>
        <% if number.nil? %>
          <span class="px-2 py-2 text-stone-500">…</span>
        <% elsif number == page.page %>
          <strong class="rounded-lg bg-stone-900 px-3 py-2 font-semibold text-white" aria-current="page"><%= number %></strong>
        <% else %>
          <%= admin_pagination_link number, number, page_param: page_param %>
        <% end %>
      <% end %>

      <%= admin_pagination_link t("pagination.next"), page.next_page, page_param: page_param %>
      <%= admin_pagination_link t("pagination.last"), (page.total_pages if page.next_page), page_param: page_param %>
    </div>
  <% end %>
</nav>
