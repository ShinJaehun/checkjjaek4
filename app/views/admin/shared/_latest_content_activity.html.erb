<div class="space-y-1">
  <%= render "admin/shared/content_badges", record: activity.record %>
  <% if activity.record.is_a?(Jjaek) && activity.record.group %>
    <div class="mt-1 max-w-48 truncate text-xs text-stone-500" data-field="group-name"><%= activity.record.group.name %></div>
  <% end %>
  <% activity_path = activity.comment? ? jjaek_path(activity.record.jjaek, anchor: dom_id(activity.record)) : jjaek_path(activity.record) %>
  <%= link_to l(activity.created_at, format: :short), activity_path,
              class: "block text-sm text-stone-500 underline-offset-2 hover:underline" %>
</div>
