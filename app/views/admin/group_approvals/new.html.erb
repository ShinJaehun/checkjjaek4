<section class="mx-auto w-full max-w-2xl rounded-3xl border border-amber-200 bg-white p-6 shadow-sm">
  <h1 class="text-2xl font-semibold text-stone-900"><%= t("admin.groups.approval.title") %></h1>
  <p class="mt-2 text-sm text-stone-600"><%= t("admin.groups.approval.description") %></p>

  <%= render "groups/group_action_context", group: @group %>

  <div class="mt-4 rounded-2xl border border-stone-200 p-4 text-sm text-stone-700" data-group-approval-request-context>
    <p class="font-medium text-stone-900">
      <%= t("admin.groups.request_types.#{@group.closed_at.nil? ? "initial" : "reactivation"}") %>
    </p>
    <% if @group.closed_at.nil? && @group.application_purpose.present? %>
      <p class="mt-2 font-medium text-stone-900"><%= t("groups.form.application_purpose") %></p>
      <p class="mt-1 whitespace-pre-wrap"><%= @group.application_purpose %></p>
    <% elsif @group.closed_at.present? %>
      <p class="mt-2"><%= t("groups.management.closed_at", time: l(@group.closed_at, format: :short)) %></p>
      <% if @group.closure_reason.present? %>
        <p class="mt-2 font-medium text-stone-900"><%= t("groups.form.closure_reason") %></p>
        <p class="mt-1 whitespace-pre-wrap"><%= @group.closure_reason %></p>
      <% end %>
    <% end %>
  </div>

  <% if @error_message.present? %>
    <p class="mt-5 rounded-2xl bg-red-50 p-4 text-sm text-red-700"><%= @error_message %></p>
  <% end %>

  <%= button_to t("admin.groups.actions.approve"),
                admin_group_approvals_path(@group, @action_params),
                method: :post,
                class: "mt-6 rounded-full bg-stone-900 px-5 py-2.5 text-sm font-medium text-white" %>
  <%= link_to t("admin.groups.operation_moderation.cancel"),
              @approval_return_path,
              class: "mt-5 inline-block text-sm font-medium text-stone-600 underline" %>
</section>
