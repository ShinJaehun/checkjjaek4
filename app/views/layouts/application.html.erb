<!DOCTYPE html>
<html>
  <head>
    <title><%= t("site.title") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Checkjjaek4">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= favicon_link_tag "logo/checkjjaek_favicon_32.png", type: "image/png", sizes: "32x32" %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col bg-[linear-gradient(180deg,#f5efe4_0%,#f8f7f3_38%,#fcfcfb_100%)] text-stone-900"
        data-controller="book-modal"
        data-action="turbo:before-visit@document->book-modal#close turbo:before-cache@document->book-modal#close">
    <% auth_actions = {
      "users/sessions" => %w[new create],
      "users/registrations" => %w[new create],
      "users/passwords" => %w[new create edit update]
    } %>
    <% auth_page = auth_actions.fetch(controller_path, []).include?(action_name) %>
    <%= render "shared/nav" unless auth_page %>

    <main class="mx-auto flex w-full flex-1 flex-col <%= auth_page ? "gap-0 p-0" : "max-w-6xl gap-6 px-5 py-8" %>">
      <div id="flash-messages">
        <%= render "shared/flash" %>
      </div>
      <%= yield %>
    </main>
    <%= render "shared/footer" unless auth_page %>
  </body>
</html>
