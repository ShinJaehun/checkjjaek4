<article class="rounded-2xl border border-stone-200 bg-white p-4" data-cleanup-comment-id="<%= record.id %>">
  <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-stone-500">
    <span><%= t("groups.restricted_content.kinds.comment") %> · <%= t("groups.restricted_content.group", id: @group.id) %></span>
    <time datetime="<%= record.created_at.iso8601 %>"><%= l(record.created_at, format: :short) %></time>
  </div>
  <% if record.hidden? || record[:parent_hidden_at].present? %>
    <p class="mt-3 text-sm text-stone-500"><%= t("groups.restricted_content.hidden") %></p>
  <% else %>
    <p class="mt-3 whitespace-pre-wrap break-words text-sm text-stone-800"><%= record.content %></p>
  <% end %>
  <% if policy(record).destroy? %>
    <%= button_to t("groups.restricted_content.delete"), jjaek_comment_path(record.jjaek_id, record, return_to: "group_restricted_content"), method: :delete,
                  form: { data: { turbo_confirm: t("groups.restricted_content.delete_confirmation") } },
                  class: "mt-3 text-sm font-medium text-red-700 underline" %>
  <% end %>
</article>
