<section class="mx-auto w-full max-w-3xl space-y-6">
  <%= render "shared/back_link", path: groups_path %>
  <header>
    <h1 class="text-2xl font-semibold text-stone-900"><%= t("groups.past_membership.group", id: @group.id) %></h1>
    <p class="mt-2 text-sm text-stone-600"><%= t("groups.restricted_content.description") %></p>
  </header>

  <nav class="flex gap-4 text-sm" aria-label="<%= t("groups.restricted_content.title") %>">
    <% %w[jjaeks comments].each do |section| %>
      <%= link_to t("groups.restricted_content.sections.#{section}"), group_path(@group.id, content: section),
                  class: "font-medium text-stone-700 underline",
                  aria: { current: ("page" if @content_section == section) } %>
    <% end %>
  </nav>

  <div class="space-y-3">
    <% @content_page.records.each do |record| %>
      <%= render "groups/restricted_content/#{@content_section == 'comments' ? 'comment' : 'jjaek'}", record: %>
    <% end %>
    <% if @content_page.total_count.zero? %>
      <p class="rounded-2xl border border-dashed border-stone-300 p-6 text-center text-sm text-stone-500"><%= t("groups.restricted_content.empty") %></p>
    <% end %>
  </div>

  <nav class="flex items-center justify-between text-sm">
    <span><%= t("pagination.range", first: @content_page.first_item, last: @content_page.last_item, total: @content_page.total_count) %></span>
    <div class="flex gap-3">
      <%= link_to t("pagination.previous"),
                  group_path(@group.id, content: @content_section, page: @content_page.previous_page),
                  class: "underline" if @content_page.previous_page %>
      <%= link_to t("pagination.next"),
                  group_path(@group.id, content: @content_section, page: @content_page.next_page),
                  class: "underline" if @content_page.next_page %>
    </div>
  </nav>
</section>
