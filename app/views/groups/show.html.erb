<section class="mx-auto flex w-full max-w-5xl flex-col gap-6">
  <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-amber-700"><%= t("groups.types.#{@group.group_type}") %></p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-stone-900"><%= @group.name %></h1>
        <p class="mt-2 text-sm text-stone-500"><%= t("groups.group_admin", name: @group.group_admin.name) %></p>
        <p class="mt-2 text-sm font-medium text-amber-700"><%= t("groups.lifecycle_statuses.#{@group.lifecycle_status}") %></p>
      </div>

      <div>
        <% if @group.group_admin?(current_user) %>
          <div class="flex items-center gap-2">
            <%= link_to t("groups.members.management_title"), group_members_path(@group), class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
            <%= link_to t("groups.actions.edit"), edit_group_path(@group), class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
            <span class="rounded-full bg-stone-900 px-4 py-2 text-sm font-medium text-white"><%= t("group_memberships.statuses.group_admin") %></span>
          </div>
        <% elsif @membership&.active? %>
          <%= button_to t("group_memberships.actions.leave"),
                        group_group_membership_path(@group, @membership),
                        method: :delete,
                        class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
        <% elsif @membership&.pending? %>
          <div class="flex items-center gap-3">
            <span class="text-sm font-medium text-amber-700"><%= t("group_memberships.statuses.pending") %></span>
            <%= button_to t("group_memberships.actions.cancel"),
                          group_group_membership_path(@group, @membership),
                          method: :delete,
                          class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
          </div>
        <% elsif @membership&.inactive? %>
          <span class="rounded-full bg-stone-100 px-4 py-2 text-sm font-medium text-stone-600"><%= t("group_memberships.statuses.inactive") %></span>
        <% elsif @group.active? && @group.public_group? %>
          <%= button_to t("group_memberships.actions.join"),
                        group_group_memberships_path(@group),
                        class: "rounded-full bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
        <% elsif @group.active? && @group.approval_group? %>
          <%= button_to t("group_memberships.actions.request"),
                        group_group_memberships_path(@group),
                        class: "rounded-full bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
        <% end %>
      </div>
    </div>

    <% if @group.description.present? %>
      <p class="mt-6 whitespace-pre-wrap text-sm leading-7 text-stone-700"><%= @group.description %></p>
    <% end %>
  </section>

  <% unless @group.active? %>
    <section class="rounded-3xl border border-amber-200 bg-amber-50/60 p-5 text-sm text-amber-900">
      <%= t("groups.lifecycle_messages.#{@group.lifecycle_status}") %>
    </section>
  <% end %>

  <% if @jjaek.present? %>
    <section class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
      <div class="flex items-center gap-2">
        <span class="rounded-full bg-stone-900 px-4 py-2 text-sm font-medium text-white"><%= t("groups.jjaeks.tabs.general") %></span>
        <%= link_to t("groups.jjaeks.tabs.book"),
                    book_search_path(group_id: @group.id),
                    class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
      </div>

      <p class="mt-4 text-sm text-stone-500"><%= t("groups.jjaeks.general_description") %></p>
      <%= form_with model: [@group, @jjaek], class: "mt-4 space-y-4" do |form| %>
        <% if @jjaek.errors.any? %>
          <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"><%= @jjaek.errors.full_messages.to_sentence %></div>
        <% end %>
        <%= form.label :content, t("jjaeks.form.jjaek_content"), class: "sr-only" %>
        <%= form.text_area :content, rows: 5, class: "w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm shadow-sm focus:border-stone-500 focus:outline-none" %>
        <%= form.submit t("groups.jjaeks.tabs.general"), class: "rounded-full bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
      <% end %>
    </section>
  <% end %>

  <% if @can_read_group_jjaeks %>
  <section class="space-y-4">
    <h2 class="text-2xl font-semibold tracking-tight text-stone-900"><%= t("groups.jjaeks.title") %></h2>
    <% if @jjaeks.any? %>
      <% @jjaeks.each do |jjaek| %>
        <%= render "jjaeks/jjaek", jjaek: jjaek, inline_comments_context: :group %>
      <% end %>
    <% else %>
      <section class="rounded-3xl border border-dashed border-stone-300 bg-white/70 p-8 text-center text-sm text-stone-500"><%= t("groups.jjaeks.empty") %></section>
    <% end %>
  </section>
  <% end %>

  <%= link_to t("groups.actions.back"), groups_path, class: "text-sm font-medium text-stone-600" %>
</section>
