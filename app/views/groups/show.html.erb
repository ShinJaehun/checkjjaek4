<section class="mx-auto flex w-full max-w-5xl flex-col gap-6">
  <%= render "shared/back_link", path: groups_path %>
  <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <%= render "groups/identity_summary",
                 group: @group,
                 member_preview: @member_preview,
                 active_member_count: @active_member_count %>

      <div>
        <% if policy(@group).view_members? && @group.group_admin?(current_user) %>
          <div class="flex items-center gap-2">
            <%= link_to t("groups.members.management_title"), group_members_path(@group), class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
            <% if policy(@group).view_content_inventory? %>
              <%= link_to t("groups.actions.manage_content"), content_group_path(@group), class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
            <% end %>
            <% if policy(@group).edit? %>
              <%= link_to t("groups.actions.edit"), edit_group_path(@group), class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
            <% end %>
          </div>
        <% elsif @group_member_ban.present? %>
          <span class="rounded-full bg-red-50 px-4 py-2 text-sm font-medium text-red-700"><%= t("group_member_bans.status") %></span>
        <% elsif @membership&.active? %>
          <% if @can_destroy_membership %>
            <%= button_to t("group_memberships.actions.leave"),
                          group_group_membership_path(@group, @membership),
                          method: :delete,
                          class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
          <% end %>
        <% elsif @membership&.pending? %>
          <div class="flex items-center gap-3">
            <span class="text-sm font-medium text-amber-700"><%= t("group_memberships.statuses.pending") %></span>
            <% if @can_destroy_membership %>
              <%= button_to t("group_memberships.actions.cancel"),
                            group_group_membership_path(@group, @membership),
                            method: :delete,
                            class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
            <% end %>
          </div>
        <% elsif @can_create_membership %>
          <%= button_to t(@group.public_group? ? "group_memberships.actions.join" : "group_memberships.actions.request"),
                        group_group_memberships_path(@group),
                        class: "rounded-full bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
        <% end %>
      </div>
    </div>

    <% if @group.description.present? %>
      <p class="mt-4 whitespace-pre-wrap text-sm leading-7 text-stone-700"><%= @group.description %></p>
    <% end %>
  </section>

  <% unless @group.active? %>
    <section class="rounded-3xl border border-amber-200 bg-amber-50/60 p-5 text-sm text-amber-900">
      <%= t("groups.lifecycle_messages.#{@group.lifecycle_status}") %>
      <% if policy(@group).cancel_application? %>
        <%= button_to t("groups.applications.cancel"), group_application_cancellation_path(@group),
                      form: { data: { turbo_confirm: t("groups.applications.cancel_confirmation") } },
                      class: "mt-4 rounded-full border border-amber-400 px-4 py-2 font-medium" %>
      <% end %>
      <% if @group.application_ended? && @group.group_admin?(current_user) %>
        <%= link_to t("groups.actions.new"), new_group_path, class: "mt-4 inline-block font-medium underline" %>
      <% end %>
    </section>
  <% end %>

  <% if @group.application_ended? %>
    <%= render "groups/operation_history", lifecycle_events: @lifecycle_events,
               operation_actions: @operation_moderation_actions, show_internal_notes: false %>
  <% end %>

  <% if @current_operation_suspension.present? %>
    <section class="rounded-3xl border border-red-200 bg-red-50/60 p-5 text-sm text-red-900">
      <p class="font-semibold"><%= t("groups.operation_suspension.status") %></p>
      <p class="mt-2 whitespace-pre-wrap"><%= t("group_memberships.moderation.public_reason") %>: <%= Group.suspension_reason_label(@current_operation_suspension.public_reason) %></p>
    </section>
  <% end %>

  <% if @current_group_ban_action.present? %>
    <section class="rounded-3xl border border-red-200 bg-red-50/60 p-5 text-sm text-red-900">
      <p class="font-semibold"><%= t("group_member_bans.status") %></p>
      <p class="mt-2 whitespace-pre-wrap"><%= t("group_memberships.moderation.public_reason") %>: <%= @current_group_ban_action.public_reason %></p>
    </section>
  <% end %>

  <% if @current_activity_suspension.present? %>
    <section class="rounded-3xl border border-red-200 bg-red-50/60 p-5 text-sm text-red-900">
      <p class="font-semibold"><%= t("group_memberships.moderation.statuses.activity_suspended") %></p>
      <p class="mt-2 whitespace-pre-wrap"><%= t("group_memberships.moderation.public_reason") %>: <%= @current_activity_suspension.public_reason %></p>
    </section>
  <% end %>

  <% if @jjaek.present? %>
    <section class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
      <div class="flex items-center gap-2">
        <span class="rounded-full bg-stone-900 px-4 py-2 text-sm font-medium text-white"><%= t("groups.jjaeks.tabs.general") %></span>
        <%= link_to t("groups.jjaeks.tabs.book"),
                    book_search_entry_path(group_id: @group.id),
                    class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
      </div>

      <p class="mt-4 text-sm text-stone-500"><%= t("groups.jjaeks.general_description") %></p>
      <%= form_with model: [@group, @jjaek], class: "mt-4 space-y-4" do |form| %>
        <%= hidden_field_tag :return_to, jjaek_navigation_params[:return_to] if jjaek_navigation_params[:return_to] %>
        <%= render "shared/content_field", form: form, label_key: "jjaeks.form.jjaek_content", rows: 5 %>
        <%= form.submit t("groups.jjaeks.tabs.general"), class: "rounded-full bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
      <% end %>
    </section>
  <% end %>

  <% if @can_read_group_jjaeks %>
    <section class="mx-auto w-full max-w-3xl space-y-4">
      <h2 class="text-2xl font-semibold tracking-tight text-stone-900"><%= t("groups.jjaeks.title") %></h2>
      <%= render "feeds/list", page: @feed_page, context: :group,
                 next_url: @feed_next_url,
                 empty_text: t("groups.jjaeks.empty") %>
    </section>
  <% end %>

</section>
