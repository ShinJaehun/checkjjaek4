<article class="rounded-xl border border-amber-200 bg-amber-50/70 p-3"
         data-history-kind="platform"
         data-history-entry="<%= record.action_type %>">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h3 class="font-semibold text-stone-900">
      <%= t("groups.lifecycle_history.platform.events.#{record.action_type}") %>
    </h3>
    <span class="shrink-0 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800">
      <%= t("groups.lifecycle_history.platform.badge") %>
    </span>
  </div>

  <p class="text-sm text-stone-600">
    <%= group_history_actor_label(record) %>
    ·
    <%= l(record.created_at, format: :short) %>
  </p>

  <% if record.public_reason.present? || (show_internal_notes && record.internal_note.present?) %>
    <div class="mt-2 space-y-2 rounded-lg border-l-2 border-amber-300 bg-white/70 px-3 py-2">
      <% if record.public_reason.present? %>
        <% reason = record.action_type == "suspend_group_operation" ? Group.suspension_reason_label(record.public_reason) : record.public_reason %>
        <div class="space-y-1" data-history-detail="reason">
          <p class="text-xs font-semibold text-amber-900"><%= t("groups.lifecycle_history.platform.reason") %></p>
          <p class="whitespace-pre-wrap text-sm leading-5 text-stone-800"><%= reason %></p>
        </div>
      <% end %>

      <% if show_internal_notes && record.internal_note.present? %>
        <div class="space-y-1 border-t border-amber-200 pt-2" data-history-detail="memo">
          <p class="text-xs font-semibold text-amber-900"><%= t("groups.lifecycle_history.platform.memo") %></p>
          <p class="whitespace-pre-wrap text-sm leading-5 text-stone-800"><%= record.internal_note %></p>
        </div>
      <% end %>
    </div>
  <% end %>
</article>
