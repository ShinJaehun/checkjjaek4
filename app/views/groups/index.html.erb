<section class="mx-auto flex w-full max-w-5xl flex-col gap-6">
  <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-stone-900"><%= t("groups.index.title") %></h1>
        <p class="mt-3 text-sm text-stone-500"><%= t("groups.index.description") %></p>
      </div>
      <%= link_to t("groups.actions.new"), new_group_path, class: "rounded-full bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
    </div>
  </section>

  <% if @invitations.any? %>
    <section class="rounded-3xl border border-amber-200 bg-amber-50/60 p-6">
      <h2 class="text-xl font-semibold text-stone-900"><%= t("groups.invitations.title") %></h2>
      <div class="mt-4 grid gap-4 md:grid-cols-2">
        <% @invitations.each do |invitation| %>
          <article class="rounded-2xl border border-amber-100 bg-white p-5">
            <h3 class="text-lg font-semibold text-stone-900"><%= invitation.group.name %></h3>
            <p class="mt-1 text-xs text-stone-500"><%= t("groups.group_admin", name: invitation.group.group_admin.name) %></p>
            <span class="mt-2 inline-flex rounded-full px-3 py-1 text-xs font-medium <%= group_status_badge_classes(invitation.group) %>">
              <%= group_current_status_label(invitation.group) %>
            </span>
            <% if invitation.group.active? && invitation.group.operation_suspended? %>
              <p class="mt-2 text-xs text-red-700"><%= t("groups.operation_suspension.invitation_accept_unavailable") %></p>
            <% end %>
            <% if invitation.group.description.present? %>
              <p class="mt-3 text-sm leading-6 text-stone-600"><%= invitation.group.description %></p>
            <% end %>
            <div class="mt-4 flex gap-2">
              <% if policy(invitation).accept? %>
                <%= button_to t("group_memberships.actions.accept"),
                              accept_group_group_membership_path(invitation.group, invitation),
                              method: :patch,
                              class: "rounded-full bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
              <% end %>
              <%= button_to t("group_memberships.actions.decline"),
                            decline_group_group_membership_path(invitation.group, invitation),
                            method: :delete,
                            class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
            </div>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="space-y-4">
    <% groups = @groups.to_a %>
    <div class="flex items-center justify-between gap-3">
      <h2 class="min-w-0 text-2xl font-semibold tracking-tight text-stone-900"><%= t("groups.index.my_groups") %></h2>
      <% if groups.size >= 2 %>
        <%= link_to edit_groups_membership_order_path,
                    class: "inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full border border-stone-300 px-3 py-1.5 text-sm font-medium text-stone-700" do %>
          <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m3 8 4-4 4 4M7 4v16m6-4 4 4 4-4M17 20V4" />
          </svg>
          <span><%= t("groups.membership_order.action") %></span>
        <% end %>
      <% end %>
    </div>
    <% if groups.any? %>
      <% if groups.one? %>
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3" data-group-grid>
          <% groups.each do |group| %>
            <%= render "groups/group_card", group: group,
                       membership: @memberships_by_group_id[group.id],
                       pending_count: @pending_membership_counts.fetch(group.id, 0),
                       member_preview: @member_previews_by_group_id.fetch(group.id, []),
                       active_member_count: @active_member_counts_by_group_id.fetch(group.id, 0) %>
          <% end %>
        </div>
      <% else %>
        <% desktop_page_count = groups.each_slice(3).count %>
        <div class="space-y-3" data-controller="group-carousel">
          <div id="my-groups-carousel"
               class="touch-pan-y focus-visible:outline focus-visible:outline-2 focus-visible:outline-stone-500"
               role="region" aria-label="<%= t("groups.index.carousel.label") %>" tabindex="0"
               data-group-carousel-target="viewport"
               data-action="keydown->group-carousel#navigate touchstart->group-carousel#touchStart touchend->group-carousel#touchEnd touchcancel->group-carousel#touchCancel">
            <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3" data-group-grid>
              <% groups.each_with_index do |group, index| %>
                <div class="min-w-0" data-group-carousel-target="card" <%= "hidden" if index >= 3 %>>
                  <%= render "groups/group_card", group: group,
                             membership: @memberships_by_group_id[group.id],
                             pending_count: @pending_membership_counts.fetch(group.id, 0),
                             member_preview: @member_previews_by_group_id.fetch(group.id, []),
                             active_member_count: @active_member_counts_by_group_id.fetch(group.id, 0) %>
                </div>
              <% end %>
            </div>
          </div>
          <div data-group-carousel-target="controls" <%= "hidden" if desktop_page_count == 1 %>>
            <div class="flex items-center justify-center gap-4">
              <button type="button" disabled aria-controls="my-groups-carousel"
                      class="rounded-full border border-stone-300 px-3 py-1.5 text-sm font-medium text-stone-700 disabled:opacity-40 focus-visible:outline focus-visible:outline-2 focus-visible:outline-stone-500"
                      data-group-carousel-target="previous" data-action="group-carousel#previous">
                <%= t("groups.index.carousel.previous") %>
              </button>
              <span class="min-w-20 text-center text-sm text-stone-600" aria-live="polite" aria-atomic="true" data-group-carousel-target="position">
                <%= t("groups.index.carousel.position", current: 1, total: desktop_page_count) %>
              </span>
              <button type="button" aria-controls="my-groups-carousel" <%= "disabled" if desktop_page_count == 1 %>
                      class="rounded-full border border-stone-300 px-3 py-1.5 text-sm font-medium text-stone-700 disabled:opacity-40 focus-visible:outline focus-visible:outline-2 focus-visible:outline-stone-500"
                      data-group-carousel-target="next" data-action="group-carousel#next">
                <%= t("groups.index.carousel.next") %>
              </button>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <section class="rounded-3xl border border-dashed border-stone-300 bg-white/70 p-8 text-center text-sm text-stone-500">
        <%= t("groups.index.empty_my_groups") %>
      </section>
    <% end %>
  </section>

  <section class="mx-auto w-full max-w-3xl space-y-4">
    <h2 class="text-2xl font-semibold tracking-tight text-stone-900"><%= t("groups.index.recent_activity") %></h2>
    <%= render "feeds/list", page: @feed_page, context: :group,
               next_url: @feed_next_url,
               empty_text: t("groups.index.empty_activity") %>
  </section>
</section>
