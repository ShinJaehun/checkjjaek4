<section class="mx-auto flex w-full max-w-5xl flex-col gap-6">
  <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-stone-900"><%= t("groups.index.title") %></h1>
        <p class="mt-3 text-sm text-stone-500"><%= t("groups.index.description") %></p>
      </div>
      <%= link_to t("groups.actions.new"), new_group_path, class: "rounded-full bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
    </div>
  </section>

  <% if @invitations.any? %>
    <section class="rounded-3xl border border-amber-200 bg-amber-50/60 p-6">
      <h2 class="text-xl font-semibold text-stone-900"><%= t("groups.invitations.title") %></h2>
      <div class="mt-4 grid gap-4 md:grid-cols-2">
        <% @invitations.each do |invitation| %>
          <article class="rounded-2xl border border-amber-100 bg-white p-5">
            <h3 class="text-lg font-semibold text-stone-900"><%= invitation.group.name %></h3>
            <p class="mt-1 text-xs text-stone-500"><%= t("groups.owner", name: invitation.group.owner.name) %></p>
            <% if invitation.group.description.present? %>
              <p class="mt-3 text-sm leading-6 text-stone-600"><%= invitation.group.description %></p>
            <% end %>
            <div class="mt-4 flex gap-2">
              <%= button_to t("group_memberships.actions.accept"),
                            accept_group_group_membership_path(invitation.group, invitation),
                            method: :patch,
                            class: "rounded-full bg-stone-900 px-4 py-2 text-sm font-medium text-white" %>
              <%= button_to t("group_memberships.actions.decline"),
                            decline_group_group_membership_path(invitation.group, invitation),
                            method: :delete,
                            class: "rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700" %>
            </div>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @groups.any? %>
    <div class="grid gap-4 md:grid-cols-2">
      <% @groups.each do |group| %>
        <% membership = group.group_memberships.find { |item| item.user_id == current_user.id } %>
        <article class="rounded-3xl border border-stone-200 bg-white p-5 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h2 class="text-xl font-semibold text-stone-900"><%= link_to group.name, group_path(group) %></h2>
              <p class="mt-1 text-xs font-medium text-stone-500"><%= t("groups.types.#{group.group_type}") %></p>
            </div>
            <% if membership %>
              <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-medium text-amber-800"><%= t("group_memberships.statuses.#{membership.status}") %></span>
            <% end %>
          </div>
          <% if group.description.present? %>
            <p class="mt-4 line-clamp-3 text-sm leading-6 text-stone-600"><%= group.description %></p>
          <% end %>
          <p class="mt-4 text-xs text-stone-500"><%= t("groups.owner", name: group.owner.name) %></p>
        </article>
      <% end %>
    </div>
  <% else %>
    <section class="rounded-3xl border border-dashed border-stone-300 bg-white/70 p-8 text-center text-sm text-stone-500">
      <%= t("groups.index.empty") %>
    </section>
  <% end %>
</section>
