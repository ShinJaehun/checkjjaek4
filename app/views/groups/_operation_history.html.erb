<% history_entries = group_history_entries(
     lifecycle_events: lifecycle_events,
     moderation_actions: operation_actions
   ) %>

<section id="group_operation_history" class="rounded-3xl border border-stone-200 bg-stone-50/70 p-5">
  <h2 class="text-lg font-semibold text-stone-900"><%= t("groups.lifecycle_history.title") %></h2>

  <% if history_entries.empty? %>
    <p class="mt-3 text-sm text-stone-500"><%= t("groups.lifecycle_history.empty") %></p>
  <% else %>
    <div class="mt-4 space-y-2">
      <% history_entries.each do |entry| %>
        <% record = entry[:record] %>

        <% if entry[:kind] == :lifecycle %>
          <% detail_label_key = {
               "opening_requested" => "application_purpose",
               "operations_closed" => "closure_reason",
               "reactivation_requested" => "reactivation_reason"
             }[record.event_type] %>

          <article class="rounded-xl border border-stone-200 bg-white p-3"
                   data-history-kind="lifecycle"
                   data-history-entry="<%= record.event_type %>">
            <div class="space-y-1">
              <h3 class="font-semibold text-stone-900">
                <%= t("groups.lifecycle_history.events.#{record.event_type}") %>
              </h3>

              <p class="text-sm text-stone-600">
                <%= group_history_actor_label(record) %>
                ·
                <%= l(record.created_at, format: :short) %>
              </p>
            </div>

            <% if detail_label_key && record.detail.present? %>
              <div class="mt-2 rounded-lg border-l-2 border-stone-300 bg-stone-50 px-3 py-2"
                   data-history-detail="<%= detail_label_key %>">
                <p class="text-xs font-semibold text-stone-600">
                  <%= t("groups.lifecycle_history.details.#{detail_label_key}") %>
                </p>
                <p class="mt-1 whitespace-pre-wrap text-sm leading-5 text-stone-800"><%= record.detail %></p>
              </div>
            <% end %>
          </article>
        <% else %>
          <article class="rounded-xl border border-amber-200 bg-amber-50/70 p-3"
                   data-history-kind="platform"
                   data-history-entry="<%= record.action_type %>">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="font-semibold text-stone-900">
                <%= t("groups.lifecycle_history.platform.events.#{record.action_type}") %>
              </h3>
              <span class="shrink-0 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800">
                <%= t("groups.lifecycle_history.platform.badge") %>
              </span>
            </div>

            <p class="text-sm text-stone-600">
              <%= group_history_actor_label(record) %>
              ·
              <%= l(record.created_at, format: :short) %>
            </p>

            <% if record.public_reason.present? || (show_internal_notes && record.internal_note.present?) %>
              <div class="mt-2 space-y-2 rounded-lg border-l-2 border-amber-300 bg-white/70 px-3 py-2">
                <% if record.public_reason.present? %>
                  <% reason = record.action_type == "suspend_group_operation" ? Group.suspension_reason_label(record.public_reason) : record.public_reason %>
                  <div class="space-y-1" data-history-detail="reason">
                    <p class="text-xs font-semibold text-amber-900"><%= t("groups.lifecycle_history.platform.reason") %></p>
                    <p class="whitespace-pre-wrap text-sm leading-5 text-stone-800"><%= reason %></p>
                  </div>
                <% end %>

                <% if show_internal_notes && record.internal_note.present? %>
                  <div class="space-y-1 border-t border-amber-200 pt-2" data-history-detail="memo">
                    <p class="text-xs font-semibold text-amber-900"><%= t("groups.lifecycle_history.platform.memo") %></p>
                    <p class="whitespace-pre-wrap text-sm leading-5 text-stone-800"><%= record.internal_note %></p>
                  </div>
                <% end %>
              </div>
            <% end %>
          </article>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>
