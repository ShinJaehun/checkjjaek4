<section class="mx-auto w-full max-w-3xl space-y-6">
  <%= render "shared/back_link", path: groups_path %>
  <section class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
    <h1 class="text-2xl font-semibold text-stone-900"><%= t("groups.membership_order.title") %></h1>

    <div data-controller="group-membership-sort" class="mt-6 space-y-6">
      <% if @memberships.empty? %>
        <p class="text-sm text-stone-500"><%= t("groups.index.empty_my_groups") %></p>
      <% end %>
      <ul class="list-none space-y-3" data-group-membership-sort-target="list">
        <% @memberships.each do |membership| %>
          <li class="rounded-2xl border border-stone-200 p-4 md:cursor-grab md:active:cursor-grabbing"
              data-group-membership-sort-target="item">
            <%# Keep the save form separate from each removal form while preserving DOM sort order. %>
            <%= hidden_field_tag "membership_ids[]", membership.id, form: "group-membership-order" %>
            <div class="flex items-center gap-3">
              <div class="min-w-0 flex-1">
                <p class="truncate font-semibold text-stone-900"><%= membership.group.name %></p>
                <div class="mt-3 flex flex-wrap items-center gap-2">
                  <span class="rounded-full px-3 py-1 text-xs font-medium <%= group_type_badge_classes(membership.group) %>" data-group-type="<%= membership.group.group_type %>"><%= group_type_label(membership.group) %></span>
                  <span class="rounded-full px-3 py-1 text-xs font-medium <%= group_status_badge_classes(membership.group) %>" data-field="current-status"><%= group_current_status_label(membership.group) %></span>
                </div>
              </div>
              <div class="flex shrink-0 gap-1 md:hidden">
                <button type="button" data-action="group-membership-sort#moveUp" data-group-membership-sort-direction="up"
                        aria-label="<%= t("groups.membership_order.move_up", name: membership.group.name) %>"
                        class="rounded-lg border border-stone-300 px-3 py-2 text-sm disabled:opacity-30">
                  ↑
                </button>
                <button type="button" data-action="group-membership-sort#moveDown" data-group-membership-sort-direction="down"
                        aria-label="<%= t("groups.membership_order.move_down", name: membership.group.name) %>"
                        class="rounded-lg border border-stone-300 px-3 py-2 text-sm disabled:opacity-30">
                  ↓
                </button>
              </div>
            </div>
            <% if @removable_group_ids.include?(membership.group_id) %>
              <%= button_to t("groups.membership_order.hide"), hide_groups_membership_order_path(group_id: membership.group_id), method: :patch,
                            form: { data: { turbo_confirm: t("groups.membership_order.hide_confirmation") } },
                            class: "mt-3 text-sm text-red-700 underline" %>
            <% end %>
          </li>
        <% end %>
      </ul>
      <%= form_with url: groups_membership_order_path, method: :patch, id: "group-membership-order", class: "flex items-center gap-4" do |form| %>
        <%= form.submit t("groups.membership_order.save"), disabled: @memberships.empty?,
                        class: "rounded-full bg-stone-900 px-5 py-2.5 text-sm font-medium text-white disabled:opacity-40" %>
        <%= link_to t("groups.actions.cancel"), groups_path, class: "text-sm font-medium text-stone-600 underline" %>
      <% end %>
    </div>

    <% if @past_groups.any? %>
      <section class="mt-6 space-y-3" data-past-groups>
        <h2 class="font-semibold text-stone-900"><%= t("groups.past_membership.title") %></h2>
        <p class="text-sm text-stone-500"><%= t("groups.past_membership.description") %></p>
        <% @past_groups.each do |group| %>
          <%= render "groups/past_group_card", group: group, past_state: @past_group_states.fetch(group.id),
                     link_name: false, list_action: :hide %>
        <% end %>
      </section>
    <% end %>

    <section class="mt-6 space-y-3" data-hidden-groups>
      <h2 class="font-semibold text-stone-900"><%= t("groups.membership_order.excluded") %></h2>
      <% if @hidden_groups.empty? %>
        <p class="text-sm text-stone-500"><%= t("groups.membership_order.empty_excluded") %></p>
      <% end %>
      <% @hidden_groups.each do |group| %>
        <% if @past_group_states.key?(group.id) %>
          <%= render "groups/past_group_card", group: group, past_state: @past_group_states.fetch(group.id),
                     link_name: false, list_action: :restore %>
        <% else %>
          <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-stone-200 p-4">
            <p class="font-medium"><%= group.name %></p>
            <%= button_to t("groups.membership_order.restore"), restore_groups_membership_order_path(group_id: group.id), method: :patch,
                          class: "text-sm text-stone-700 underline" %>
          </div>
        <% end %>
      <% end %>
    </section>
  </section>
</section>
