<section class="mx-auto w-full max-w-2xl rounded-3xl border border-amber-200 bg-white p-6 shadow-sm">
  <h1 class="text-2xl font-semibold text-stone-900"><%= t("groups.reactivation_request.title") %></h1>
  <p class="mt-2 text-sm text-stone-600"><%= t("groups.reactivation_request.description") %></p>

  <%= render "groups/group_action_context", group: @group %>

  <% if @group.closed_at.present? %>
    <p class="mt-4 text-sm text-stone-600"><%= t("groups.management.closed_at", time: l(@group.closed_at, format: :short)) %></p>
  <% end %>
  <% if @group.closure_reason.present? %>
    <div class="mt-4 rounded-2xl border border-stone-200 p-4 text-sm text-stone-700">
      <p class="font-medium text-stone-900"><%= t("groups.form.closure_reason") %></p>
      <p class="mt-2 whitespace-pre-wrap"><%= @group.closure_reason %></p>
    </div>
  <% end %>

  <% if @error_message.present? %>
    <p class="mt-5 rounded-2xl bg-red-50 p-4 text-sm text-red-700"><%= @error_message %></p>
  <% end %>

  <%= button_to t("groups.actions.request_reactivation"),
                group_reactivation_requests_path(@group),
                method: :post,
                class: "mt-6 rounded-full bg-stone-900 px-5 py-2.5 text-sm font-medium text-white" %>
  <%= link_to t("groups.actions.cancel"), edit_group_path(@group), class: "mt-5 inline-block text-sm font-medium text-stone-600 underline" %>
</section>
