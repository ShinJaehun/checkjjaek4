<section class="mx-auto flex w-full max-w-3xl flex-col gap-6">
  <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm">
    <h1 class="text-3xl font-semibold tracking-tight text-stone-900"><%= t("groups.edit.title") %></h1>
    <p class="mt-3 text-sm font-medium text-amber-700"><%= t("groups.lifecycle_statuses.#{@group.lifecycle_status}") %></p>

    <div class="mt-6">
      <%= render "form", group: @group %>
    </div>
  </section>

  <% if policy(@group).transfer_admin? %>
    <section class="rounded-3xl border border-stone-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold text-stone-900"><%= t("groups.admin_transfer.title") %></h2>
      <p class="mt-2 text-sm text-stone-600"><%= t("groups.admin_transfer.current", name: @group.owner.name) %></p>

      <% if @admin_transfer_candidates.any? %>
        <%= form_with url: transfer_admin_group_path(@group), method: :patch, class: "mt-5 space-y-4", data: { turbo_confirm: t("groups.admin_transfer.confirmation") } do %>
          <div>
            <%= label_tag :new_admin_id, t("groups.admin_transfer.target"), class: "mb-2 block text-sm font-medium text-stone-700" %>
            <%= select_tag :new_admin_id, options_from_collection_for_select(@admin_transfer_candidates, :id, :name), class: "w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm" %>
          </div>
          <%= submit_tag t("groups.admin_transfer.submit"), class: "rounded-full bg-stone-900 px-5 py-2.5 text-sm font-medium text-white" %>
        <% end %>
      <% else %>
        <p class="mt-4 text-sm text-stone-500"><%= t("groups.admin_transfer.no_candidates") %></p>
      <% end %>
    </section>
  <% end %>

  <% if @group.active? %>
    <section class="rounded-3xl border border-red-200 bg-red-50/60 p-6">
      <h2 class="text-xl font-semibold text-red-900"><%= t("groups.management.close_title") %></h2>
      <p class="mt-2 text-sm text-red-700"><%= t("groups.management.close_description") %></p>
      <%= form_with url: close_group_path(@group), method: :patch, scope: :group, class: "mt-5 space-y-4", data: { turbo_confirm: t("groups.management.close_confirmation") } do |form| %>
        <div>
          <%= form.label :closure_reason, t("groups.form.closure_reason"), class: "mb-2 block text-sm font-medium text-red-900" %>
          <%= form.text_area :closure_reason, value: @closure_reason_input, rows: 4, maxlength: 500, required: true, class: "w-full rounded-2xl border border-red-200 bg-white px-4 py-3 text-sm" %>
        </div>
        <%= form.submit t("groups.actions.close"), class: "rounded-full bg-red-700 px-5 py-2.5 text-sm font-medium text-white" %>
      <% end %>
    </section>
  <% elsif @group.inactive? %>
    <section class="rounded-3xl border border-amber-200 bg-amber-50/60 p-6">
      <h2 class="text-xl font-semibold text-stone-900"><%= t("groups.management.inactive_title") %></h2>
      <% if @group.closed_at.present? %>
        <p class="mt-3 text-sm text-stone-600"><%= t("groups.management.closed_at", time: l(@group.closed_at, format: :short)) %></p>
      <% end %>
      <p class="mt-4 text-sm text-stone-700"><%= t("groups.management.reactivation_description") %></p>
      <%= button_to t("groups.actions.request_reactivation"), request_reactivation_group_path(@group), method: :patch, class: "mt-4 rounded-full bg-stone-900 px-5 py-2.5 text-sm font-medium text-white" %>
    </section>
  <% end %>

  <%= render "groups/lifecycle_history", lifecycle_events: @lifecycle_events, show_details: false %>
</section>
