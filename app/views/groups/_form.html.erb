<%= form_with model: group, class: "space-y-5" do |form| %>
  <% if group.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
      <%= group.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= form.label :name, t("groups.form.name"), class: "mb-2 block text-sm font-medium text-stone-700" %>
    <%= form.text_field :name, required: true, class: "w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm" %>
  </div>

  <div>
    <%= form.label :description, t("groups.form.description"), class: "mb-2 block text-sm font-medium text-stone-700" %>
    <%= form.text_area :description, rows: 5, class: "w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm" %>
  </div>

  <div>
    <%= form.label :group_type, t("groups.form.group_type"), class: "mb-2 block text-sm font-medium text-stone-700" %>
    <%= form.select :group_type,
                    Group::USER_CREATABLE_TYPES.map { |type| [t("groups.types.#{type}"), type] },
                    {},
                    class: "w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm" %>
    <p class="mt-2 text-xs leading-5 text-stone-500"><%= t("groups.form.private_group_later") %></p>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit t("groups.actions.create"), class: "rounded-full bg-stone-900 px-5 py-2.5 text-sm font-medium text-white" %>
    <%= link_to t("groups.actions.cancel"), groups_path, class: "text-sm font-medium text-stone-600" %>
  </div>
<% end %>
