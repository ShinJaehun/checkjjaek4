<% settings_section = local_assigns[:settings_section] %>
<%= form_with model: group, id: ("group-#{settings_section}-form" if settings_section),
              class: settings_section ? "mt-5 space-y-5" : "space-y-5" do |form| %>
  <% if group.errors.any? && (settings_section.nil? || @failed_group_form == settings_section) %>
    <div role="alert" class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
      <%= group.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <% if settings_section == :branding %>
    <%= render "groups/branding_fields", form:, group: %>
  <% elsif settings_section == :application %>
    <%= form.label :application_purpose, t("groups.form.application_purpose"), class: "mb-2 block text-sm font-medium text-stone-800" %>
    <%= form.text_area :application_purpose, rows: 5, maxlength: 500, required: group.application_purpose.present?,
                       class: "w-full rounded-2xl border border-stone-300 bg-white px-4 py-3 text-sm" %>
    <p class="text-xs text-stone-500"><%= t("groups.form.application_purpose_hint") %></p>
  <% else %>
    <%= render "groups/information_fields", form:, group: %>
  <% end %>

  <div class="flex flex-wrap items-center gap-3">
    <%= form.submit t(group.new_record? ? "groups.actions.create" : "groups.actions.update"), class: "ui-button ui-button-primary" %>
    <%= link_to t("groups.actions.cancel"),
                group.persisted? ? group_path(group) : groups_path,
                class: group.persisted? ? "ui-button ui-button-secondary" : "text-sm font-medium text-stone-600" %>
  </div>
<% end %>
