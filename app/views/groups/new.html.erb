<section class="mx-auto flex w-full max-w-3xl flex-col gap-6">
  <%= render "shared/back_link", path: groups_path %>
  <section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm">
    <h1 class="text-3xl font-semibold tracking-tight text-stone-900"><%= t("groups.new.title") %></h1>
    <p class="mt-3 text-sm text-stone-500"><%= t("groups.new.description") %></p>

    <div class="mt-6">
      <% if @pending_opening_application.present? %>
        <div class="rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
          <p><%= t("groups.applications.limit_reached") %></p>
          <%= link_to @pending_opening_application.name, group_path(@pending_opening_application), class: "mt-2 inline-block font-medium underline" %>
        </div>
      <% else %>
        <%= render "form", group: @group %>
      <% end %>
    </div>
  </section>

  <% if @past_applications.present? %>
    <section class="rounded-3xl border border-stone-200 bg-white p-6">
      <h2 class="text-lg font-semibold text-stone-900"><%= t("groups.applications.recent_results") %></h2>
      <ul class="mt-4 space-y-3">
        <% @past_applications.each do |application| %>
          <li class="flex min-w-0 flex-wrap items-center gap-2">
            <%= link_to application.name, group_path(application), class: "min-w-0 break-words text-sm font-medium text-stone-800 underline" %>
            <span class="rounded-full px-3 py-1 text-xs font-medium <%= group_status_badge_classes(application) %>"><%= group_current_status_label(application) %></span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</section>
