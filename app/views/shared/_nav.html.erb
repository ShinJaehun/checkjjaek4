<header class="border-b border-stone-200 bg-white/80 backdrop-blur" data-controller="mobile-navigation">
  <% if user_signed_in? %>
    <%= turbo_stream_from current_user, :notifications %>
  <% end %>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-y-3 px-5 py-4 lg:flex-nowrap">
    <%= link_to root_path, class: "mr-auto shrink-0" do %>
      <%= image_tag "logo/logo_black_mini.png", alt: "책짹4", width: 75, height: 50, class: "block h-auto w-[75px]" %>
    <% end %>
    <nav class="contents text-sm text-stone-700 lg:flex lg:items-center lg:gap-3">
      <div id="mobile-navigation-links" class="order-3 hidden w-full flex-col gap-3 border-t border-stone-200 pt-3 lg:order-none lg:flex lg:w-auto lg:flex-row lg:items-center lg:border-0 lg:pt-0" data-mobile-navigation-target="links">
        <% if user_signed_in? %>
          <%= link_to t("home.nav"), root_path, class: "font-medium" %>
          <%= link_to t("discovery.nav"), discovery_path, class: "font-medium" %>
          <%= link_to t("book_search.nav"), book_search_entry_path(group_id: (@group.id if @group && policy(@group).create_jjaek?)), class: "font-medium" %>
          <%= link_to t("bookshelf_entries.nav"), user_library_path(current_user), class: "font-medium" %>
          <%= link_to t("groups.nav"), groups_path, class: "font-medium" %>
          <% if current_user.global_admin? %>
            <%= link_to t("admin.users.nav"), admin_users_path, class: "font-medium" %>
            <%= link_to t("admin.groups.nav"), admin_groups_path, class: "font-medium" %>
            <%= link_to t("registration_invitations.nav"), admin_registration_invitations_path, class: "font-medium" %>
          <% end %>
        <% else %>
          <%= link_to t("auth.actions.sign_in"), new_user_session_path, class: "font-medium lg:rounded-full lg:border lg:border-stone-300 lg:px-3 lg:py-1.5" %>
        <% end %>
      </div>
      <% if user_signed_in? %>
        <%= link_to notifications_path, class: "order-1 flex shrink-0 items-center whitespace-nowrap font-medium lg:order-none", data: { turbo_prefetch: false } do %>
          <span><%= t("notifications.nav") %></span>
          <span id="notification-badge-container">
            <%= render "shared/notification_badge", unread_count: unread_notifications_count %>
          </span>
        <% end %>
      <% end %>
      <button type="button" class="order-2 rounded-full border border-stone-300 px-3 py-1.5 font-medium lg:hidden" aria-controls="mobile-navigation-links<%= ' mobile-navigation-account' if user_signed_in? %>" aria-expanded="false" data-mobile-navigation-target="button" data-action="mobile-navigation#toggle"><%= t("navigation.menu") %></button>
      <% if user_signed_in? %>
        <div id="mobile-navigation-account" class="order-4 hidden w-full flex-col gap-3 pb-1 lg:order-none lg:flex lg:w-auto lg:flex-row lg:items-center lg:pb-0" data-mobile-navigation-target="links">
          <%= link_to user_path(current_user), class: "flex items-center gap-2 font-medium" do %>
            <%= user_avatar_image(current_user, size: 128, alt: current_user.name, class: "h-8 w-8 rounded-full object-cover") %>
            <span><%= current_user.name %></span>
          <% end %>
          <%= button_to t("auth.actions.sign_out"), destroy_user_session_path, method: :delete, class: "rounded-full border border-stone-300 px-3 py-1.5" %>
        </div>
      <% end %>
    </nav>
  </div>
</header>
