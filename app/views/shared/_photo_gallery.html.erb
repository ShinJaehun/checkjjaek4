<dialog class="photo-gallery" data-photo-gallery-target="dialog" aria-label="<%= t("jjaek_photos.gallery") %>"
        data-action="cancel->photo-gallery#close click->photo-gallery#backdrop contextmenu->photo-gallery#prevent dragstart->photo-gallery#prevent">
  <div class="photo-gallery-content">
    <div class="photo-gallery-toolbar">
      <span data-photo-gallery-target="counter" aria-live="polite"></span>
      <button type="button" data-action="photo-gallery#close" aria-label="<%= t("jjaek_photos.close") %>">✕</button>
    </div>
    <div class="photo-gallery-stage" data-action="pointerdown->photo-gallery#touchStart pointerup->photo-gallery#touchEnd">
      <img data-photo-gallery-target="image" alt="<%= image_alt %>" draggable="false"
           data-action="error->photo-gallery#imageError load->photo-gallery#imageLoaded">
      <p hidden data-photo-gallery-target="error" role="status"><%= t("jjaek_photos.unavailable") %></p>
    </div>
    <div class="photo-gallery-navigation">
      <button type="button" data-photo-gallery-target="previous" data-action="photo-gallery#previous" aria-label="<%= t("jjaek_photos.previous") %>">←</button>
      <button type="button" data-photo-gallery-target="next" data-action="photo-gallery#next" aria-label="<%= t("jjaek_photos.next") %>">→</button>
    </div>
  </div>
</dialog>
