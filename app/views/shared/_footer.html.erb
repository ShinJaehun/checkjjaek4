<% auth = local_assigns[:auth] %>
<% nav_style = auth ? "w-fit max-w-full rounded-xl bg-black/40 px-4 py-3 text-white backdrop-blur-sm" : "max-w-6xl sm:justify-start" %>
<% link_style = auth ? "hover:text-white hover:underline" : "hover:text-stone-900 hover:underline" %>
<footer class="px-5 py-5 text-sm text-stone-600">
  <nav aria-label="<%= t('legal.footer.navigation') %>" class="mx-auto flex flex-wrap items-center justify-center gap-x-6 gap-y-2 <%= nav_style %>">
    <%= link_to t("legal.privacy.title"), privacy_policy_path, class: link_style %>
    <%= link_to t("legal.terms.title"), terms_of_service_path, class: link_style %>
    <%= mail_to "support@jjaek.kr", "support@jjaek.kr", class: link_style %>
  </nav>
</footer>
